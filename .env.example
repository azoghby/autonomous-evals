# Neon (app database). Pooled for runtime, unpooled for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Neon API (Track B: per-job simulator branches)
NEON_API_KEY=
NEON_PROJECT_ID=icy-star-64097833
NEON_SIM_SEED_BRANCH_ID=br-dry-wave-bdhrghkh
# Vercel Blob (private store autonomous-evals-artifacts)
BLOB_READ_WRITE_TOKEN=
# Auth / security
SESSION_SECRET=            # 32+ random bytes, base64
CREDENTIALS_ENCRYPTION_KEY= # 32 random bytes, base64 (AES-256-GCM)
OPERATOR_EMAILS=           # comma-separated allowlist
CRON_SECRET=
APP_URL=http://localhost:3000
# Email transport is AgentMail (see AGENTMAIL_* below). Resend is a fallback only when AGENTMAIL_API_KEY is absent.
RESEND_API_KEY=
EMAIL_FROM=
# Stripe. STRIPE_MODE=test|live; live keys only after must-pass gates.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Track B
NAIVE_API_KEY=
AI_GATEWAY_API_KEY=        # Vercel AI Gateway (primary). Not needed on Vercel (OIDC); locally use this or VERCEL_OIDC_TOKEN (vercel env pull apps/web/.env.vercel.local)
VERCEL_OIDC_TOKEN=         # local-only alternative to AI_GATEWAY_API_KEY; expires ~12h
NEON_AI_GATEWAY_URL=       # Neon AI Gateway (fallback) branch host, e.g. https://br-...-api.ai.c-8.us-east-2.aws.neon.tech
NEON_AI_GATEWAY_KEY=       # credential "autonomous-evals-ai", scope ai_gateway:invoke
# Artifacts on Neon branchable object storage (private bucket). ARTIFACT_STORE=neon|blob (default: neon if NEON_STORAGE_* set, else blob)
ARTIFACT_STORE=
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_BUCKET=artifacts
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
MONID_API_KEY=            # expert sourcing / enrichment (spends Monid balance)
AGENTMAIL_API_KEY=         # AgentMail: agent inboxes for auth links, notifications, outreach
AGENTMAIL_COMMERCIAL_INBOX_ID=  # customer-facing inbox (quotes, delivery, expert outreach); replies land here
AGENTMAIL_AUTH_INBOX_ID=        # magic-link sender (may equal the commercial inbox on the free plan)
AGENTMAIL_WEBHOOK_SECRET=       # Svix signing secret for POST /api/webhooks/agentmail (from setup-inboxes.ts)
