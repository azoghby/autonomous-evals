# Neon (app database). Pooled for runtime, unpooled for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Neon API (Track B: per-job simulator branches)
NEON_API_KEY=
NEON_PROJECT_ID=icy-star-64097833
NEON_SIM_SEED_BRANCH_ID=br-dry-wave-bdhrghkh
# Vercel Blob (private store autonomous-evals-artifacts)
BLOB_READ_WRITE_TOKEN=
# Auth / security
SESSION_SECRET=            # 32+ random bytes, base64
CREDENTIALS_ENCRYPTION_KEY= # 32 random bytes, base64 (AES-256-GCM)
OPERATOR_EMAILS=           # comma-separated allowlist
CRON_SECRET=
APP_URL=http://localhost:3000
# Email (magic links + notifications). Without it, links are logged in dev only.
RESEND_API_KEY=
EMAIL_FROM=
# Stripe. STRIPE_MODE=test|live; live keys only after must-pass gates.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Track B
NAIVE_API_KEY=
AI_GATEWAY_API_KEY=        # not needed on Vercel (OIDC); needed locally
# Artifacts on Neon branchable object storage (private bucket). ARTIFACT_STORE=neon|blob (default: neon if NEON_STORAGE_* set, else blob)
ARTIFACT_STORE=
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_BUCKET=artifacts
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
MONID_API_KEY=            # expert sourcing / enrichment (spends Monid balance)
