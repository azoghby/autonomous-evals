+++ b/scripts/naive-conformance-gate.ts
@@ -0,0 +1,129 @@
+/** Strict execution coverage for the existing conformance harness; not provider or Phase 0 attestation. */
+import type { ConformanceCheck } from '../packages/core/src/contracts/conformance';
+import type { EvalServices, RunResult } from '../packages/core/src/contracts/services';
+import type { Finding, Suite } from '../packages/core/src/contracts';
+import { BLOCKED_TARGET_URLS } from '../packages/core/src/contracts/fixtures';
+
+export interface StrictConformanceEvidence {
+  calls: Partial<Record<keyof EvalServices, number>>;
+  succeeded: Partial<Record<keyof EvalServices, number>>;
+  suitePipeline: { designed: number; run: number; investigated: number; rerun: number };
+}
+const identity = (group: string, name: string) => `${group}: ${name}`;
+const expectedChecks = [
+  ['qualify', 'output parses (trace_audit)'], ['qualify', 'output parses (text_eval)'],
+  ['qualify', 'never returns a price'],
+  ['auditTrace', 'unsupported-claim trace yields >=1 confirmed/rubric finding with evidence'],
+  ['auditTrace', 'clean trace yields zero confirmed findings'],
+  ...BLOCKED_TARGET_URLS.map(url => ['checkTarget', `rejects ${url} without network`]),
+  ['renderReport', 'non-empty markdown + html, no <script>, schema-valid'],
+  ['proposeAndVerifyFix', 'returns schema-valid Remediation for the finding'],
+  ['designSuite', 'returns schema-valid Suite for ctx.jobId'],
+  ['runSuite', 'results reference suite scenarios'], ['investigate', 'findings valid with evidence'],
+  ['rerunFinding', 'returns schema-valid Finding with same id'],
+  ['budget', 'ctx with budgetMicroUsd=0 throws a typed budget error or makes no paid calls'],
+  ['branching', 'create -> connection -> delete'],
+].map(([group, name]) => identity(group, name));
+const same = (a: unknown, b: unknown) => JSON.stringify(a) === JSON.stringify(b);
+function requireEvidence(ok: unknown, message: string): asserts ok {
+  if (!ok) throw new Error(`Strict conformance: ${message}`);
+}
+
+export function createStrictConformanceServices(underlying: EvalServices): {
+  services: EvalServices;
+  evidence: () => StrictConformanceEvidence;
+  validate: (checks: ConformanceCheck[]) => ConformanceCheck[];
+} {
+  const observed: StrictConformanceEvidence = {
+    calls: {}, succeeded: {}, suitePipeline: { designed: 0, run: 0, investigated: 0, rerun: 0 },
+  };
+  let retained: { jobId: string; suite: Suite; run?: RunResult; findings?: Finding[] } | undefined;
+  // Explicit forwarding also supports implementations whose methods live on the prototype.
+  const services: EvalServices = {
+    qualify: (...args) => underlying.qualify(...args),
+    auditTrace: (...args) => underlying.auditTrace(...args),
+    checkTarget: (...args) => underlying.checkTarget(...args),
+    renderReport: (...args) => underlying.renderReport(...args),
+    proposeAndVerifyFix: (...args) => underlying.proposeAndVerifyFix(...args),
+    createJobBranch: (...args) => underlying.createJobBranch(...args),
+    deleteJobBranch: (...args) => underlying.deleteJobBranch(...args),
+    ...(underlying.getJobBranchConnection ? { getJobBranchConnection: (id: string) => underlying.getJobBranchConnection!(id) } : {}),
+    async designSuite(ctx, intake) {
+      retained = undefined;
+      const suite = await underlying.designSuite(ctx, intake);
+      requireEvidence(suite.jobId === ctx.jobId, 'designed suite job differs from context');
+      requireEvidence(suite.scenarios.length > 0 && new Set(suite.scenarios.map(s => s.id)).size === suite.scenarios.length, 'suite scenarios must be nonempty and unique');
+      retained = { jobId: ctx.jobId, suite: structuredClone(suite) };
+      observed.suitePipeline.designed++;
+      return suite;
+    },
+    async runSuite(ctx, suite, target, branch) {
+      requireEvidence(retained && retained.jobId === ctx.jobId && suite.jobId === ctx.jobId && same(suite, retained.suite), 'run must use the retained suite and shared suite job');
+      const run = await underlying.runSuite(ctx, suite, target, branch);
+      requireEvidence(run.versionLabel === retained.suite.versionLabel, 'run version differs from suite');
+      const expected = new Set(retained.suite.scenarios.map(s => s.id));
+      const ids = run.results.map(r => r.scenarioId);
+      requireEvidence(ids.length > 0 && ids.length === expected.size && new Set(ids).size === ids.length && ids.every(id => expected.has(id)), 'run must cover every scenario exactly once');
+      requireEvidence(typeof run.runId === 'string' && run.runId.trim().length > 0, 'run identity missing');
+      retained.run = structuredClone(run);
+      retained.findings = undefined;
+      observed.suitePipeline.run++;
+      return run;
+    },
+    async investigate(ctx, suite, runs) {
+      requireEvidence(retained?.run && retained.jobId === ctx.jobId && same(suite, retained.suite) && same(runs, [retained.run]), 'investigation requires the actual retained run and shared suite job');
+      const findings = await underlying.investigate(ctx, suite, runs);
+      const ids = new Set(retained.suite.scenarios.map(s => s.id));
+      requireEvidence(findings.every(f => typeof f.scenarioId === 'string' && ids.has(f.scenarioId)), 'investigation finding scenario binding invalid');
+      retained.findings = structuredClone(findings);
+      observed.suitePipeline.investigated++;
+      return findings;
+    },
+    async rerunFinding(ctx, finding, scenario) {
+      requireEvidence(retained?.findings && retained.jobId === ctx.jobId && retained.findings.some(f => same(f, finding)), 'rerun requires an actual retained investigation finding');
+      const expected = retained.suite.scenarios.find(s => s.id === finding.scenarioId);
+      requireEvidence(expected && same(expected, scenario), 'rerun scenario differs from retained finding scenario');
+      const binding = { id: finding.id, scenarioId: finding.scenarioId };
+      const result = await underlying.rerunFinding(ctx, finding, scenario);
+      requireEvidence(result.id === binding.id && result.scenarioId === binding.scenarioId, 'rerun changed finding identity or scenario binding');
+      observed.suitePipeline.rerun++;
+      return result;
+    },
+  };
+  for (const key of Object.keys(services) as Array<keyof EvalServices>) {
+    const fn = services[key] as (...args: unknown[]) => Promise<unknown>;
+    Object.assign(services, { [key]: async (...args: unknown[]) => {
+      observed.calls[key] = (observed.calls[key] ?? 0) + 1;
+      const result = await fn(...args);
+      observed.succeeded[key] = (observed.succeeded[key] ?? 0) + 1;
+      return result;
+    } });
+  }
+  return {
+    services,
+    evidence: () => structuredClone(observed),
+    validate(checks) {
+      const out = checks.map(check => ({ ...check }));
+      const fail = (name: string, message: string) => out.push({ group: 'strict coverage', name, status: 'fail', message });
+      const identities = checks.map(check => identity(check.group, check.name));
+      if (identities.some(id => !expectedChecks.includes(id))) fail('unexpected checks', 'Unknown check identities cannot establish coverage');
+      if (checks.some(check => !['pass', 'fail', 'skip'].includes(check.status))) fail('unknown status', 'Unknown check status');
+      for (const expected of expectedChecks) {
+        const matches = checks.filter(check => identity(check.group, check.name) === expected);
+        if (matches.length !== 1 || matches[0].status !== 'pass') fail(expected, 'Exactly one passing required check is required');
+      }
+      if (new Set(identities).size !== identities.length) fail('duplicate checks', 'Repeated check identities cannot establish coverage');
+      if (checks.some(check => check.status === 'skip')) fail('skipped checks', 'Strict conformance requires full execution');
+      for (const key of Object.keys(services) as Array<keyof EvalServices>) {
+        // Safe-target rejection may legitimately throw; the harness checks no network escaped.
+        const count = key === 'checkTarget' ? observed.calls[key] : observed.succeeded[key];
+        if (!count) fail(`method ${key}`, 'Required method was not exercised as required');
+      }
+      if (!underlying.getJobBranchConnection) fail('method getJobBranchConnection', 'Branch connection method missing');
+      for (const [stage, count] of Object.entries(observed.suitePipeline)) {
+        if (!count) fail(`suite ${stage}`, 'Required retained suite pipeline stage was not exercised');
+      }
+      return out;
+    },
+  };
+}
diff --git a/docs/naive-run-recovery-integration/sql/001-run-recovery.sql b/docs/naive-run-recovery-integration/sql/001-run-recovery.sql
new file mode 100644
--- /dev/null
+++ b/docs/naive-run-recovery-integration/sql/001-run-recovery.sql
@@ -0,0 +1,40 @@
+-- Additive profile, after 001-design-stage-recovery.sql. Existing profile constraints retained.
+ALTER TABLE workflow_stage.stages DROP CONSTRAINT stages_recovery_profile_check;
+ALTER TABLE workflow_stage.stages ADD CONSTRAINT stages_recovery_profile_check CHECK(recovery_profile IN ('none','retained-children','naive-single-child-v1','naive-design-v1','naive-text-run-v1'));
+ALTER TABLE workflow_stage.stages DROP CONSTRAINT design_plan_shape;
+CREATE FUNCTION workflow_stage.valid_text_run_plan(p jsonb) RETURNS boolean LANGUAGE plpgsql IMMUTABLE AS $$
+DECLARE c jsonb; seen text[]='{}'; ident text; targets integer=0;
+BEGIN
+ IF p IS NULL OR jsonb_typeof(p)<>'object' OR NOT p ?& ARRAY['profile','runId','suiteDigest','targetVersion','environment','children'] OR p-ARRAY['profile','runId','suiteDigest','targetVersion','environment','children']<>'{}'::jsonb THEN RETURN false; END IF;
+ IF p->>'profile'<>'naive-text-run-v1' OR jsonb_typeof(p->'children')<>'array' THEN RETURN false; END IF;
+ FOREACH ident IN ARRAY ARRAY['profile','runId','suiteDigest','targetVersion','environment'] LOOP
+ IF jsonb_typeof(p->ident)<>'string' OR length(p->>ident) NOT BETWEEN 1 AND 4096 THEN RETURN false; END IF; END LOOP;
+ IF p->>'suiteDigest' !~ '^[a-f0-9]{64}$' OR jsonb_array_length(p->'children') NOT BETWEEN 1 AND 256 THEN RETURN false; END IF;
+ FOR c IN SELECT value FROM jsonb_array_elements(p->'children') LOOP
+ IF jsonb_typeof(c)<>'object' OR NOT c ?& ARRAY['kind','operationKey'] OR c-ARRAY['kind','operationKey']<>'{}'::jsonb OR jsonb_typeof(c->'kind')<>'string' OR jsonb_typeof(c->'operationKey')<>'string' OR c->>'kind' NOT IN ('text_run_target','text_run_judge') OR length(c->>'operationKey') NOT BETWEEN 1 AND 4096 THEN RETURN false; END IF;
+ ident=c::text; IF ident=ANY(seen) THEN RETURN false; END IF; seen=array_append(seen,ident); IF c->>'kind'='text_run_target' THEN targets=targets+1; END IF;
+ END LOOP; RETURN targets>0;
+END $$;
+ALTER TABLE workflow_stage.stages ADD CONSTRAINT design_plan_shape CHECK(
+ (recovery_profile='naive-design-v1' AND expected_child_plan IS NOT NULL AND jsonb_typeof(expected_child_plan)='object'
+ AND expected_child_plan ?& ARRAY['profile','scope','outerDesignId','inputDigest']
+ AND expected_child_plan - ARRAY['profile','scope','outerDesignId','inputDigest'] = '{}'::jsonb
+ AND jsonb_typeof(expected_child_plan->'profile')='string' AND jsonb_typeof(expected_child_plan->'scope')='string' AND jsonb_typeof(expected_child_plan->'outerDesignId')='string' AND jsonb_typeof(expected_child_plan->'inputDigest')='string'
+ AND expected_child_plan->>'profile'='naive-design-v1'
+ AND expected_child_plan->>'scope' ~ '^[a-f0-9]{24}$'
+ AND expected_child_plan->>'inputDigest' ~ '^[a-f0-9]{64}$'
+ AND length(expected_child_plan->>'outerDesignId') BETWEEN 1 AND 4096)
+ OR (recovery_profile='naive-text-run-v1' AND workflow_stage.valid_text_run_plan(expected_child_plan)) OR (recovery_profile NOT IN ('naive-design-v1','naive-text-run-v1') AND expected_child_plan IS NULL));
+CREATE FUNCTION workflow_stage.bound_text_run_child() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE s workflow_stage.stages;
+BEGIN
+ SELECT * INTO s FROM workflow_stage.stages WHERE job_id=NEW.job_id AND stage_key=NEW.stage_key FOR UPDATE;
+ IF s.recovery_profile<>'naive-text-run-v1' THEN RETURN NEW; END IF;
+ IF s.state<>'running' OR s.lease_until<=clock_timestamp() OR NEW.registered_generation<>s.generation
+ OR EXISTS(SELECT 1 FROM workflow_stage.cancellations WHERE job_id=NEW.job_id)
+ OR NOT EXISTS(SELECT 1 FROM jobs WHERE id=NEW.job_id AND state::text IN ('draft','needs_clarification','quoted','awaiting_payment','planning','running','investigating'))
+ OR NOT EXISTS(SELECT 1 FROM jsonb_array_elements(s.expected_child_plan->'children') c WHERE c->>'kind'=NEW.kind AND c->>'operationKey'=NEW.operation_key)
+ THEN RAISE EXCEPTION 'workflow_stage_conflict'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER bounded_text_run_child BEFORE INSERT ON workflow_stage.children FOR EACH ROW EXECUTE FUNCTION workflow_stage.bound_text_run_child();
diff --git a/docs/naive-run-recovery-integration/sql/002-run-checkpoint-ownership.sql b/docs/naive-run-recovery-integration/sql/002-run-checkpoint-ownership.sql
new file mode 100644
--- /dev/null
+++ b/docs/naive-run-recovery-integration/sql/002-run-checkpoint-ownership.sql
@@ -0,0 +1,46 @@
+-- Apply after 001-run-recovery.sql and text integration checkpoint migration.
+CREATE TABLE workflow_stage.run_checkpoints (
+ job_id text NOT NULL,
+ stage_job_id uuid GENERATED ALWAYS AS (job_id::uuid) STORED,
+ kind text NOT NULL CHECK(kind IN ('run_identity','run_result','scenario','target','judge')),
+ id text NOT NULL CHECK(length(id) BETWEEN 1 AND 4096),
+ input_digest text NOT NULL CHECK(length(input_digest) BETWEEN 1 AND 4096),
+ stage_key text NOT NULL,
+ generation bigint NOT NULL CHECK(generation>0),token text NOT NULL CHECK(length(token) BETWEEN 1 AND 4096),
+ outer_id text NOT NULL,outer_digest text NOT NULL,
+ PRIMARY KEY(job_id,kind,id),
+ FOREIGN KEY(job_id,kind,id) REFERENCES text_integration.checkpoints(job_id,kind,id),
+ FOREIGN KEY(stage_job_id,stage_key) REFERENCES workflow_stage.stages(job_id,stage_key)
+);
+CREATE INDEX run_checkpoints_stage ON workflow_stage.run_checkpoints(stage_job_id,stage_key);
+CREATE FUNCTION workflow_stage.bound_run_checkpoint() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE s workflow_stage.stages; checkpoint_token text; checkpoint_digest text; checkpoint_state text;
+BEGIN
+ IF TG_OP='DELETE' THEN RAISE EXCEPTION 'workflow_run_checkpoint_immutable'; END IF;
+ IF TG_OP='UPDATE' THEN
+ IF ROW(NEW.job_id,NEW.kind,NEW.id,NEW.input_digest,NEW.stage_key,NEW.outer_id,NEW.outer_digest)
+ IS DISTINCT FROM ROW(OLD.job_id,OLD.kind,OLD.id,OLD.input_digest,OLD.stage_key,OLD.outer_id,OLD.outer_digest)
+ OR NEW.generation<OLD.generation
+ OR (NEW.generation=OLD.generation AND NEW.token<>OLD.token)
+ OR (NEW.generation>OLD.generation AND (NEW.token=OLD.token OR NEW.kind='target'))
+ THEN RAISE EXCEPTION 'workflow_run_checkpoint_immutable'; END IF;
+ END IF;
+ SELECT * INTO s FROM workflow_stage.stages WHERE job_id=NEW.job_id::uuid AND stage_key=NEW.stage_key FOR UPDATE;
+ IF NOT FOUND OR s.recovery_profile<>'naive-text-run-v1' OR s.state<>'running' OR s.lease_until<=clock_timestamp()
+ OR NEW.generation<>s.generation OR NEW.outer_id<>s.expected_child_plan->>'runId' OR NEW.outer_digest<>s.expected_child_plan->>'suiteDigest'
+ OR EXISTS(SELECT 1 FROM workflow_stage.cancellations WHERE job_id=s.job_id)
+ OR NOT EXISTS(SELECT 1 FROM jobs WHERE id=s.job_id AND state::text IN ('draft','needs_clarification','quoted','awaiting_payment','planning','running','investigating'))
+ THEN RAISE EXCEPTION 'workflow_run_checkpoint_conflict'; END IF;
+ IF NEW.kind IN ('run_identity','run_result') THEN
+ IF NEW.id<>NEW.outer_id THEN RAISE EXCEPTION 'workflow_run_checkpoint_conflict'; END IF;
+ ELSE
+ IF NOT EXISTS(SELECT 1 FROM jsonb_array_elements(s.expected_child_plan->'children') c
+ WHERE c->>'operationKey'=NEW.id AND c->>'kind'=CASE WHEN NEW.kind='judge' THEN 'text_run_judge' ELSE 'text_run_target' END)
+ THEN RAISE EXCEPTION 'workflow_run_checkpoint_conflict'; END IF;
+ END IF;
+ SELECT token,input_digest,state INTO checkpoint_token,checkpoint_digest,checkpoint_state FROM text_integration.checkpoints WHERE job_id=NEW.job_id AND kind=NEW.kind AND id=NEW.id FOR UPDATE;
+ IF NOT FOUND OR checkpoint_token<>NEW.token OR checkpoint_digest<>NEW.input_digest OR checkpoint_state<>'pending'
+ THEN RAISE EXCEPTION 'workflow_run_checkpoint_conflict'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER bounded_run_checkpoint BEFORE INSERT OR UPDATE OR DELETE ON workflow_stage.run_checkpoints FOR EACH ROW EXECUTE FUNCTION workflow_stage.bound_run_checkpoint();
