+import { jobBudgetExposure,type JobBudgetTx } from './job-budget-authority';
+let pg:PGlite;
+const job='11111111-1111-4111-8111-111111111111',customer='22222222-2222-4222-8222-222222222222';
+const input:WorkflowStageClaim={jobId:job,ownerId:customer,environment:'test',stageKey:'qualification:revision:1',inputDigest:'digest',role:'commercial',amountMicroUsd:100,invocation:{workflowRunId:'run',stepId:'step',attempt:0},leaseMs:300000};
