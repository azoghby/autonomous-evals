+const run=<T>(fn:(tx:JobBudgetTx)=>Promise<T>)=>pg.transaction(t=>fn({query:(s,p)=>t.query(s,p)}));
+async function claim(i=input){const r=await run(tx=>claimWorkflowStage(tx,i));if(r.kind!=='owned')throw Error('expected_owner');return r.owner;}
