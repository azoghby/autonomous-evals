+  const ledger=new PostgresBudgetLedger(adapter(tx));const reserved=await ledger.reserve({reservationId:identity.reservationId,jobId:input.task.jobId,amountMicroUsd:b.amountMicroUsd,scopes:[{key:`job:${input.task.jobId}`,capMicroUsd:b.jobCapMicroUsd},{key:`agent:copilot:${b.agentMonth}`,capMicroUsd:b.agentMonthCapMicroUsd},{key:`copilot-customer-day:${input.task.customerId}:${input.task.environment}:${b.customerDay}`,capMicroUsd:b.customerDayCapMicroUsd}]});if(!reserved.ok)fail();
+  await tx.query("INSERT INTO naive_copilot.dispatches(id,identity,body_ciphertext,state) VALUES($1,$2::jsonb,$3,'reserved')",[input.id,JSON.stringify(identity),encryptJson({identityDigest:digest(identity),body},this.key)]);
