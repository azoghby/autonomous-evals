+import { afterEach, describe, expect, it } from 'vitest';
+import { PGlite } from '@electric-sql/pglite';
+import { upsertWorkflowCost } from './workflow-costs';
+import type { AgentTransactionalSql, AgentSqlExecutor } from '@ae/core/agents/postgres-ports';
+
+const stores: PGlite[] = [];
+afterEach(async () => { await Promise.all(stores.splice(0).map(db => db.close())); });
+async function fixture() {
+  const db = new PGlite(); stores.push(db);
+  await db.exec(`CREATE SCHEMA workflow_integration;
+    CREATE TABLE workflow_integration.cost_keys(job_id uuid,key text,payload jsonb,PRIMARY KEY(key));
+    CREATE TABLE costs(job_id uuid,source text,agent text,session_id text,micro_usd bigint,meta jsonb);`);
+  const query: AgentSqlExecutor['query'] = async (text, values) => ({ rows: (await db.query(text, values)).rows as never[] });
+  const sql: AgentTransactionalSql = { query, transaction: fn => db.transaction(async tx => fn({ query: async (text, values) => ({ rows: (await tx.query(text,values)).rows as never[] }) })) };
+  return { db, sql };
+}
+const entry = { jobId: '11111111-1111-4111-8111-111111111111', source: 'naive', agent: 'engineer', sessionId: 'session1', microUsd: 123,
+  meta: { idempotencyKey: 'naive:session1' } };
+describe('Workflow measured cost sink', () => {
+  it('replays lost acknowledgements after fresh sink construction without duplicate costs', async () => {
+    const { db, sql } = await fixture();
+    await upsertWorkflowCost(sql,entry);
+    const fresh = { ...sql };
+    await upsertWorkflowCost(fresh,entry);
+    expect((await db.query('SELECT sum(micro_usd)::int AS total,count(*)::int AS count FROM costs')).rows).toEqual([{ total:123,count:1 }]);
+  });
+  it('refuses changed costs under existing identity and preserves the original', async () => {
+    const { db, sql } = await fixture();
+    await upsertWorkflowCost(sql,entry);
+    await expect(upsertWorkflowCost(sql,{...entry,microUsd:999})).rejects.toThrow('measured_cost_identity_conflict');
+    expect((await db.query('SELECT micro_usd::int AS amount FROM costs')).rows).toEqual([{amount:123}]);
+  });
+  it('refuses session reuse across different jobs', async () => {
+    const { sql } = await fixture();
+    await upsertWorkflowCost(sql,entry);
+    await expect(upsertWorkflowCost(sql,{...entry,jobId:'22222222-2222-4222-8222-222222222222'})).rejects.toThrow('measured_cost_identity_conflict');
+  });
+  it('rolls back the dedup key when recording the canonical cost fails', async () => {
+    const { db, sql } = await fixture();
+    await db.exec('ALTER TABLE costs ADD CONSTRAINT fixture_reject CHECK(micro_usd=0)');
+    await expect(upsertWorkflowCost(sql,entry)).rejects.toThrow();
+    expect((await db.query('SELECT count(*)::int AS count FROM workflow_integration.cost_keys')).rows).toEqual([{count:0}]);
+  });
+  it('rejects unkeyed measured session costs and records measured zero honestly', async () => {
+    const { db, sql } = await fixture();
+    await expect(upsertWorkflowCost(sql,{...entry,meta:{}})).rejects.toThrow('measured_cost_identity_required');
+    await upsertWorkflowCost(sql,{...entry,microUsd:0});
+    expect((await db.query('SELECT micro_usd::int AS amount FROM costs')).rows).toEqual([{amount:0}]);
+  });
+});
