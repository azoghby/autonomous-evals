+    await expect(createPostgresDataOperationLedger(failure, scope).get('key')).rejects.toThrow(/^data_operation_failed$/);
+  });
+});
diff --git a/packages/core/src/evals/data/postgres-operations.ts b/packages/core/src/evals/data/postgres-operations.ts
