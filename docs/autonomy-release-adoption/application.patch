+        const matches = env.policies.flatMap(doc => doc.clauses.filter(clause => ref === `${doc.id}:${clause.id}` || ref === clause.id).map(clause => `${doc.id}:${clause.id}`));
+        return matches.length === 1 ? matches[0] : null;
