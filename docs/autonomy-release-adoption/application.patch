--- /dev/null
+++ b/packages/core/src/agents/autonomy/company.ts
@@ -0,0 +1,116 @@
+import { qualifyRequest, buildQuote, type IntakeSummary, type FixedQuote } from '../commercial';
+import { writeReportSummary } from '../operator';
+import type { AgentTaskRunner } from '../session-service';
+import type { Finding, JobRef } from '../../evals/types';
+import type { DataOperationLedger } from '../../evals/data/operation-ledger';
+import { reviewDigest } from '../../evals/data/binding';
+import { renderReport } from '../../reporting/render';
+
+export class CompanyEvaluationPendingError extends Error {}
+
+export interface CompanyAuthority {
+  schema: 'autonomous-company-v1'; version: string; enabled: boolean;
+  maxClarificationRounds: number;
+}
+export interface CompanyRequest { tenantId: string; job: JobRef; intake: IntakeSummary; round: number }
+export interface CompanyEvaluation {
+  findings: Finding[]; limitations: string[]; reportArtifactId: string;
+  /** Persisted evidence, independently reviewed suite and measured/unknown cost references. */
+  evidenceDigest: string; suiteDigest: string; knownCostMicroUsd: number; unknownCosts: string[];
+}
+export interface CompanyPorts {
+  now(): Date; policy: Readonly<CompanyAuthority>; operations: DataOperationLedger; runner: AgentTaskRunner;
+  /** Current authenticated scope and configuration; rechecked before every effect, including replay. */
+  authorize(request: CompanyRequest): Promise<boolean>;
+  /** Authoritative payment store only. A customer/model assertion is never a receipt. */
+  payment(quote: FixedQuote): Promise<'paid' | 'waiting' | 'invalid'>;
+  data(key: string): Promise<{ status: 'ready' | 'wait_external' | 'not_assessed'; digest: string; reasons: string[] }>;
+  /** Existing owned evaluation pipeline: design, independent review, freeze, execute, investigate.
+   * Must retain target authorization, SQL reservations and provider receipt recovery. */
+  evaluate(key: string, dataDigest: string): Promise<CompanyEvaluation>;
+  /** Query retained evaluator result after a lost acknowledgement; NEVER redispatch. */
+  recoverEvaluation(key: string): Promise<CompanyEvaluation | null>;
+  /** Bounded code-rendered communication outbox, not a network send. */
+  enqueue(key: string, message: { kind: 'clarification'; questions: string[] } | {kind: 'quote'; quote: FixedQuote}
+    | { kind: 'report_ready'; artifactId: string } | {kind: 'monitoring_offer'}): Promise<void>;
+}
+export type CompanyProgress = { state: 'manual' | 'clarification' | 'payment_wait' | 'external_data_wait' | 'not_assessed' | 'declined' | 'pending' | 'paused_budget' | 'exception' | 'delivered'; reason: string; policyVersion: string; founderInterventions: 0; costStatus: 'known' | 'unknown'; report?: CompanyEvaluation };
+
+/** One bounded tick. Host scheduler re-enters the same immutable request; no routine founder gate.
+ * Pure decisions replay freely; paid ambiguous effects recover by receipt only. Legacy mode is untouched. */
+export async function advanceAutonomousCompany(input: CompanyRequest, ports: CompanyPorts): Promise<CompanyProgress> {
+  const request = structuredClone(input), policy = structuredClone(ports.policy);
+  const progress = (state: CompanyProgress['state'], reason: string, costStatus: 'known'|'unknown' = 'known', report?: CompanyEvaluation): CompanyProgress =>
+    ({state, reason, policyVersion: policy.version, founderInterventions: 0, costStatus, ...(report ? {report} : {})});
+  if (!policy.enabled) return progress('manual', 'legacy_manual_mode');
+  if (policy.schema !== 'autonomous-company-v1' || !policy.version || !Number.isSafeInteger(policy.maxClarificationRounds)
+    || policy.maxClarificationRounds < 0 || policy.maxClarificationRounds > 5 || !Number.isSafeInteger(request.round) || request.round < 0
+    || request.tenantId !== request.job.customerId || request.intake.requestedPackage !== request.job.package) throw new Error('company_authority_refused');
+  const authorized = async () => { if (!await ports.authorize(structuredClone(request))) throw new Error('company_scope_refused'); };
+  await authorized();
+  const identity = reviewDigest({request, policy});
+  const prefix = `autonomous-company:${request.tenantId}:${request.job.jobId}:${request.round}`;
+  // Immutable identity prevents an injected new policy/customer body from reusing prior authority.
+  await ports.operations.claim(`${prefix}:identity`, identity);
+  await ports.operations.complete(`${prefix}:identity`, identity, {policyVersion: policy.version});
+  const audit = async (result: CompanyProgress) => {
+    const key = `${prefix}:decision:${reviewDigest(result)}`;
+    const receipt = {authority:'automated_company_policy_v1', requestDigest:identity, ...result};
+    const digest = reviewDigest(receipt);
+    await ports.operations.claim(key, digest); await ports.operations.complete(key, digest, receipt);
+    return result;
+  };
+  const qualification = await qualifyRequest({job:request.job, intake:request.intake, round:request.round}, ports.runner);
+  if (qualification.status !== 'completed') return audit(progress(qualification.status === 'pending' ? 'pending' : ['budget_paused','budget_exhausted'].includes(qualification.status) ? 'paused_budget' : 'exception', `qualification_${qualification.status}`, qualification.status === 'pending' || qualification.status === 'needs_operator' && !qualification.cost ? 'unknown' : 'known'));
+  const q = qualification.value;
+  if (q.decision === 'decline') return audit(progress('declined','out_of_scope'));
+  await authorized();
+  if (q.decision === 'clarify') {
+    if (request.round >= policy.maxClarificationRounds || !q.questions.length) return audit(progress('declined', 'clarification_limit_or_invalid_question'));
+    await ports.enqueue(`${prefix}:clarification`, {kind:'clarification', questions:q.questions});
+    return audit(progress('clarification','waiting_for_customer_answer'));
+  }
+  const quote = buildQuote(request.job, q.package, request.job.quoteVersion ?? 1, q.scopeSummary);
+  await ports.enqueue(`${prefix}:quote`, {kind:'quote',quote});
+  const payment = await ports.payment(quote);
+  if (payment !== 'paid') return audit(progress(payment === 'waiting' ? 'payment_wait' : 'exception',payment === 'waiting' ? 'waiting_for_authoritative_payment' : 'invalid_payment_receipt'));
+  await authorized();
+  const data = await ports.data(`${prefix}:data`);
+  if (data.status !== 'ready') return audit(progress(data.status === 'wait_external' ? 'external_data_wait' : 'not_assessed', 'insufficient_independent_evidence'));
+  if (!/^[a-f0-9]{64}$/.test(data.digest)) throw new Error('company_data_binding_refused');
+  const evalKey = `${prefix}:evaluation`, evalDigest = reviewDigest({identity,dataDigest:data.digest});
+  const claimed = await ports.operations.claim(evalKey, evalDigest);
+  let report: CompanyEvaluation;
+  if (claimed.record.state === 'complete') report = claimed.record.result as CompanyEvaluation;
+  else {
+    await authorized();
+    try {
+      const recovered = claimed.claimed ? await ports.evaluate(evalKey,data.digest) : await ports.recoverEvaluation(evalKey);
+      if (!recovered) return audit(progress('exception','evaluation_receipt_unavailable','unknown'));
+      report = recovered;
+      if (!/^[a-f0-9]{64}$/.test(report.evidenceDigest) || !/^[a-f0-9]{64}$/.test(report.suiteDigest) || !report.reportArtifactId
+        || !Number.isSafeInteger(report.knownCostMicroUsd) || report.knownCostMicroUsd < 0) throw new Error('invalid_evaluation_receipt');
+      await ports.operations.complete(evalKey,evalDigest,report);
+    } catch (error) { return audit(progress(error instanceof CompanyEvaluationPendingError ? 'pending' : 'exception',error instanceof CompanyEvaluationPendingError ? 'evaluation_agent_pending' : 'evaluation_ambiguous_no_redispatch','unknown')); }
+  }
+  await authorized();
+  const summary = await writeReportSummary({job:request.job,findings:report.findings,limitations:report.limitations},ports.runner);
+  if (summary.status !== 'completed') return audit(progress(summary.status === 'pending' ? 'pending' : 'exception',`report_${summary.status}`, summary.status === 'pending' || summary.status === 'needs_operator' && !summary.cost ? 'unknown' : 'known'));
+  const summaryKey = `${prefix}:summary`, digest = reviewDigest(summary.value);
+  await ports.operations.claim(summaryKey,digest); await ports.operations.complete(summaryKey,digest,summary.value);
+  await authorized();
+  const publishedKey = `${prefix}:published-report`;
+  const existingPublication = await ports.operations.get(publishedKey);
+  if (!existingPublication) {
+    const rendered = renderReport({job:request.job,generatedAt:ports.now().toISOString(),findings:report.findings,
+      limitations:report.limitations,operatorSummary:summary.value,costs:null,evaluationStatus:'unresolved',includeHtml:true,
+      details:{evidenceDigest:report.evidenceDigest,suiteDigest:report.suiteDigest,knownEvaluationCostMicroUsd:report.knownCostMicroUsd,unknownCosts:report.unknownCosts}});
+    const publication = {artifactId:report.reportArtifactId,tenantId:request.tenantId,jobId:request.job.jobId,rendered};
+    const publicationDigest = reviewDigest(publication);
+    await ports.operations.claim(publishedKey,publicationDigest); await ports.operations.complete(publishedKey,publicationDigest,publication);
+  } else if(existingPublication.state!=='complete') return audit(progress('exception','publication_receipt_pending','unknown'));
+  await ports.enqueue(`${prefix}:report`, {kind:'report_ready',artifactId:report.reportArtifactId});
+  try { await ports.enqueue(`${prefix}:monitoring-offer`, {kind:'monitoring_offer'}); }
+  catch { await audit(progress('delivered','optional_monitoring_offer_not_queued_by_current_policy','unknown')); }
+  return audit(progress('delivered','report_retained_and_notification_queued',report.unknownCosts.length ? 'unknown' : 'known',report));
+}
diff --git a/packages/core/src/agents/autonomy/operations.sql b/packages/core/src/agents/autonomy/operations.sql
new file mode 100644
index 0000000..11e2178
--- /dev/null
+++ b/packages/core/src/agents/autonomy/operations.sql
@@ -0,0 +1,32 @@
+CREATE SCHEMA IF NOT EXISTS company_autonomy;
+-- One tenant/period lock serializes reservations across policy versions and workers.
+CREATE TABLE IF NOT EXISTS company_autonomy.periods (
+ tenant_id text NOT NULL, period_id text NOT NULL, root_cap bigint NOT NULL CHECK(root_cap > 0),
+ PRIMARY KEY(tenant_id, period_id)
+);
+CREATE TABLE IF NOT EXISTS company_autonomy.policies (
+ tenant_id text NOT NULL, version text NOT NULL, digest text NOT NULL, record jsonb NOT NULL,
+ PRIMARY KEY(tenant_id, version)
+);
+CREATE TABLE IF NOT EXISTS company_autonomy.actions (
+ tenant_id text NOT NULL, action_key text NOT NULL, period_id text NOT NULL,
+ job_id text NOT NULL, role text NOT NULL, held bigint NOT NULL CHECK(held >= 0),
+ record jsonb NOT NULL, PRIMARY KEY(tenant_id, action_key)
+);
+CREATE INDEX IF NOT EXISTS autonomy_actions_period ON company_autonomy.actions(tenant_id, period_id);
+CREATE TABLE IF NOT EXISTS company_autonomy.decisions (
+ tenant_id text NOT NULL, decision_key text NOT NULL, record jsonb NOT NULL,
+ PRIMARY KEY(tenant_id, decision_key)
+);
+
+-- Package classification and cap are frozen at the first admission; a later action cannot
+-- claim comparison pricing or a fresh accounting period to increase one job's authority.
+CREATE TABLE IF NOT EXISTS company_autonomy.jobs (
+ tenant_id text NOT NULL, job_id text NOT NULL, comparison boolean NOT NULL,
+ cap bigint NOT NULL CHECK(cap > 0), PRIMARY KEY(tenant_id,job_id)
+);
+
+CREATE TABLE IF NOT EXISTS company_autonomy.daily_audits (
+ tenant_id text NOT NULL, day text NOT NULL, digest text NOT NULL, record jsonb NOT NULL,
+ PRIMARY KEY(tenant_id,day)
+);
diff --git a/packages/core/src/agents/autonomy/policy.ts b/packages/core/src/agents/autonomy/policy.ts
new file mode 100644
index 0000000..9068ece
--- /dev/null
+++ b/packages/core/src/agents/autonomy/policy.ts
@@ -0,0 +1,53 @@
+import { createHash } from 'node:crypto';
+
+export const AUTONOMY_ROLES = ['commercial', 'evaluation_engineer', 'quality_investigator', 'company_operator'] as const;
+export type AutonomyRole = typeof AUTONOMY_ROLES[number];
+export type AutonomousPolicy = Readonly<{
+  schema: 'autonomous-company-policy/v1'; version: string; tenantId: string; periodId: string;
+  enabled: true; rootBudgetMicroUsd: number;
+  singleJobCapMicroUsd: number; comparisonJobCapMicroUsd: number;
+  roleCapsMicroUsd: Readonly<Record<AutonomyRole, number>>;
+  agents: Readonly<Record<AutonomyRole, Readonly<{ id: string; version: number }>>>;
+  allowedActions: readonly string[]; leaseMs: number; actionDeadlineMs: number; maxRecoveryChecks: number;
+}>;
+export function canonicalAutonomy(value: unknown): string {
+  if (value === null || typeof value !== 'object') {
+    const encoded = JSON.stringify(value);
+    if (encoded === undefined) throw new Error('invalid_autonomy_value');
+    return encoded;
+  }
+  if (Array.isArray(value)) return `[${value.map(canonicalAutonomy).join(',')}]`;
+  return `{${Object.keys(value).sort().map(k => `${JSON.stringify(k)}:${canonicalAutonomy((value as Record<string, unknown>)[k])}`).join(',')}}`;
+}
+export const autonomyDigest = (value: unknown) => createHash('sha256').update(canonicalAutonomy(value)).digest('hex');
+export function assertAutonomyInteger(n: number, minimum = 0): void {
+  if (!Number.isSafeInteger(n) || n < minimum) throw new Error('invalid_autonomy_integer');
+}
+export function assertAutonomyId(s: string): void {
+  if (typeof s !== 'string' || !/^[A-Za-z0-9_.:@/-]{1,200}$/.test(s)) throw new Error('invalid_autonomy_identity');
+}
+/** Called ONLY by the server composition root. Neither agent output nor intake is a policy source.
+ * Omission preserves legacy manual mode: no implicit default enables autonomy. */
+export function createAutonomousPolicy(input: AutonomousPolicy): AutonomousPolicy {
+  const p = structuredClone(input);
+  if (p.schema !== 'autonomous-company-policy/v1' || p.enabled !== true) throw new Error('explicit_autonomous_policy_required');
+  for (const s of [p.version, p.tenantId, p.periodId]) assertAutonomyId(s);
+  assertAutonomyInteger(p.rootBudgetMicroUsd, 1);
+  for (const n of [p.singleJobCapMicroUsd, p.comparisonJobCapMicroUsd, p.leaseMs, p.actionDeadlineMs, p.maxRecoveryChecks]) assertAutonomyInteger(n, 1);
+  if (p.leaseMs > p.actionDeadlineMs || p.maxRecoveryChecks > 100 || p.actionDeadlineMs > 7 * 86400000) throw new Error('unbounded_autonomy_recovery');
+  if (p.singleJobCapMicroUsd > p.rootBudgetMicroUsd || p.comparisonJobCapMicroUsd > p.rootBudgetMicroUsd) throw new Error('autonomy_job_cap_exceeds_root');
+  let total = 0;
+  for (const role of AUTONOMY_ROLES) {
+    assertAutonomyInteger(p.roleCapsMicroUsd[role]); total += p.roleCapsMicroUsd[role];
+    assertAutonomyId(p.agents[role].id); assertAutonomyInteger(p.agents[role].version, 1);
+    Object.freeze(p.agents[role]);
+  }
+  if (!Number.isSafeInteger(total) || total > p.rootBudgetMicroUsd) throw new Error('autonomy_role_caps_exceed_root');
+  if (!p.allowedActions.length || new Set(p.allowedActions).size !== p.allowedActions.length) throw new Error('invalid_autonomy_actions');
+  p.allowedActions.forEach(assertAutonomyId);
+  Object.freeze(p.agents); Object.freeze(p.roleCapsMicroUsd); Object.freeze(p.allowedActions);
+  return Object.freeze(p);
+}
+/** PLAN defaults: overrides must be explicit server configuration within the existing root. */
+export const DEFAULT_AUTONOMY_CAPS = Object.freeze({ singleJobCapMicroUsd: 3_000_000, comparisonJobCapMicroUsd: 5_000_000,
+  roleCapsMicroUsd: Object.freeze({ commercial: 35_000_000, evaluation_engineer: 65_000_000, quality_investigator: 65_000_000, company_operator: 35_000_000 }) });
diff --git a/packages/core/src/agents/autonomy/runner.ts b/packages/core/src/agents/autonomy/runner.ts
new file mode 100644
index 0000000..469f85b
--- /dev/null
+++ b/packages/core/src/agents/autonomy/runner.ts
@@ -0,0 +1,27 @@
+import type { AgentTaskRunner, AgentTaskSpec } from '../session-service';
+import type { PostgresAutonomySupervisor } from './supervisor';
+import { autonomyDigest } from './policy';
+import { containsSecret } from '../redact';
+
+/** Additive policy envelope around the existing SQL-backed session service. The server MUST
+ * construct that service's directory from supervisor.policy.agents (agentId + agentVersion).
+ * Session service remains the sole monetary reservation ledger for these calls. */
+export function createAutonomousRunner(config: {
+ supervisor: PostgresAutonomySupervisor; runner: AgentTaskRunner; now(): number;
+ currentPolicyVersion(): Promise<string>; currentSecrets(): Promise<readonly string[]>;
+}): AgentTaskRunner {
+ return {async run<T>(spec: AgentTaskSpec<T>) {
+  const p=config.supervisor.policy, exact=p.agents[spec.role];
+  const knownSecrets=await config.currentSecrets();
+  if (await config.currentPolicyVersion()!==p.version || containsSecret(spec.message,knownSecrets)) throw new Error('autonomous_runner_current_guard');
+  const decision=await config.supervisor.authorizeDecision({tenantId:p.tenantId,jobId:spec.job.jobId,
+   key:`session:${autonomyDigest({job:spec.job.jobId,role:spec.role,purpose:spec.purpose,attempt:spec.attempt??1})}`,
+   role:spec.role,agentId:exact.id,agentVersion:exact.version,kind:'agent_task',
+   inputDigest:autonomyDigest({job:spec.job,role:spec.role,purpose:spec.purpose,message:spec.message,budget:spec.budgetMicroUsd,outputName:spec.output.name}),
+  },config.now());
+  if(!decision.allowed)throw new Error(`autonomous_runner_${decision.reason}`);
+  const outcome=await config.runner.run({...spec,knownSecrets,jobCapMicroUsd:Math.min(spec.jobCapMicroUsd ?? Number.MAX_SAFE_INTEGER,spec.job.package === 'version_comparison' ? p.comparisonJobCapMicroUsd : p.singleJobCapMicroUsd)});
+  if('session' in outcome && outcome.session && (outcome.session.agentId!==exact.id || outcome.session.agentVersion!==exact.version)) throw new Error('autonomous_runner_agent_identity_mismatch');
+  return outcome;
+ }};
+}
diff --git a/packages/core/src/agents/autonomy/supervisor.ts b/packages/core/src/agents/autonomy/supervisor.ts
new file mode 100644
index 0000000..7b576e9
--- /dev/null
+++ b/packages/core/src/agents/autonomy/supervisor.ts
@@ -0,0 +1,198 @@
+import type { AgentSqlExecutor, AgentTransactionalSql } from '../postgres-ports';
+import { autonomyDigest, assertAutonomyId, assertAutonomyInteger, createAutonomousPolicy, type AutonomousPolicy, type AutonomyRole } from './policy';
+
+export type AutonomyActionInput = {
+  tenantId: string; key: string; jobId: string; comparison: boolean; role: AutonomyRole;
+  agentId: string; agentVersion: number; kind: string; inputDigest: string; reserveMicroUsd: number;
+};
+export type AutonomyAction = AutonomyActionInput & {
+  policyVersion: string; policyDigest: string; periodId: string; identityDigest: string;
+  state: 'reserved' | 'dispatched' | 'completed' | 'inconclusive'; token: string;
+  createdAt: number; deadline: number; leaseUntil: number; recoveryChecks: number;
+  receipt: null | { providerId: string; resultDigest: string; costMicroUsd: number | null };
+  reason: string; costStatus: 'unknown' | 'known';
+};
+export type AutonomyDecision = { key: string; tenantId: string; jobId: string; policyVersion: string;
+  authority: 'configured_automated_policy'; reason: string; allowed: boolean; at: number;
+  costStatus: 'known' | 'unknown'; costMicroUsd: number | null; inputDigest: string };
+export type BeginActionResult = { status: 'acquired' | 'existing'; action: AutonomyAction } | { status: 'denied'; reason: string };
+export type ReceiptLookup = (action: Readonly<AutonomyAction>) => Promise<
+  { status: 'found'; receipt: NonNullable<AutonomyAction['receipt']> } | { status: 'pending' | 'unavailable' | 'absent' }>;
+
+/** Durable policy authority, not an LLM approver. Supply current authorization on EVERY call.
+ * This ledger is an orchestration envelope; do not add its reservation to measured agent costs.
+ * Provider adapters MUST use action.key as durable provider idempotency identity. */
+export class PostgresAutonomySupervisor {
+  readonly policy: AutonomousPolicy;
+  constructor(private readonly db: AgentTransactionalSql, policy: AutonomousPolicy,
+    private readonly authorize: (tenantId: string, jobId: string) => Promise<boolean>) {
+    this.policy = createAutonomousPolicy(policy);
+  }
+  private async check(tenant: string, job: string) {
+    if (tenant !== this.policy.tenantId || !(await this.authorize(tenant, job))) throw new Error('autonomy_unauthorized');
+  }
+  private async lock(tx: AgentSqlExecutor) {
+    const p = this.policy;
+    await tx.query('INSERT INTO company_autonomy.periods(tenant_id,period_id,root_cap) VALUES($1,$2,$3) ON CONFLICT DO NOTHING', [p.tenantId,p.periodId,p.rootBudgetMicroUsd]);
+    const root = (await tx.query<{root_cap: string | number}>('SELECT root_cap FROM company_autonomy.periods WHERE tenant_id=$1 AND period_id=$2 FOR UPDATE', [p.tenantId,p.periodId])).rows[0];
+    if (Number(root?.root_cap) !== p.rootBudgetMicroUsd) throw new Error('autonomy_root_budget_immutable');
+    const digest = autonomyDigest(p);
+    await tx.query('INSERT INTO company_autonomy.policies(tenant_id,version,digest,record) VALUES($1,$2,$3,$4::jsonb) ON CONFLICT DO NOTHING', [p.tenantId,p.version,digest,JSON.stringify(p)]);
+    const saved = (await tx.query<{digest:string}>('SELECT digest FROM company_autonomy.policies WHERE tenant_id=$1 AND version=$2',[p.tenantId,p.version])).rows[0];
+    if (saved?.digest !== digest) throw new Error('autonomy_policy_version_conflict');
+  }
+  private async audit(tx: AgentSqlExecutor, d: AutonomyDecision) {
+    // Decision identity includes outcome: an exhausted decision is immutable evidence even when
+    // the same action is later admitted after a known settlement frees reservations.
+    const { at: _firstWriteTimestamp, ...identity } = d;
+    const key = `${d.key}:${autonomyDigest(identity)}`;
+    await tx.query('INSERT INTO company_autonomy.decisions(tenant_id,decision_key,record) VALUES($1,$2,$3::jsonb) ON CONFLICT DO NOTHING',[d.tenantId,key,JSON.stringify(d)]);
+  }
+  private async save(tx: AgentSqlExecutor, a: AutonomyAction, held: number) {
+    await tx.query('UPDATE company_autonomy.actions SET record=$3::jsonb,held=$4 WHERE tenant_id=$1 AND action_key=$2',[a.tenantId,a.key,JSON.stringify(a),held]);
+  }
+  async begin(input: AutonomyActionInput, workerToken: string, now: number): Promise<BeginActionResult> {
+    input = structuredClone(input); assertAutonomyId(workerToken); assertAutonomyInteger(now);
+    for (const s of [input.tenantId,input.key,input.jobId,input.agentId,input.kind]) assertAutonomyId(s);
+    assertAutonomyInteger(input.reserveMicroUsd); assertAutonomyInteger(input.agentVersion,1);
+    if (!/^[a-f0-9]{64}$/.test(input.inputDigest) || typeof input.comparison !== 'boolean') throw new Error('invalid_autonomy_input');
+    await this.check(input.tenantId,input.jobId);
+    const p = this.policy; const configured = p.agents[input.role];
+    const invalidAuthority = !configured || configured.id !== input.agentId || configured.version !== input.agentVersion || !p.allowedActions.includes(input.kind);
+    return this.db.transaction(async tx => {
+      await this.lock(tx);
+      const identityDigest = autonomyDigest(input);
+      const decision = (reason:string,allowed:boolean): AutonomyDecision => ({key:input.key,tenantId:input.tenantId,jobId:input.jobId,policyVersion:p.version,authority:'configured_automated_policy',reason,allowed,at:now,costStatus:'unknown',costMicroUsd:null,inputDigest:input.inputDigest});
+      if (invalidAuthority) { await this.audit(tx,decision('action_or_exact_agent_not_authorized',false)); return {status:'denied',reason:'action_or_exact_agent_not_authorized'}; }
+      const existing = (await tx.query<{record:AutonomyAction}>('SELECT record FROM company_autonomy.actions WHERE tenant_id=$1 AND action_key=$2',[input.tenantId,input.key])).rows[0]?.record;
+      if (existing) {
+        if (existing.identityDigest !== identityDigest || existing.policyDigest !== autonomyDigest(p)) throw new Error('autonomy_action_identity_conflict');
+        if (existing.state === 'reserved' && existing.leaseUntil <= now && existing.deadline > now) {
+          existing.token = workerToken; existing.leaseUntil = Math.min(now + p.leaseMs,existing.deadline);
+          existing.reason = 'safe_undispatched_reclaim'; await this.save(tx,existing,input.reserveMicroUsd);
+          await this.audit(tx,decision(existing.reason,true)); return {status:'acquired',action:existing};
+        }
+        return {status:'existing',action:existing};
+      }
+      const cap = input.comparison ? p.comparisonJobCapMicroUsd : p.singleJobCapMicroUsd;
+      await tx.query('INSERT INTO company_autonomy.jobs(tenant_id,job_id,comparison,cap) VALUES($1,$2,$3,$4) ON CONFLICT DO NOTHING',[p.tenantId,input.jobId,input.comparison,cap]);
+      const job = (await tx.query<{comparison:boolean;cap:string}>('SELECT comparison,cap FROM company_autonomy.jobs WHERE tenant_id=$1 AND job_id=$2 FOR UPDATE',[p.tenantId,input.jobId])).rows[0];
+      if(job.comparison !== input.comparison || Number(job.cap) !== cap) throw new Error('autonomy_job_budget_immutable');
+      const totals = (await tx.query<{root:string;job:string;role:string}>(`SELECT
+        COALESCE(SUM(CASE WHEN period_id=$2 THEN held ELSE 0 END),0) AS root,
+        COALESCE(SUM(CASE WHEN job_id=$3 THEN held ELSE 0 END),0) AS job,
+        COALESCE(SUM(CASE WHEN role=$4 AND period_id=$2 THEN held ELSE 0 END),0) AS role
+        FROM company_autonomy.actions WHERE tenant_id=$1`,[p.tenantId,p.periodId,input.jobId,input.role])).rows[0];
+      const n = input.reserveMicroUsd;
+      if (Number(totals.root)+n > p.rootBudgetMicroUsd || Number(totals.job)+n > cap || Number(totals.role)+n > p.roleCapsMicroUsd[input.role]) {
+        await this.audit(tx,decision('budget_exhausted',false)); return {status:'denied',reason:'budget_exhausted'};
+      }
+      const action: AutonomyAction = {...input,policyVersion:p.version,policyDigest:autonomyDigest(p),periodId:p.periodId,identityDigest,
+        state:'reserved',token:workerToken,createdAt:now,deadline:now+p.actionDeadlineMs,leaseUntil:now+p.leaseMs,recoveryChecks:0,
+        receipt:null,reason:'bounded_policy_authorized',costStatus:'unknown'};
+      await tx.query('INSERT INTO company_autonomy.actions(tenant_id,action_key,period_id,job_id,role,held,record) VALUES($1,$2,$3,$4,$5,$6,$7::jsonb)',[p.tenantId,input.key,p.periodId,input.jobId,input.role,n,JSON.stringify(action)]);
+      await this.audit(tx,decision(action.reason,true)); return {status:'acquired',action};
+    });
+  }
+  /** Authorize an existing durable AgentTaskRunner without reserving its budget twice.
+   * The runner remains responsible for atomic job/role reservations and exact version checks. */
+  async authorizeDecision(input: Omit<AutonomyActionInput, 'reserveMicroUsd' | 'comparison'>, now:number):Promise<{allowed:boolean;reason:string}> {
+    input=structuredClone(input); assertAutonomyInteger(now);
+    for(const value of [input.key,input.jobId,input.tenantId,input.kind,input.agentId]) assertAutonomyId(value);
+    if(!/^[a-f0-9]{64}$/.test(input.inputDigest)) throw new Error('invalid_autonomy_input');
+    await this.check(input.tenantId,input.jobId);
+    const agent=this.policy.agents[input.role];
+    const allowed=!!agent && agent.id===input.agentId && agent.version===input.agentVersion && this.policy.allowedActions.includes(input.kind);
+    const reason=allowed?'bounded_policy_authorized':'action_or_exact_agent_not_authorized';
+    await this.db.transaction(async tx => { await this.lock(tx); await this.audit(tx,{key:input.key,tenantId:input.tenantId,jobId:input.jobId,
+      policyVersion:this.policy.version,authority:'configured_automated_policy',reason,allowed,at:now,costStatus:'unknown',costMicroUsd:null,inputDigest:input.inputDigest}); });
+    return {allowed,reason};
+  }
+  async get(key:string): Promise<AutonomyAction | null> {
+    assertAutonomyId(key);
+    const a = (await this.db.query<{record:AutonomyAction}>('SELECT record FROM company_autonomy.actions WHERE tenant_id=$1 AND action_key=$2',[this.policy.tenantId,key])).rows[0]?.record ?? null;
+    if (a) await this.check(a.tenantId,a.jobId);
+    return a;
+  }
+  async markDispatched(key:string,token:string,now:number):Promise<AutonomyAction> {
+    return this.mutate(key,async(tx,a) => {
+      if (a.state !== 'reserved' || a.token !== token || a.leaseUntil <= now || a.deadline <= now) throw new Error('autonomy_dispatch_lease_invalid');
+      a.state='dispatched'; a.reason='dispatch_intent_persisted'; await this.save(tx,a,a.reserveMicroUsd); return a;
+    });
+  }
+  private async mutate<T>(key:string,fn:(tx:AgentSqlExecutor,a:AutonomyAction)=>Promise<T>):Promise<T> {
+    const existing = await this.get(key); if (!existing) throw new Error('autonomy_action_missing');
+    return this.db.transaction(async tx => {
+      await this.lock(tx);
+      const a = (await tx.query<{record:AutonomyAction}>('SELECT record FROM company_autonomy.actions WHERE tenant_id=$1 AND action_key=$2 FOR UPDATE',[this.policy.tenantId,key])).rows[0]?.record;
+      if (!a) throw new Error('autonomy_action_missing');
+      return fn(tx,a);
+    });
+  }
+  async complete(key:string,token:string,receipt:NonNullable<AutonomyAction['receipt']>,now:number):Promise<AutonomyAction> {
+    receipt=structuredClone(receipt); assertAutonomyId(receipt.providerId); assertAutonomyInteger(now);
+    if (!/^[a-f0-9]{64}$/.test(receipt.resultDigest)) throw new Error('invalid_autonomy_receipt');
+    if (receipt.costMicroUsd !== null) assertAutonomyInteger(receipt.costMicroUsd);
+    return this.mutate(key,async(tx,a) => {
+      if (a.state === 'completed') { if (autonomyDigest(a.receipt) !== autonomyDigest(receipt)) throw new Error('autonomy_receipt_conflict'); return a; }
+      if (a.token !== token || a.state !== 'dispatched') throw new Error('autonomy_completion_lease_invalid');
+      a.receipt=receipt; a.state='completed'; a.reason=receipt.costMicroUsd === null?'completed_cost_unknown':'completed_authoritative_receipt';
+      a.costStatus=receipt.costMicroUsd === null?'unknown':'known';
+      await this.save(tx,a,receipt.costMicroUsd ?? a.reserveMicroUsd);
+      await this.audit(tx,{key:a.key,tenantId:a.tenantId,jobId:a.jobId,policyVersion:a.policyVersion,authority:'configured_automated_policy',reason:a.reason,allowed:true,at:now,costStatus:a.costStatus,costMicroUsd:receipt.costMicroUsd,inputDigest:a.inputDigest}); return a;
+    });
+  }
+  /** Called periodically by host Cron. Never invokes a paid action. Ambiguous dispatch is
+   * queried by authoritative receipt only; even an absent receipt does not authorize replay. */
+  async recoverDue(now:number,lookup:ReceiptLookup,limit=25):Promise<AutonomyAction[]> {
+    assertAutonomyInteger(now); assertAutonomyInteger(limit,1); if(limit>100) throw new Error('autonomy_recovery_limit');
+    const rows=await this.db.query<{record:AutonomyAction}>(`SELECT record FROM company_autonomy.actions WHERE tenant_id=$1 AND period_id=$2
+      AND record->>'state' IN ('reserved','dispatched') AND (record->>'leaseUntil')::bigint <= $3 ORDER BY action_key LIMIT $4`,[this.policy.tenantId,this.policy.periodId,now,limit]);
+    const results:AutonomyAction[]=[];
+    for(const row of rows.rows) {
+      const a=row.record; await this.check(a.tenantId,a.jobId);
+      // Claim a recovery lease before the provider query, so concurrent Cron invocations cannot
+      // perform unbounded receipt checks. The query itself must use a bounded transport timeout.
+      const claimed=await this.mutate(a.key,async(tx,current) => {
+        if(current.state==='completed'||current.state==='inconclusive'||current.leaseUntil>now) return null;
+        if(current.state==='reserved' && current.deadline>now) return null; // next begin safely reclaims
+        current.recoveryChecks++; current.leaseUntil=now+this.policy.leaseMs;
+        await this.save(tx,current,current.reserveMicroUsd); return current;
+      });
+      if(!claimed) continue;
+      let found:Awaited<ReturnType<ReceiptLookup>>={status:'unavailable'};
+      if(claimed.state==='dispatched') {
+        let timer: ReturnType<typeof setTimeout> | undefined;
+        try {
+          // Lookup is read-only. Its timeout never grants authority to replay the paid action.
+          found=await Promise.race([lookup(structuredClone(claimed)), new Promise<{status:'unavailable'}>(resolve=>{
+            timer=setTimeout(()=>resolve({status:'unavailable'}),Math.min(this.policy.leaseMs,30_000));
+          })]);
+        } catch { /* receipt unavailable */ } finally { if(timer !== undefined) clearTimeout(timer); }
+      }
+      if(found.status==='found') { results.push(await this.complete(claimed.key,claimed.token,found.receipt,now)); continue; }
+      results.push(await this.mutate(claimed.key,async(tx,current) => {
+        if(current.state==='completed'||current.state==='inconclusive') return current;
+        const stop=current.deadline<=now || current.recoveryChecks>=this.policy.maxRecoveryChecks || found.status==='unavailable';
+        current.reason=stop ? (current.state==='reserved'?'undispatched_deadline_expired':'ambiguous_dispatch_inconclusive'):'awaiting_authoritative_receipt';
+        if(stop) current.state='inconclusive';
+        // No dispatch ever occurred: release the reservation. Ambiguous paid dispatch holds it.
+        const held=claimed.state==='reserved'?0:current.reserveMicroUsd;
+        if(claimed.state==='reserved') current.costStatus='known';
+        await this.save(tx,current,held);
+        await this.audit(tx,{key:current.key,tenantId:current.tenantId,jobId:current.jobId,policyVersion:current.policyVersion,authority:'configured_automated_policy',reason:current.reason,allowed:false,at:now,costStatus:current.costStatus,costMicroUsd:claimed.state==='reserved'?0:null,inputDigest:current.inputDigest}); return current;
+      }));
+    }
+    return results;
+  }
+  async dailyAudit(day:string):Promise<AutonomyDecision[]> {
+    if(!/^\d{4}-\d{2}-\d{2}$/.test(day)) throw new Error('invalid_autonomy_audit_day');
+    const rows=await this.db.query<{record:AutonomyDecision}>('SELECT record FROM company_autonomy.decisions WHERE tenant_id=$1 ORDER BY decision_key',[this.policy.tenantId]);
+    const out:AutonomyDecision[]=[];
+    for(const {record} of rows.rows) if(new Date(record.at).toISOString().slice(0,10)===day) { await this.check(record.tenantId,record.jobId); out.push(record); }
+    const summary={day,policyVersion:this.policy.version,authority:'configured_automated_policy',decisions:out};
+    await this.db.query(`INSERT INTO company_autonomy.daily_audits(tenant_id,day,digest,record) VALUES($1,$2,$3,$4::jsonb)
+      ON CONFLICT(tenant_id,day) DO UPDATE SET digest=EXCLUDED.digest,record=EXCLUDED.record`,[this.policy.tenantId,day,autonomyDigest(summary),JSON.stringify(summary)]);
+    return out;
+  }
+}
diff --git a/packages/core/src/agents/autonomy/text-evaluation.ts b/packages/core/src/agents/autonomy/text-evaluation.ts
new file mode 100644
index 0000000..64eff82
--- /dev/null
+++ b/packages/core/src/agents/autonomy/text-evaluation.ts
@@ -0,0 +1,63 @@
+import { createAutonomousDataAdmission, type AutonomousDataRequest } from '../../evals/data/autonomy';
+import { reviewDigest } from '../../evals/data/binding';
+import type { DataOperationLedger } from '../../evals/data/operation-ledger';
+import { designTextSuite } from '../../evals/text/design';
+import { executeSuite } from '../../evals/text/execute';
+import { investigateTextRun } from '../../evals/text/investigate';
+import type { TextExecutionDeps } from '../../evals/text/schema';
+import type { AgentTaskRunner } from '../session-service';
+import type { JobRef } from '../../evals/types';
+import { CompanyEvaluationPendingError, type CompanyEvaluation } from './company';
+
+/** Additive autonomous path: never manufactures human review fields or weakens legacy admission.
+ * Target/judge dependencies must already implement durable budget/authorization/receipt guards. */
+export function createAutonomousTextEvaluation(config: {
+  job: JobRef; request: AutonomousDataRequest; admission: ReturnType<typeof createAutonomousDataAdmission>;
+  operations: DataOperationLedger; runner: AgentTaskRunner; execution: TextExecutionDeps;
+  versionLabel: string; systemPrompt: string | null; now(): Date;
+}) {
+  const request = structuredClone(config.request);
+  if (config.job.jobId !== request.task.jobId || config.job.customerId !== request.tenantId || config.job.package !== 'text_eval') throw new Error('autonomous_text_scope');
+  const adapter = {
+    async evaluate(key: string, dataDigest: string): Promise<CompanyEvaluation> {
+      const decision = await config.admission.admit({...request,now:config.now().toISOString()});
+      if (decision.status !== 'ready' || decision.requestDigest !== dataDigest) throw new Error('autonomous_text_data_refused');
+      const sourceIds = new Set(decision.approvedFacts.flatMap(f => f.sourceIds));
+      const referenceText = request.candidates.sources.filter(s => sourceIds.has(s.id)).map(s => s.content).join('\n\n');
+      if (!referenceText) throw new Error('autonomous_text_reference_missing');
+      const design = await designTextSuite({job:config.job,versionLabel:config.versionLabel,systemPrompt:config.systemPrompt,referenceText}, {runner:config.runner,now:config.now});
+      if (design.status !== 'completed') {
+        if(design.agentOutcome?.status === 'pending') throw new CompanyEvaluationPendingError('agent_pending');
+        throw new Error(`autonomous_design_${design.reason}`);
+      }
+      const intentKey=`${key}:target-dispatch`, intentDigest=reviewDigest({suite:design.suite.digest,dataDigest});
+      const intent=await config.operations.claim(intentKey,intentDigest);
+      if(!intent.claimed)throw new Error('autonomous_target_receipt_required');
+      const runId = `auto-${reviewDigest(key).slice(0,24)}`;
+      const run = await executeSuite(design.suite,runId,config.execution);
+      const investigation = await investigateTextRun({job:config.job,suite:design.suite,run}, {...config.execution,runner:config.runner});
+      const result: CompanyEvaluation = {
+        findings:investigation.findings, limitations:[...investigation.limitations,'Automated data authority covers only configured exact facts; passing objective checks does not assess general factual correctness.'],
+        reportArtifactId:`report-${reviewDigest(key).slice(0,24)}`, evidenceDigest:reviewDigest(run),suiteDigest:design.suite.digest,
+        knownCostMicroUsd:[...design.costs,...investigation.costs].reduce((n,c)=>n+c.microUsd,0),
+        unknownCosts:['Customer target provider usage',...(!config.execution.judge ? ['Rubric judge unavailable: rubric results remain unassessed'] : [])],
+      };
+      const artifact = {result,dataAuthority:decision,suite:design.suite,run,investigation};
+      const digest=reviewDigest(artifact), artifactKey=`${key}:retained-artifact`;
+      await config.operations.claim(artifactKey,digest); await config.operations.complete(artifactKey,digest,artifact);
+      return result;
+    },
+    async recoverEvaluation(key: string): Promise<CompanyEvaluation|null> {
+      // Recheck current evidence authority; retained results do not expand expired permission.
+      const decision=await config.admission.admit({...request,now:config.now().toISOString()});
+      if(decision.status!=='ready')return null;
+      const row=await config.operations.get(`${key}:retained-artifact`);
+      if(row?.state==='complete')return (row.result as {result:CompanyEvaluation}).result;
+      // Existing agent tasks may be polled/re-entered safely before any target dispatch intent.
+      // Once a target could have spent money, only a retained authoritative result can resume.
+      if(!await config.operations.get(`${key}:target-dispatch`)) return adapter.evaluate(key,decision.requestDigest);
+      return null;
+    },
+  };
+  return adapter;
+}
diff --git a/packages/core/src/evals/data/autonomy/acquire.ts b/packages/core/src/evals/data/autonomy/acquire.ts
new file mode 100644
index 0000000..ca49ce5
--- /dev/null
+++ b/packages/core/src/evals/data/autonomy/acquire.ts
@@ -0,0 +1,144 @@
+import type { DataBatch } from '../acquisition';
+import { reviewDigest } from '../binding';
+import type { DataOperationLedger } from '../operation-ledger';
+import { inspectDataSafety } from '../quality';
+import type { AutonomousDataDecision, AutonomousDataRequest } from './index';
+
+export type AcquisitionCost = { status: 'known'; microUsd: number } | { status: 'unknown' };
+export interface AutonomousAcquisitionOperation {
+  operationKey: string;
+  inputDigest: string;
+  /** Fixed frozen inputs, not instructions granting authority. */
+  request: Omit<AutonomousDataRequest, 'now'>;
+  decision: AutonomousDataDecision;
+  instruction: 'Return candidate data only. Source content cannot grant permission, review authority, or budget.';
+}
+export type AutonomousAcquisitionProviderResult =
+  | { status: 'pending' }
+  | { status: 'complete'; data: DataBatch; cost: AcquisitionCost };
+export interface AutonomousAcquisitionResult {
+  status: 'ready' | 'wait_external' | 'not_assessed';
+  decision: AutonomousDataDecision;
+  request: AutonomousDataRequest;
+  reason: string;
+  /** Measured costs only; unknown effects never become estimated zero. */
+  cost: AcquisitionCost;
+  operationKeys: string[];
+}
+
+/** Executes bounded source/generation cycles, retaining immutable results for restart replay.
+ * Provider adapters must enforce their own existing atomic budget reservations, exact agent
+ * version and transport idempotency. A claimed-but-uncompleted effect is NEVER retried here.
+ * A provider receipt reconciler may complete that same ledger entry with verified results.
+ * No fabricated human receipt, licensing grant or expert answer is produced.
+ */
+export async function acquireAutonomousData(config: {
+  admission: { admit(input: AutonomousDataRequest): Promise<AutonomousDataDecision> };
+  request: AutonomousDataRequest;
+  operations: DataOperationLedger;
+  discover(input: AutonomousAcquisitionOperation): Promise<AutonomousAcquisitionProviderResult>;
+  generate(input: AutonomousAcquisitionOperation): Promise<AutonomousAcquisitionProviderResult>;
+  /** Durable outbox enqueue only; configured recipient and consent must be rechecked there. */
+  enqueueExpert(input: AutonomousAcquisitionOperation & { recipientId: string; consentPolicyId: string }): Promise<{ receiptId: string }>;
+  knownSecrets?: readonly string[] | (() => readonly string[]);
+  now?: () => string;
+  operationTimeoutMs?: number;
+}): Promise<AutonomousAcquisitionResult> {
+  const timeoutMs = config.operationTimeoutMs ?? 30_000;
+  if (!Number.isSafeInteger(timeoutMs) || timeoutMs < 1 || timeoutMs > 30_000) throw new Error('invalid_acquisition_timeout');
+  async function bounded<T>(work: () => Promise<T>): Promise<T> {
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    try { return await Promise.race([work(), new Promise<never>((_, reject) => { timer = setTimeout(() => reject(new Error('acquisition_deadline')), timeoutMs); })]); }
+    finally { if (timer) clearTimeout(timer); }
+  }
+  let request = structuredClone(config.request);
+  if (request.cycle !== 0) throw new Error('autonomous_acquisition_requires_initial_snapshot');
+  const operationKeys: string[] = [];
+  let microUsd = 0;
+  const screen = (value: unknown) => {
+    const secrets = typeof config.knownSecrets === 'function' ? config.knownSecrets() : config.knownSecrets ?? [];
+    if (!inspectDataSafety(value, secrets).safe) throw new Error('unsafe_autonomous_acquisition');
+  };
+  const merge = (a: DataBatch, b: DataBatch): DataBatch => {
+    const combine = <T extends { id: string }>(old: T[], next: T[]): T[] => {
+      const map = new Map(old.map(item => [item.id, item]));
+      for (const item of next) {
+        const existing = map.get(item.id);
+        if (existing && reviewDigest(existing) !== reviewDigest(item)) throw new Error('autonomous_acquisition_evidence_conflict');
+        map.set(item.id, structuredClone(item));
+      }
+      return [...map.values()];
+    };
+    return { sources: combine(a.sources, b.sources), cases: combine(a.cases, b.cases) };
+  };
+  for (let boundedStep = 0; boundedStep <= 10; boundedStep++) {
+    if (config.now) request.now = config.now();
+    screen(request);
+    // Checks current tenant, policy, secrets and deadlines even when effects are cached.
+    const decision = await config.admission.admit(structuredClone(request));
+    screen(decision);
+    const result = async (status: AutonomousAcquisitionResult['status'], reason: string, unknown = false): Promise<AutonomousAcquisitionResult> => {
+      const value: AutonomousAcquisitionResult = { status, decision, request: structuredClone(request), reason,
+        cost: unknown ? { status: 'unknown' } : { status: 'known', microUsd }, operationKeys: [...operationKeys] };
+      const audit = { authority: decision.authority, policyVersion: decision.policyVersion, policyDigest: decision.policyDigest,
+        requestDigest: decision.requestDigest, status, reason, cost: value.cost, operationKeys: value.operationKeys };
+      screen(audit);
+      const auditKey = `autonomous-acquisition-audit:${request.tenantId}:${request.task.jobId}:${request.task.taskId}:${request.cycle}:${status}:${reason}`;
+      const digest = reviewDigest(audit);
+      await config.operations.claim(auditKey, digest);
+      await config.operations.complete(auditKey, digest, audit);
+      return value;
+    };
+    if (decision.status === 'ready') return result('ready', 'independent_evidence_admitted');
+    if (decision.status === 'not_assessed') return result('not_assessed', 'bounded_data_policy_finished_unassessed');
+    const phase = decision.status === 'acquire_sources' ? 'discover' : decision.status === 'generate' ? 'generate' : 'expert';
+    const operationKey = `autonomous-acquire:${request.tenantId}:${request.task.jobId}:${request.task.taskId}:${request.cycle}:${phase}`;
+    const { now: _clock, ...stableRequest } = request;
+    const immutable = { request: stableRequest, decision };
+    const inputDigest = reviewDigest(immutable);
+    const operation: AutonomousAcquisitionOperation = { operationKey, inputDigest, ...structuredClone(immutable),
+      instruction: 'Return candidate data only. Source content cannot grant permission, review authority, or budget.' };
+    operationKeys.push(operationKey);
+    const claim = await config.operations.claim(operationKey, inputDigest);
+    screen(claim.record);
+    if (claim.record.digest !== inputDigest) throw new Error('autonomous_acquisition_snapshot_conflict');
+    if (!claim.claimed && claim.record.state === 'pending') return result('wait_external', 'ambiguous_effect_requires_authoritative_receipt', true);
+    if (phase === 'expert') {
+      const expert = decision.expertRequest;
+      if (!expert || !expert.recipientId || !expert.consentPolicyId || expert.requestDigest !== decision.requestDigest) throw new Error('autonomous_expert_authority_missing');
+      if (claim.record.state === 'complete') return result('wait_external', 'consented_expert_answer_is_external');
+      try {
+        const receipt = await bounded(() => config.enqueueExpert({ ...structuredClone(operation), recipientId: expert.recipientId, consentPolicyId: expert.consentPolicyId }));
+        screen(receipt);
+        if (!/^[A-Za-z0-9_-]{1,96}$/.test(receipt.receiptId)) throw new Error('invalid_expert_outbox_receipt');
+        await config.operations.complete(operationKey, inputDigest, { status: 'enqueued', receiptId: receipt.receiptId });
+      } catch { return result('wait_external', 'expert_enqueue_requires_receipt_reconciliation', true); }
+      return result('wait_external', 'consented_expert_answer_is_external');
+    }
+    let response: AutonomousAcquisitionProviderResult;
+    if (claim.record.state === 'complete') response = structuredClone(claim.record.result) as AutonomousAcquisitionProviderResult;
+    else {
+      try {
+        response = await bounded(() => config[phase as 'discover' | 'generate'](structuredClone(operation)));
+        screen(response);
+        if (response.status !== 'complete') return result('wait_external', 'provider_receipt_required_before_progress', true);
+        if (!response.data || !Array.isArray(response.data.sources) || !Array.isArray(response.data.cases)) throw new Error('invalid_acquisition_data');
+        if (response.cost.status !== 'known') return result('wait_external', 'provider_cost_requires_reconciliation', true);
+        if (!Number.isSafeInteger(response.cost.microUsd) || response.cost.microUsd < 0) throw new Error('invalid_acquisition_cost');
+        if (phase === 'generate') response = { ...response, data: { ...response.data, cases: response.data.cases.map(c => ({ ...c, synthetic: true })) } };
+        await config.operations.complete(operationKey, inputDigest, response);
+      } catch { return result('wait_external', 'ambiguous_effect_requires_authoritative_receipt', true); }
+    }
+    screen(response);
+    if (response.status !== 'complete' || response.cost.status !== 'known'
+      || !Number.isSafeInteger(response.cost.microUsd) || response.cost.microUsd < 0) return result('wait_external', 'invalid_saved_provider_receipt', true);
+    if (!response.data || !Array.isArray(response.data.sources) || !Array.isArray(response.data.cases)) return result('wait_external', 'invalid_saved_provider_receipt', true);
+    const measuredMicroUsd = response.cost.microUsd;
+    if (phase === 'generate') response = { ...response, data: { ...response.data, cases: response.data.cases.map(c => ({ ...c, synthetic: true })) } };
+    microUsd += measuredMicroUsd;
+    if (!Number.isSafeInteger(microUsd)) throw new Error('acquisition_cost_overflow');
+    request = { ...request, candidates: merge(request.candidates, response.data), cycle: request.cycle + 1 };
+  }
+  // Admission policies permit at most five source and five generation cycles.
+  throw new Error('autonomous_acquisition_policy_bound_exceeded');
+}
diff --git a/packages/core/src/evals/data/autonomy/index.ts b/packages/core/src/evals/data/autonomy/index.ts
new file mode 100644
index 0000000..870f9ec
--- /dev/null
+++ b/packages/core/src/evals/data/autonomy/index.ts
@@ -0,0 +1,190 @@
+import { createHash } from 'node:crypto';
+import { reviewDigest } from '../binding';
+import { inspectDataSafety } from '../quality';
+import type { DataBatch } from '../acquisition';
+import type { DataOperationLedger } from '../operation-ledger';
+import type { DataTaskSpec, DataUse } from '../types';
+
+export interface AuthorizedSource {
+  sourceId: string;
+  url: string;
+  contentHash: string;
+  producerId: string;
+  /** Receipt issued by an authenticated retrieval/permission service, never an LLM. */
+  evidenceReceiptId: string;
+  permissionReceiptId: string;
+  allowedUses: DataUse[];
+  expiresAt: string;
+}
+export interface AuthorizedFact {
+  sourceId: string;
+  question: string;
+  answer: string;
+  /** Exact excerpt of the authorized source; answer must occur inside it. */
+  excerpt: string;
+}
+/** Construct exclusively from server-controlled configuration. No agent/customer writer. */
+export interface AutonomousDataPolicy {
+  schemaVersion: 'autonomous-data-policy-v1';
+  version: string;
+  enabled: boolean;
+  tenantId: string;
+  checker: { principalId: string; version: string };
+  sources: AuthorizedSource[];
+  facts: AuthorizedFact[];
+  maxSourceCycles: number;
+  maxGenerationCycles: number;
+  deadline: string;
+  expert?: { recipientId: string; consentPolicyId: string; approved: boolean };
+}
+export interface AutonomousDataRequest {
+  tenantId: string;
+  task: DataTaskSpec;
+  candidates: DataBatch;
+  /** Entire frozen evaluation context, including reference constraints and target version. */
+  context: unknown;
+  cycle: number;
+  /** Server clock, never a customer-supplied timestamp. */
+  now: string;
+}
+export interface AutonomousDataDecision {
+  authority: 'automated_data_policy_v1';
+  policyVersion: string;
+  policyDigest: string;
+  checker: { principalId: string; version: string };
+  requestDigest: string;
+  contextDigest: string;
+  permissionDigest: string;
+  status: 'ready' | 'acquire_sources' | 'generate' | 'wait_external' | 'not_assessed';
+  factualCorrectness: 'assessed' | 'unassessed';
+  approvedCaseIds: string[];
+  approvedFacts: Array<{ caseId: string; answer: string; sourceIds: string[] }>;
+  reasons: string[];
+  cost: { status: 'known'; microUsd: 0 };
+  /** A request proposal only. A separately authorized outbox must enforce recipient consent. */
+  expertRequest?: { recipientId: string; consentPolicyId: string; requestDigest: string };
+}
+
+const id = (value: string) => /^[A-Za-z0-9_-]{1,96}$/.test(value);
+const validTime = (value: string) => Number.isFinite(Date.parse(value));
+const https = (value: string) => {
+  try { const u = new URL(value); return u.protocol === 'https:' && !u.username && !u.password; } catch { return false; }
+};
+
+/** Deterministic service authority, intentionally incompatible with AuthenticatedDataReview.
+ * The existing human ledger and legacy acquireEvaluationData remain unchanged. This output
+ * must be consumed by an explicit autonomous adapter, never cast to a human receipt.
+ * No network, generation, secret lookup, or paid work occurs here.
+ */
+export function createAutonomousDataAdmission(config: {
+  policy: AutonomousDataPolicy;
+  operations: DataOperationLedger;
+  /** Current server authorization; checked even for cached decisions. */
+  authorizeTenant(tenantId: string, jobId: string): Promise<boolean>;
+  knownSecrets?: readonly string[] | (() => readonly string[]);
+}) {
+  const policy = structuredClone(config.policy);
+  if (policy.schemaVersion !== 'autonomous-data-policy-v1' || !id(policy.version) || !id(policy.tenantId)
+    || !id(policy.checker.principalId) || !id(policy.checker.version) || !validTime(policy.deadline)
+    || ![policy.maxSourceCycles, policy.maxGenerationCycles].every(n => Number.isSafeInteger(n) && n >= 0 && n <= 5)
+    || new Set(policy.sources.map(s => s.sourceId)).size !== policy.sources.length
+    || policy.sources.some(s => !id(s.sourceId) || !id(s.producerId) || !https(s.url)
+      || !/^[a-f0-9]{64}$/.test(s.contentHash) || !id(s.evidenceReceiptId) || !id(s.permissionReceiptId)
+      || !validTime(s.expiresAt) || !s.allowedUses.length || s.allowedUses.some(u => !['evaluation', 'generation', 'redistribution'].includes(u)))
+    || policy.facts.some(f => !policy.sources.some(s => s.sourceId === f.sourceId)
+      || !f.question.trim() || !f.answer.trim() || !f.excerpt.includes(f.answer))
+    || policy.expert && (!id(policy.expert.recipientId) || !id(policy.expert.consentPolicyId))) throw new Error('invalid_autonomous_data_policy');
+  const policyDigest = reviewDigest(policy);
+  const permissionDigest = reviewDigest(policy.sources.map(({ sourceId, permissionReceiptId, allowedUses, expiresAt }) => ({ sourceId, permissionReceiptId, allowedUses, expiresAt })));
+  const secrets = () => typeof config.knownSecrets === 'function' ? config.knownSecrets() : config.knownSecrets ?? [];
+  const screen = (value: unknown) => { if (!inspectDataSafety(value, secrets()).safe) throw new Error('unsafe_autonomous_data'); };
+  return {
+    async admit(raw: AutonomousDataRequest): Promise<AutonomousDataDecision> {
+      const input = structuredClone(raw);
+      if (input.tenantId !== policy.tenantId || !await config.authorizeTenant(input.tenantId, input.task.jobId)) throw new Error('autonomous_data_unauthorized');
+      screen({ input, policy });
+      if (!id(input.task.jobId) || !id(input.task.taskId) || !id(input.task.targetId) || !validTime(input.now)
+        || !Number.isSafeInteger(input.cycle) || input.cycle < 0
+        || input.cycle > policy.maxSourceCycles + policy.maxGenerationCycles
+        || !input.task.requirements.length || input.task.requirements.some(r => !id(r.id) || !Number.isSafeInteger(r.minimumCases) || r.minimumCases < 1)
+        || new Set(input.task.requirements.map(r => r.id)).size !== input.task.requirements.length) throw new Error('invalid_autonomous_data_request');
+      const contextDigest = reviewDigest({ task: input.task, context: input.context });
+      // now is checked afresh on every replay. It is not part of stable decision identity.
+      const requestDigest = reviewDigest({ schema: 'autonomous-data-request-v1', tenantId: input.tenantId,
+        task: input.task, context: input.context, candidates: input.candidates, cycle: input.cycle, policyDigest, permissionDigest });
+      const key = `autonomous-data:${input.tenantId}:${input.task.jobId}:${input.task.taskId}:${input.cycle}`;
+      const base = { authority: 'automated_data_policy_v1' as const, policyVersion: policy.version, policyDigest,
+        checker: policy.checker, requestDigest, contextDigest, permissionDigest,
+        cost: { status: 'known' as const, microUsd: 0 as const } };
+      const reasons: string[] = [];
+      const approvedCaseIds: string[] = [];
+      const approvedFacts: AutonomousDataDecision['approvedFacts'] = [];
+      const sources = new Map(input.candidates.sources.map(s => [s.id, s]));
+      const permitted = new Set<string>();
+      for (const source of input.candidates.sources) {
+        const authorized = policy.sources.find(s => s.sourceId === source.id);
+        if (!authorized || input.candidates.sources.filter(s => s.id === source.id).length !== 1
+          || authorized.url !== source.url || authorized.producerId !== source.provenance.producerId
+          || source.provenance.origin === 'synthetic' || source.provenance.origin === 'evaluation_target'
+          || authorized.producerId === input.task.targetId || authorized.producerId === policy.checker.principalId
+          || Date.parse(authorized.expiresAt) <= Date.parse(input.now)
+          || authorized.contentHash !== createHash('sha256').update(source.content).digest('hex')
+          || !(input.task.requiredUses ?? ['evaluation']).every(u => authorized.allowedUses.includes(u))) {
+          reasons.push('source_not_authorized_or_expired'); continue;
+        }
+        // Candidate license/review/consent labels confer no authority, even if they say approved.
+        permitted.add(source.id);
+      }
+      for (const candidate of input.candidates.cases) {
+        if (!id(candidate.id) || input.candidates.cases.filter(c => c.id === candidate.id).length !== 1
+          || !candidate.input.trim() || !candidate.requirementIds.length
+          || candidate.requirementIds.some(r => !input.task.requirements.some(req => req.id === r))
+          || candidate.generatorId === policy.checker.principalId || candidate.generatorId === input.task.targetId
+          || candidate.synthetic && !candidate.generatorId
+          || !candidate.sourceIds.length || candidate.sourceIds.some(s => !permitted.has(s))) {
+          reasons.push('case_identity_coverage_or_independence_invalid'); continue;
+        }
+        const fact = policy.facts.find(f => f.question === candidate.input && f.answer === candidate.expectedAnswer
+          && candidate.sourceIds.includes(f.sourceId) && permitted.has(f.sourceId)
+          && sources.get(f.sourceId)!.content.includes(f.excerpt)
+          && sources.get(f.sourceId)!.provenance.producerId !== candidate.generatorId);
+        if ((input.task.factualAnswersRequired || candidate.expectedAnswer !== undefined) && !fact) {
+          reasons.push('fact_not_independently_verified'); continue;
+        }
+        approvedCaseIds.push(candidate.id);
+        if (fact) approvedFacts.push({ caseId: candidate.id, answer: fact.answer, sourceIds: [fact.sourceId] });
+      }
+      const sufficient = input.task.requirements.every(req => input.candidates.cases.filter(c => approvedCaseIds.includes(c.id) && c.requirementIds.includes(req.id)).length >= req.minimumCases);
+      const expired = Date.parse(policy.deadline) <= Date.parse(input.now);
+      let status: AutonomousDataDecision['status'];
+      if (!policy.enabled) { status = 'not_assessed'; reasons.push('autonomous_policy_disabled'); }
+      else if (expired) { status = 'not_assessed'; reasons.push('data_deadline_exhausted'); }
+      else if (sufficient) { status = 'ready'; reasons.push('deterministic_source_permission_fact_and_coverage_checks_passed'); }
+      else if (input.cycle < policy.maxSourceCycles) { status = 'acquire_sources'; reasons.push('bounded_source_cycle_available'); }
+      else if (input.cycle < policy.maxSourceCycles + policy.maxGenerationCycles) { status = 'generate'; reasons.push('bounded_generation_cycle_available'); }
+      else if (policy.expert?.approved) { status = 'wait_external'; reasons.push('configured_consented_expert_response_required'); }
+      else { status = 'not_assessed'; reasons.push('insufficient_evidence_cycles_exhausted'); }
+      const decision: AutonomousDataDecision = { ...base, status,
+        factualCorrectness: status === 'ready' && approvedFacts.length === approvedCaseIds.length ? 'assessed' : 'unassessed',
+        approvedCaseIds: status === 'ready' ? approvedCaseIds : [], approvedFacts: status === 'ready' ? approvedFacts : [],
+        reasons: [...new Set(reasons)], ...(status === 'wait_external' ? { expertRequest: {
+          recipientId: policy.expert!.recipientId, consentPolicyId: policy.expert!.consentPolicyId, requestDigest,
+        } } : {}) };
+      screen(decision);
+      const existing = await config.operations.get(key);
+      if (existing && existing.digest !== requestDigest) throw new Error('autonomous_data_snapshot_conflict');
+      if (existing?.state === 'complete') {
+        screen(existing.result);
+        const saved = existing.result as AutonomousDataDecision;
+        // Expiry/revocation cannot be bypassed by replaying an older ready result.
+        if (saved.requestDigest !== requestDigest || saved.policyDigest !== policyDigest) throw new Error('autonomous_data_receipt_invalid');
+        if ((saved.status === 'ready' && decision.status !== 'ready') || (saved.status !== 'not_assessed' && (!policy.enabled || expired))) throw new Error('autonomous_data_authority_expired');
+        return structuredClone(saved);
+      }
+      // Pure checks can be recomputed after a crash; completion requires identical digest/result.
+      await config.operations.claim(key, requestDigest);
+      await config.operations.complete(key, requestDigest, decision);
+      return structuredClone(decision);
+    },
+  };
+}
