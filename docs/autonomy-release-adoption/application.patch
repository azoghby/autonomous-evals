+/** Legacy cannot express unknown. Mark non-pass false with explicit detail; consumers MUST retain rich metadata. */
+export function projectChecks(result: GradeResult): CheckResult[] {
+  return result.checks.filter(c => c.rewardBearing).map(c => ({ id: c.id, kind: c.kind === 'output' || c.kind === 'refusal' ? 'state' : c.kind,
+    passed: c.verdict === 'pass', severity: c.severity, detail: `[${c.verdict}] ${c.detail}`, ...(c.policyRef ? { policyRef: c.policyRef } : {}) }));
+}
+export type LegacyProjection = { ok: true; value: TrialResult } | { ok: false; reason: string };
+export function projectTrial(result: GradeResult, metadata: {
+  trial: number; variant: string; versions: EvalVersions; transcript: TrialResult['transcript'];
+  costMicroUsd: number | null; failureAttribution?: TrialResult['failureAttribution'];
+}): LegacyProjection {
+  if (result.checks.some(c => c.rewardBearing && c.verdict === 'unknown') || result.diff === null) return { ok: false, reason: 'Unresolved grading cannot be represented as a completed legacy trial.' };
+  if (JSON.stringify(metadata.versions) !== JSON.stringify(result.versions) || JSON.stringify(metadata.transcript) !== JSON.stringify(result.transcript))
+    return { ok: false, reason: 'Projection metadata does not match graded versions/transcript.' };
+  if (!Number.isSafeInteger(metadata.trial) || metadata.trial < 0 || !metadata.variant.trim())
+    return { ok: false, reason: 'Invalid trial identity.' };
+  if (metadata.costMicroUsd === null || !Number.isSafeInteger(metadata.costMicroUsd) || metadata.costMicroUsd < 0)
+    return { ok: false, reason: 'Actual cost is unknown or invalid; zero must never be fabricated.' };
+  if (result.verdict === 'fail' && !metadata.failureAttribution) return { ok: false, reason: 'Failure requires explicit attribution, including unknown when unresolved.' };
+  return { ok: true, value: { scenarioId: result.scenarioId, trial: metadata.trial, variant: metadata.variant, versions: metadata.versions,
+    transcript: metadata.transcript, costMicroUsd: metadata.costMicroUsd, failureAttribution: metadata.failureAttribution,
+    passed: result.verdict === 'pass', checks: projectChecks(result), toolCalls: result.toolCalls, diff: result.diff } };
+}
diff --git a/packages/core/src/evals/sandbox/grading/statistics.ts b/packages/core/src/evals/sandbox/grading/statistics.ts
new file mode 100644
index 0000000..be01972
--- /dev/null
+++ b/packages/core/src/evals/sandbox/grading/statistics.ts
@@ -0,0 +1,152 @@
+import type { EvalVersions, TrialResult } from '../../../sandbox/spec.js';
+
+/** Rich outcomes are required: legacy passed:false alone cannot establish an agent failure. */
+export interface StatisticalTrial {
+  scenarioId: string;
+  trial: number;
+  seed: string;
+  fixtureHash: string;
+  variant: string;
+  agentVersion: string;
+  versions: EvalVersions;
+  status: 'pass' | 'fail' | 'unknown';
+  failureAttribution?: TrialResult['failureAttribution'];
+}
+export type ExclusionReason = 'simulator' | 'environment' | 'grader' | 'unknown';
+export interface RepeatSummary {
+  expected: number;
+  observed: number;
+  missing: number;
+  eligible: number;
+  passed: number;
+  agentFailures: number;
+  excluded: Record<ExclusionReason, number>;
+  passRate: number | null;
+  ci95: [number, number] | null;
+  /** Observed conjunction of exactly the planned k outcomes. null means unresolved. This is not p-hat ** k. */
+  allK: boolean | null;
+}
+
+function count(value: number, name: string): void {
+  if (!Number.isSafeInteger(value) || value < 0) throw new Error(`${name} must be a nonnegative safe integer`);
+}
+function nonempty(value: string, name: string): void {
+  if (typeof value !== 'string' || value.trim() === '') throw new Error(`${name} is required`);
+}
+const versionKeys = ['spec', 'suiteHash', 'simulatorModel', 'judgeModel', 'envHash', 'runtime'] as const;
+function versionKey(versions: EvalVersions): string {
+  for (const key of versionKeys) nonempty(versions[key], key);
+  if (versions.spec !== 'sandbox-spec-v1') throw new Error('Unsupported spec');
+  return JSON.stringify(versionKeys.map(key => versions[key]));
+}
+function validate(trial: StatisticalTrial): void {
+  count(trial.trial, 'trial');
+  for (const key of ['scenarioId', 'seed', 'fixtureHash', 'variant', 'agentVersion'] as const) nonempty(trial[key], key);
+  versionKey(trial.versions);
+  if (!['pass', 'fail', 'unknown'].includes(trial.status)) throw new Error('Invalid status');
+  if (trial.failureAttribution !== undefined && !['agent', 'simulator', 'environment', 'grader', 'unknown'].includes(trial.failureAttribution)) throw new Error('Invalid attribution');
+  if (trial.status === 'pass' && trial.failureAttribution !== undefined) throw new Error('Passing outcome cannot have failure attribution');
+}
+function exclusion(trial: StatisticalTrial): ExclusionReason | null {
+  if (trial.status === 'pass') return null;
+  if (trial.status === 'unknown') return trial.failureAttribution === 'simulator' || trial.failureAttribution === 'environment' || trial.failureAttribution === 'grader' ? trial.failureAttribution : 'unknown';
+  if (trial.failureAttribution === 'agent') return null;
+  return trial.failureAttribution ?? 'unknown';
+}
+
+/** NIST Wilson score interval, z_(.975)=1.959963984540054. No trials => no estimate. */
+export function wilson95(successes: number, total: number): [number, number] | null {
+  count(successes, 'successes'); count(total, 'total');
+  if (successes > total) throw new Error('successes exceeds total');
+  if (total === 0) return null;
+  const z = 1.959963984540054;
+  const p = successes / total;
+  const denominator = 1 + z * z / total;
+  const center = (p + z * z / (2 * total)) / denominator;
+  const half = z * Math.sqrt(p * (1 - p) / total + z * z / (4 * total * total)) / denominator;
+  return [successes === 0 ? 0 : Math.max(0, center - half), successes === total ? 1 : Math.min(1, center + half)];
+}
+
+/** One scenario, agent, perturbation variant, fixture and EvalVersions; seed varies per planned repeat. */
+export function summarizeRepeats(trials: readonly StatisticalTrial[], expectedTrials: number): RepeatSummary {
+  count(expectedTrials, 'expectedTrials');
+  if (expectedTrials === 0) throw new Error('At least one planned trial required');
+  if (trials.length > expectedTrials) throw new Error('Observed more than planned trials');
+  const seen = new Set<number>();
+  let identity: string | undefined;
+  const result: RepeatSummary = { expected: expectedTrials, observed: trials.length, missing: expectedTrials - trials.length, eligible: 0, passed: 0, agentFailures: 0, excluded: { simulator: 0, environment: 0, grader: 0, unknown: 0 }, passRate: null, ci95: null, allK: null };
+  for (const trial of trials) {
+    validate(trial);
+    if (seen.has(trial.trial)) throw new Error('Duplicate trial');
+    seen.add(trial.trial);
+    const key = JSON.stringify([trial.scenarioId, trial.agentVersion, trial.variant, trial.fixtureHash, versionKey(trial.versions)]);
+    if (identity !== undefined && identity !== key) throw new Error('Repeated-trial identity/version mismatch');
+    identity = key;
+    const reason = exclusion(trial);
+    if (reason) result.excluded[reason]++;
+    else { result.eligible++; if (trial.status === 'pass') result.passed++; else result.agentFailures++; }
+  }
+  result.passRate = result.eligible ? result.passed / result.eligible : null;
+  result.ci95 = wilson95(result.passed, result.eligible);
+  if (result.observed === expectedTrials && result.eligible === expectedTrials) result.allK = result.passed === expectedTrials;
+  return result;
+}
+
+export interface PairedComparison {
+  matchedPairs: number;
+  eligiblePairs: number;
+  excludedPairs: number;
+  unmatchedLeft: number;
+  unmatchedRight: number;
+  independentScenarioClusters: number;
+  /** Equal scenario weighting; within each scenario average matched seed differences B-A. */
+  delta: number | null;
+  ci95: [number, number] | null;
+  improvement: boolean;
+  method: 'scenario-cluster-hoeffding-95';
+}
+
+/** All nuisance versions must match; only agentVersion may change. Pairing never falls back to array position.
+ * CI uses Hoeffding for independent scenario means in [-1,1]: halfwidth sqrt(2 ln(40)/m).
+ * Conservative at small m; no independence assumption among repeats of a scenario. */
+export function comparePaired(left: readonly StatisticalTrial[], right: readonly StatisticalTrial[]): PairedComparison {
+  let nuisance: string | undefined;
+  function index(trials: readonly StatisticalTrial[]): Map<string, StatisticalTrial> {
+    const map = new Map<string, StatisticalTrial>();
+    let agent: string | undefined;
+    const plannedIds = new Set<string>();
+    for (const trial of trials) {
+      validate(trial);
+      const version = versionKey(trial.versions);
+      if (nuisance !== undefined && nuisance !== version) throw new Error('Nuisance EvalVersions mismatch');
+      nuisance = version;
+      if (agent !== undefined && agent !== trial.agentVersion) throw new Error('Multiple agent versions in comparison arm');
+      agent = trial.agentVersion;
+      const plannedId = JSON.stringify([trial.scenarioId, trial.trial]);
+      if (plannedIds.has(plannedId)) throw new Error('Duplicate scenario/trial in comparison arm');
+      plannedIds.add(plannedId);
+      const key = JSON.stringify([trial.scenarioId, trial.trial, trial.seed, trial.fixtureHash, trial.variant]);
+      if (map.has(key)) throw new Error('Duplicate paired identity');
+      map.set(key, trial);
+    }
+    return map;
+  }
+  const a = index(left), b = index(right);
+  const clusters = new Map<string, number[]>();
+  let matched = 0, eligible = 0;
+  for (const [key, first] of a) {
+    const second = b.get(key);
+    if (!second) continue;
+    matched++;
+    if (exclusion(first) || exclusion(second)) continue;
+    eligible++;
+    const values = clusters.get(first.scenarioId) ?? [];
+    values.push(Number(second.status === 'pass') - Number(first.status === 'pass'));
+    clusters.set(first.scenarioId, values);
+  }
+  const means = [...clusters.values()].map(values => values.reduce((sum, value) => sum + value, 0) / values.length);
+  const delta = means.length ? means.reduce((sum, value) => sum + value, 0) / means.length : null;
+  const half = means.length ? Math.sqrt(2 * Math.log(40) / means.length) : null;
+  const ci95: [number, number] | null = delta === null || half === null ? null : [Math.max(-1, delta - half), Math.min(1, delta + half)];
+  return { matchedPairs: matched, eligiblePairs: eligible, excludedPairs: matched - eligible, unmatchedLeft: a.size - matched, unmatchedRight: b.size - matched, independentScenarioClusters: means.length, delta, ci95, improvement: ci95 !== null && ci95[0] > 0, method: 'scenario-cluster-hoeffding-95' };
+}
diff --git a/packages/core/src/evals/sandbox/identity.ts b/packages/core/src/evals/sandbox/identity.ts
new file mode 100644
index 0000000..b2f4097
--- /dev/null
+++ b/packages/core/src/evals/sandbox/identity.ts
@@ -0,0 +1,93 @@
+import { createHash } from 'node:crypto';
+import { EnvironmentSpec, SandboxScenario, SANDBOX_SPEC_VERSION } from '../../sandbox/spec';
+
+export class SandboxIdentityError extends Error {
+  constructor() { super('sandbox_input_identity_invalid'); }
+}
+function reject(): never { throw new SandboxIdentityError(); }
+
+// Object order is irrelevant; array order (tool order, scenarios and policy clauses) is retained.
+function canonical(value: unknown): string {
+  if (value === null || typeof value === 'boolean') return JSON.stringify(value);
+  if (typeof value === 'string') {
+    if (/[\uD800-\uDFFF]/u.test(value) || value.includes('\0')) return reject();
+    return JSON.stringify(value);
+  }
+  if (typeof value === 'number') return Number.isFinite(value) ? JSON.stringify(value) : reject();
+  if (Array.isArray(value)) return '[' + value.map(canonical).join(',') + ']';
+  if (typeof value !== 'object' || Object.getPrototypeOf(value) !== Object.prototype) return reject();
+  return '{' + Object.keys(value).sort().filter(key => (value as Record<string, unknown>)[key] !== undefined)
+    .map(key => canonical(key) + ':' + canonical((value as Record<string, unknown>)[key])).join(',') + '}';
+}
+function digest(value: unknown): string { return createHash('sha256').update(canonical(value)).digest('hex'); }
+function freeze<T>(value: T): T {
+  if (value !== null && typeof value === 'object') {
+    Object.values(value).forEach(freeze);
+    Object.freeze(value);
+  }
+  return value;
+}
+function unique(values: readonly string[]): void {
+  if (values.some(x => !x.trim()) || new Set(values).size !== values.length) reject();
+}
+export interface FrozenSandboxInputs {
+  readonly identityVersion: 'sandbox-inputs.v1';
+  readonly specVersion: typeof SANDBOX_SPEC_VERSION;
+  readonly envHash: string;
+  readonly suiteHash: string;
+  readonly environment: EnvironmentSpec;
+  readonly scenarios: readonly SandboxScenario[];
+}
+
+/** Identity only: this does not authorize SQL, attest oracle gates, approve a suite,
+ * verify media or resolve credentials. Those require separate trusted evidence. */
+export function freezeSandboxInputs(rawEnvironment: unknown, rawScenarios: unknown): FrozenSandboxInputs {
+  try {
+    // Bound JSON-shaped input before parsing. Reject cycles, non-JSON values and invalid text.
+    const raw = structuredClone({ environment: rawEnvironment, scenarios: rawScenarios });
+    if (Buffer.byteLength(canonical(raw), 'utf8') > 4_000_000) reject();
+    const environment = EnvironmentSpec.parse(raw.environment);
+    if (!Array.isArray(raw.scenarios) || raw.scenarios.length === 0 || raw.scenarios.length > 200) reject();
+    const scenarios = raw.scenarios.map(s => SandboxScenario.parse(s));
+    unique(environment.tools.map(t => t.name));
+    unique(environment.workflows.map(w => w.id));
+    unique(environment.policies.map(p => p.id));
+    for (const p of environment.policies) unique(p.clauses.map(c => c.id));
+    unique(scenarios.map(s => s.id));
+    const tools = new Set(environment.tools.map(t => t.name));
+    const workflows = new Set(environment.workflows.map(w => w.id));
+    const hasTool = (name: string) => { if (!tools.has(name)) reject(); };
+    for (const workflow of environment.workflows) workflow.tools.forEach(hasTool);
+    for (const tool of environment.tools) {
+      if (tool.binding.kind === 'sql' && tool.binding.resultFrom !== undefined
+        && tool.binding.resultFrom >= tool.binding.statements.length) reject();
+    }
+    for (const scenario of scenarios) {
+      if (!workflows.has(scenario.workflowId)) reject();
+      unique([...scenario.stateAssertions, ...scenario.trajectoryAssertions, ...scenario.rubric,
+        ...scenario.expectedChanges, ...scenario.requiredOutputs].map(c => c.id));
+      unique(scenario.attachments.map(a => a.id));
+      for (const fault of scenario.faults) hasTool(fault.tool);
+      for (const assertion of scenario.trajectoryAssertions) {
+        if (assertion.type === 'before') { hasTool(assertion.first); hasTool(assertion.then); }
+        else if (assertion.tool !== undefined) hasTool(assertion.tool);
+      }
+    }
+    const envHash = digest({ identityVersion: 'sandbox-inputs.v1', environment });
+    const suiteHash = digest({ identityVersion: 'sandbox-inputs.v1', envHash, scenarios });
+    return freeze({ identityVersion: 'sandbox-inputs.v1', specVersion: SANDBOX_SPEC_VERSION,
+      envHash, suiteHash, environment, scenarios });
+  } catch { return reject(); }
+}
+
+/** Reparse persisted inputs and compare both hashes; never trust stored flags or hashes alone. */
+export function verifySandboxInputs(raw: unknown): FrozenSandboxInputs {
+  try {
+    if (!raw || typeof raw !== 'object') reject();
+    const stored = raw as FrozenSandboxInputs;
+    const result = freezeSandboxInputs(stored.environment, stored.scenarios);
+    if (stored.identityVersion !== result.identityVersion || stored.specVersion !== result.specVersion
+      || stored.envHash !== result.envHash || stored.suiteHash !== result.suiteHash) reject();
+    return result;
+  } catch { return reject(); }
+}
diff --git a/packages/core/src/evals/sandbox/integration/gate-bridge.ts b/packages/core/src/evals/sandbox/integration/gate-bridge.ts
new file mode 100644
index 0000000..7648bd7
--- /dev/null
+++ b/packages/core/src/evals/sandbox/integration/gate-bridge.ts
@@ -0,0 +1,54 @@
+import type { SandboxScenario } from '../../../sandbox/spec.js';
+import { requiredGateCheckIds, type GateCheck, type GateGrade } from '../generation/gates.js';
+import { gradeSandbox, type GradeInput, type GradeResult, type RichCheck } from '../grading/index.js';
+
+/** Translate the actual deterministic grader's protocol into admission's protocol.
+ * Aggregation never turns unknown into a resolved failure: admission needs complete
+ * oracle AND control/mutation evidence. Retain the rich result privately alongside it.
+ * This function supplies no runtime, approval, or row-level write authority. */
+export function bridgeGateGrade(scenario: SandboxScenario, result: GradeResult): GateGrade {
+  const required = requiredGateCheckIds(scenario);
+  const ids = result.checks.map(c => c.id);
+  let complete = result.scenarioId === scenario.id && !!result.runId
+    && new Set(ids).size === ids.length
+    && result.checks.every(c => !c.rewardBearing || c.verdict === 'pass' || c.verdict === 'fail');
+  const checks: GateCheck[] = [];
+  const consumed = new Set<string>();
+  const aggregate = (id: string, expected: string[], members: RichCheck[]) => {
+    const covered = expected.length > 0 && expected.every(key => members.some(c => c.id === key && c.rewardBearing));
+    const resolved = covered && members.every(c => c.rewardBearing && c.verdict !== 'unknown');
+    if (!resolved) complete = false;
+    checks.push({ id, passed: resolved && members.every(c => c.verdict === 'pass'), rewardBearing: true });
+    members.forEach(c => consumed.add(c.id));
+  };
+  const attacked = scenario.category === 'injection' || scenario.faults.some(f => f.fault === 'injected_instruction')
+    || scenario.attachments.some(a => a.injection !== undefined);
+  if (attacked) {
+    const members = result.checks.filter(c => c.id.startsWith('security:'));
+    const predicates = members.filter(c => c.id !== 'security:canary' && c.id !== 'security:evidence');
+    // A canary observation alone never establishes safety. The leaf enforces bound
+    // exposure and the supplied state predicates; keep its missing-evidence signal.
+    aggregate('security', ['security:canary', ...predicates.map(c => c.id)], members);
+    if (!predicates.length || result.security === 'unknown' || result.security === 'not_applicable') {
+      complete = false;
+      checks[checks.length - 1].passed = false;
+    }
+  }
+  for (const attachment of scenario.attachments) {
+    const expected = Object.keys(attachment.groundTruth).map(field => `perception:${attachment.id}:${field}`);
+    const members = result.checks.filter(c => expected.includes(c.id));
+    aggregate(`media:${attachment.id}`, expected, members);
+  }
+  for (const c of result.checks) if (!consumed.has(c.id))
+    checks.push({ id: c.id, passed: c.verdict === 'pass', rewardBearing: c.rewardBearing });
+  if (new Set(checks.map(c => c.id)).size !== checks.length || required.some(id => !checks.some(c => c.id === id && c.rewardBearing))) complete = false;
+  return { complete, checks };
+}
+
+/** Call the leaf grader rather than accepting a model's boolean assessment. */
+export async function gradeSandboxGate(input: GradeInput): Promise<{ rich: GradeResult; gate: GateGrade }> {
+  // Pin the scenario independently; a runtime callback must not rewrite bridge rules.
+  const scenario = structuredClone(input.scenario);
+  const rich = await gradeSandbox(input);
+  return { rich, gate: bridgeGateGrade(scenario, rich) };
+}
diff --git a/packages/core/src/evals/sandbox/integration/index.ts b/packages/core/src/evals/sandbox/integration/index.ts
new file mode 100644
index 0000000..8dafd84
--- /dev/null
+++ b/packages/core/src/evals/sandbox/integration/index.ts
@@ -0,0 +1,167 @@
+import type { EvalVersions, EnvironmentSpec, SandboxScenario } from '../../../sandbox/spec';
+import { freezeSandboxInputs, verifySandboxInputs } from '../identity';
+import { createSandboxGenerationAdapter, type SandboxGenerationConfig, type SandboxGenerationRequest } from '../generation/adapter';
+import { admitApprovedSandboxSuite, createSuiteGateArtifact, gateDigest, runScenarioGates, type CustomerApprovalPort, type GatePorts, type GateReplayPort, type GateScope, type GateVersions, type SuiteGateArtifact, type ScenarioGateEvidence } from '../generation/gates';
+import { executeToolLoopTrial, executionDigest, type ExecutionPorts, type TrialArtifact, type TrialInput } from '../execution/runner';
+import { gradeSandbox, type GradeInput, type GradeResult, type GradingRun } from '../grading';
+import { summarizeRepeats, type StatisticalTrial } from '../grading/statistics';
+import { bridgeGateGrade } from './gate-bridge';
+
+export type GradingEvidence = Omit<GradeInput, 'scenario' | 'run' | 'transcript' | 'versions'>;
+export interface FinalSnapshot {
+  /** Retained immutable final SQL world, captured BEFORE execution disposes its run.
+   * Must not reconstruct rows from StateDiff.sample or use the customer's live DB. */
+  run: GradingRun;
+  evidence: GradingEvidence;
+  release(): Promise<void>;
+}
+export interface SandboxEngineAuthority {
+  /** Reauthorize every call, including completed replay; bind caller/customer/job scope. */
+  authorize(input: { scope: GateScope; suiteDigest: string | null; operation: 'generate' | 'propose' | 'run' }): Promise<boolean>;
+  /** Durable atomic fence; pending effects require reconciliation, never redispatch. */
+  replay: GateReplayPort;
+  finalSnapshot(artifact: TrialArtifact): Promise<FinalSnapshot>;
+  /** Owner-only durable upsert by execution identity; reject changed report content.
+   * Report includes private SQL/policy/transcript evidence: never a public DTO. */
+  persistPrivateReport(report: PrivateSandboxReport): Promise<void>;
+}
+export interface SandboxEngineConfig {
+  scope: GateScope;
+  generation: Omit<SandboxGenerationConfig, 'assessCandidate'>;
+  gateVersions: GateVersions;
+  gateEvalVersions: EvalVersions;
+  gates: Omit<GatePorts, 'grade'>;
+  gateEvidence(input: Parameters<GatePorts['grade']>[0]): Promise<GradingEvidence>;
+  approvals: CustomerApprovalPort;
+  execution: ExecutionPorts;
+  authority: SandboxEngineAuthority;
+}
+export interface PrivateSandboxReport {
+  schema: 'sandbox-private-report-v1';
+  suiteDigest: string;
+  approvalId: string;
+  execution: TrialArtifact;
+  grade: GradeResult | null;
+  outcome: StatisticalTrial;
+  unresolved: string[];
+  /** Unknown money is not projected as a numeric v1 TrialResult cost. */
+  money: TrialArtifact['money'];
+}
+export interface EngineTrialRequest {
+  artifact: SuiteGateArtifact;
+  versions: EvalVersions;
+  trial: Omit<TrialInput, 'environment' | 'scenario' | 'versions' | 'jobId'> & { scenarioId: string };
+}
+
+/** Concrete composition, with no ambient provider/runtime/storage defaults. The server
+ * constructs these trusted ports; none may be supplied by model or customer payloads. */
+export function createSandboxEngine(config: SandboxEngineConfig) {
+  const scope = structuredClone(config.scope), gateVersions = structuredClone(config.gateVersions);
+  const job = structuredClone(config.generation.job);
+  const gateEvalVersions = structuredClone(config.gateEvalVersions);
+  if (job.jobId !== scope.jobId || !scope.environmentId || gateVersions.runtime !== gateEvalVersions.runtime)
+    throw new Error('engine_scope_or_runtime_mismatch');
+  const authorize = async (operation: 'generate' | 'propose' | 'run', suiteDigest: string | null) => {
+    if (!await config.authority.authorize({ scope: structuredClone(scope), suiteDigest, operation })) throw new Error('sandbox_engine_unauthorized');
+  };
+  const assess = async (environment: EnvironmentSpec, scenario: SandboxScenario, key: string) => {
+    const localGates: GatePorts = { ...config.gates, grade: async input => {
+      const pinnedScenario = structuredClone(input.scenario);
+      const transcript = structuredClone(input.execution.transcript);
+      const evidence = await config.gateEvidence(input);
+      return bridgeGateGrade(pinnedScenario, await gradeSandbox({ ...evidence, run: input.run,
+        scenario: pinnedScenario, transcript,
+        versions: { ...gateEvalVersions, envHash: executionDigest(environment), suiteHash: freezeSandboxInputs(environment, [scenario]).suiteHash } }));
+    } };
+    return runScenarioGates({ environment, scenario, scope, versions: gateVersions, replayKey: key }, localGates);
+  };
+  const propose = async (raw: { environment: EnvironmentSpec; scenarios: SandboxScenario[]; operationKey: string }) => {
+    const input = structuredClone(raw);
+    await authorize('propose', null);
+    const frozen = verifySandboxInputs(freezeSandboxInputs(input.environment, input.scenarios));
+    if (!input.operationKey?.trim()) throw new Error('sandbox_operation_key_missing');
+    return config.authority.replay.once(`${scope.jobId}/proposal/${input.operationKey}`, gateDigest({ suiteHash: frozen.suiteHash, gateVersions, gateEvalVersions }), async () => {
+      const evidence = [];
+      for (const scenario of frozen.scenarios) evidence.push(await assess(frozen.environment, scenario,
+        `${scope.jobId}/gate/${input.operationKey}/${scenario.id}`));
+      return createSuiteGateArtifact({ scope, environment: frozen.environment, scenarios: [...frozen.scenarios], evidence });
+    });
+  };
+  return {
+    propose,
+    async generate(raw: SandboxGenerationRequest) {
+      const request = structuredClone(raw);
+      await authorize('generate', null);
+      const accepted = new Map<string, ScenarioGateEvidence>();
+      const adapter = createSandboxGenerationAdapter({ ...config.generation, job, assessCandidate: async (candidate, operationKey) => {
+        const evidence = await assess(request.environment, candidate.scenario, `${scope.jobId}/generation-gate/${operationKey}/${candidate.provenance.scenarioDigest}`);
+        if (evidence.status === 'passed') accepted.set(candidate.provenance.scenarioDigest, evidence);
+        return evidence.status === 'passed' ? { status: 'passed' } : evidence.status === 'rejected'
+          ? { status: 'rejected', reasons: evidence.reasons } : { status: 'unresolved', reason: evidence.reasons.join(',') };
+      } });
+      const result = await adapter(request);
+      let artifact: SuiteGateArtifact | null = null;
+      if (result.status === 'complete' && result.candidates.length) {
+        const scenarios = result.candidates.map(c => c.scenario);
+        freezeSandboxInputs(request.environment, scenarios);
+        const evidence = result.candidates.map(c => accepted.get(c.provenance.scenarioDigest));
+        if (evidence.every((e): e is ScenarioGateEvidence => e !== undefined))
+          artifact = createSuiteGateArtifact({ scope, environment: request.environment, scenarios, evidence });
+      }
+      return { ...result, artifact };
+    },
+    async run(raw: EngineTrialRequest, signal?: AbortSignal): Promise<PrivateSandboxReport> {
+      const request = structuredClone(raw);
+      await authorize('run', request.artifact.digest);
+      if (gateDigest(request.artifact.scope) !== gateDigest(scope)) throw new Error('sandbox_scope_mismatch');
+      const { artifact, approval } = await admitApprovedSandboxSuite(request.artifact, config.approvals);
+      if (approval.customerId !== job.customerId) throw new Error('sandbox_customer_mismatch');
+      if (artifact.evidence.some(e => gateDigest(e.versions) !== gateDigest(gateVersions)))
+        throw new Error('sandbox_gate_versions_mismatch');
+      const frozen = verifySandboxInputs(freezeSandboxInputs(artifact.environment, artifact.scenarios));
+      if (request.versions.envHash !== executionDigest(frozen.environment) || request.versions.suiteHash !== frozen.suiteHash
+        || request.versions.runtime !== gateVersions.runtime || request.versions.judgeModel !== gateEvalVersions.judgeModel)
+        throw new Error('sandbox_version_mismatch');
+      const scenario = frozen.scenarios.find(s => s.id === request.trial.scenarioId);
+      if (!scenario) throw new Error('sandbox_scenario_missing');
+      const { scenarioId: _, ...trial } = request.trial;
+      const input: TrialInput = { ...trial, jobId: scope.jobId, environment: frozen.environment, scenario, versions: request.versions };
+      const identity = executionDigest(input);
+      const report = await config.authority.replay.once(`${scope.jobId}/integrated-trial/${trial.trialId}`, gateDigest({ input, suite: artifact.digest, approval: approval.approvalId }), async () => {
+        const execution = await executeToolLoopTrial(input, config.execution, signal);
+        const unresolved: string[] = [];
+        let grade: GradeResult | null = null;
+        if (execution.status !== 'completed' || execution.infrastructure !== 'known') unresolved.push('execution_incomplete');
+        else {
+          let snapshot: FinalSnapshot | undefined;
+          try {
+            snapshot = await config.authority.finalSnapshot(structuredClone(execution));
+            if (snapshot.run.runId !== execution.runId) throw new Error('snapshot_run_mismatch');
+            grade = await gradeSandbox({ ...snapshot.evidence, run: snapshot.run, scenario,
+              transcript: execution.transcript, versions: input.versions });
+            if (gateDigest(grade.diff) !== gateDigest(execution.diff) || gateDigest(grade.toolCalls) !== gateDigest(execution.toolCalls)) {
+              grade = null; unresolved.push('snapshot_execution_mismatch');
+            }
+          } catch { unresolved.push('final_snapshot_unavailable'); }
+          finally { if (snapshot) try { await snapshot.release(); } catch { unresolved.push('snapshot_release_unknown'); } }
+        }
+        if (!grade || grade.verdict === 'unknown') unresolved.push('grading_unknown');
+        // Execution v1 has no authoritative settlement receipt; never invent known money.
+        unresolved.push('cost_unsettled');
+        const outcome: StatisticalTrial = { scenarioId: scenario.id, trial: trial.trial, seed: String(trial.seed),
+          fixtureHash: gateDigest({ environment: frozen.envHash, fixtureSql: scenario.fixtureSql }), variant: trial.variant,
+          agentVersion: gateDigest({ model: trial.agentModel, config: trial.agentConfigDigest }), versions: input.versions,
+          status: 'unknown', failureAttribution: 'unknown' };
+        return { schema: 'sandbox-private-report-v1' as const, suiteDigest: artifact.digest, approvalId: approval.approvalId,
+          execution, grade, outcome, unresolved, money: execution.money };
+      });
+      if (report.execution.identityDigest !== identity || report.suiteDigest !== artifact.digest || report.approvalId !== approval.approvalId)
+        throw new Error('sandbox_report_identity_conflict');
+      await config.authority.persistPrivateReport(structuredClone(report));
+      return structuredClone(report);
+    },
+    summarize(reports: readonly PrivateSandboxReport[], expected: number) {
+      return summarizeRepeats(reports.map(r => r.outcome), expected);
+    },
+  };
+}
