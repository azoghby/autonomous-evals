+  } catch { /* sanitized below */ }
+  if (!trajectoryValid) { toolCalls = []; checks.push(check('trajectory:evidence', 'trajectory', 'unknown', 'Missing or non-monotonic trajectory.', 'high', true, 'environment')); }
