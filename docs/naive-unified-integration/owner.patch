+  </fieldset>)}</Section>
+  <Section title="Record your decision">{noIndependence&&<p role="alert" className="text-sm text-danger">This account produced the evidence or represents the target. An independent operator must review it.</p>}<Check checked={form.independent} onChange={value=>flag('independent',value)}>I am independent of the target, generator and contributor, and have checked conflicts of interest.</Check>{detail.kind==='corpus'&&<Field label="Corpus decision"><select aria-label="Corpus decision" className={selectClass} value={form.decision} onChange={e=>setForm(current=>({...current,decision:e.target.value as ReviewForm['decision']}))}><option value="">Choose a decision</option><option value="approved">Approve reviewed corpus for the quality gate</option><option value="rejected">Reject corpus</option></select></Field>}<Check checked={form.attestation} onChange={value=>flag('attestation',value)}>I reviewed this exact immutable snapshot. My authenticated identity and decision will be retained. This records evidence review; code still decides data quality and suite admission.</Check><p className="text-sm text-muted">Recording a review does not send a message, authorize an honorarium, or approve any other snapshot. Incomplete or rejected evidence stays pending for the existing Workflow.</p>{error&&<p role="alert" className="text-sm text-danger">{error}</p>}<Btn type="submit" loading={busy} disabled={noIndependence||!form.independent||!form.attestation||(detail.kind==='contribution'&&(!form.qualifications||!form.consent))}>Record {detail.kind==='contribution'?'contribution review':'corpus decision'}</Btn></Section>
+ </fieldset></form>;
+}
+
+export function ExpertReviewQueue() {
+ const [items,setItems]=useState<ExpertReviewItem[]>([]),[truncated,setTruncated]=useState(false),[loading,setLoading]=useState(true),[error,setError]=useState(''),[detail,setDetail]=useState<ExpertReviewDetail|null>(null),[detailLoading,setDetailLoading]=useState(false),[busy,setBusy]=useState(false),[message,setMessage]=useState('');
+ const version=useRef(0);
+ const [cursor,setCursor]=useState(''),[nextCursor,setNextCursor]=useState<string|null>(null);
+ function failed(e:unknown){if(e instanceof ApiError&&(e.status===401||e.status===403)){version.current++;setDetail(null);setItems([]);setDetailLoading(false);setNextCursor(null);setCursor('');}setError(errMsg(e));}
+ async function reload(after=cursor){setLoading(true);setError('');try{const queue=await api<{items:ExpertReviewItem[];truncated:boolean;nextCursor?:string|null}>('/api/operator/expert-reviews'+(after?'?cursor='+encodeURIComponent(after):''),{cache:'no-store'});setItems(queue.items);setTruncated(queue.truncated);setCursor(after);setNextCursor(queue.nextCursor??null);}catch(e){failed(e);}finally{setLoading(false);}}
+ useEffect(()=>{void reload();return()=>{version.current++;};},[]);
+ async function select(item:ExpertReviewItem){const request=++version.current;setDetail(null);setMessage('');setError('');setDetailLoading(true);try{const next=await api<ExpertReviewDetail>(expertReviewPath(item),{cache:'no-store'});if(request===version.current)setDetail(next);}catch(e){if(request===version.current)failed(e);}finally{if(request===version.current)setDetailLoading(false);}}
+ async function submit(value:ReturnType<typeof buildExpertReviewSubmission>){if(!detail)return;setBusy(true);setMessage('');setError('');try{await api(expertReviewPath(detail),{method:'POST',json:value,cache:'no-store'});setDetail(null);setMessage('Review recorded for the exact snapshot. The existing Workflow will recheck quality on its next poll.');await reload();}catch(e){if(e instanceof ApiError&&(e.status===401||e.status===403||e.status===409)){setDetail(null);version.current++;}failed(e);throw e;}finally{setBusy(false);}}
+ return <div className="space-y-8"><header className="space-y-3"><Link href="/operator" className="text-sm text-accent underline underline-offset-4">Operator console</Link><h1 className="t-h1">Evidence review</h1><p className="max-w-2xl text-base leading-relaxed text-muted">Independently review private expert contributions and candidate corpora before they can inform an evaluation. No decision is preselected.</p></header>{message&&<p role="status" className="text-sm text-fg-2">{message}</p>}{error&&<ErrorBox message={error} onRetry={()=>void reload()}/>}
