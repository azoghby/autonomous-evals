+import { randomUUID, createHash } from 'node:crypto';
+import type { AgentSqlExecutor } from '@ae/core/agents/postgres-ports';
+export type SourcingTx = AgentSqlExecutor;
+export const SHARING_ENVELOPE_VERSION = 'expert_sharing.v1';
+export const CONSENT_VERSION = 'expert_sharing_consent.v1';
+export const SHARING_DISCLOSURE = 'I agree to share bounded system-prompt context and proposed factual questions and rubrics with paid domain experts for evaluation. Credentials, raw traces, unrelated customer records and external attachments are excluded. I can revoke future sharing; already started deliveries and incurred obligations cannot be recalled.';
+export const DISCLOSURE_TEXT_DIGEST = createHash('sha256').update(SHARING_DISCLOSURE).digest('hex');
+export const policyLockIdentity = (policyId:string) => `expert-sourcing:policy:${policyId}`;
+export const jobLockIdentity = (jobId:string) => `expert-sourcing:job:${jobId}`;
+export type AuthenticateOperator = (tx:SourcingTx)=>Promise<{operatorId:string}>;
+export type AuthenticateCustomer = (tx:SourcingTx)=>Promise<{customerId:string}>;
+export type ValidateSourcingJob = (tx:SourcingTx,jobId:string)=>Promise<{tenantId:string;environment:'test'|'live';canonicalInputDigest:string}>;
+export interface SourcingPolicyInput { tenantId:string; environment:'test'|'live'; topic:string; capsPolicyId:string; maxRequirements:number; maxContextChars:number; grantLifetimeSeconds:number; expiresAt:string }
+const fail=():never=>{throw Error('expert_sourcing_unauthorized_or_invalid');};
+function topic(value:string){if(typeof value!=='string'||value!==value.trim()||value.length<1||value.length>160)fail();return value;}
+function expiry(value:string){if(!Number.isFinite(Date.parse(value))||Date.parse(value)<=Date.now())fail();return value;}
+function reason(value:string){if(typeof value!=='string'||!value.trim()||value.length>500)fail();return value;}
+async function owner(tx:SourcingTx,jobId:string,auth:AuthenticateCustomer,validate:ValidateSourcingJob){const actor=await auth(tx);if(!actor?.customerId)fail(); const row=(await tx.query<{customer_id:string;environment:string}>('SELECT customer_id::text,environment FROM jobs WHERE id=$1 FOR UPDATE',[jobId])).rows[0];if(!row||row.customer_id!==actor.customerId)fail();const canonical=await validate(tx,jobId);if(canonical.tenantId!==actor.customerId||canonical.environment!==row.environment||!/^[a-f0-9]{64}$/.test(canonical.canonicalInputDigest))fail();return {actor,canonical};}
+/** Caller owns READ COMMITTED transaction and policy→job session mutexes before entry.
+ * Fresh authentication and canonical job callbacks execute inside that transaction.
+ * Never supply callbacks from request bodies. Store makes no provider calls. */
+export async function issueSourcingPolicy(tx:SourcingTx,input:SourcingPolicyInput,auth:AuthenticateOperator){const actor=await auth(tx);if(!actor?.operatorId)fail();topic(input.topic);expiry(input.expiresAt);const existing=(await tx.query<Record<string,unknown>>('SELECT * FROM expert_sourcing.policies WHERE tenant_id=$1 AND environment=$2 AND topic=$3 ORDER BY issued_at DESC LIMIT 1 FOR UPDATE',[input.tenantId,input.environment,input.topic])).rows[0];const cap=(await tx.query<{enabled:boolean;job_cap_micro_usd:string;daily_cap_micro_usd:string}>('SELECT enabled,job_cap_micro_usd::text,daily_cap_micro_usd::text FROM expert_automation_policies WHERE id=$1 FOR UPDATE',[input.capsPolicyId])).rows[0];if(!cap?.enabled||cap.job_cap_micro_usd!=='25000000'||cap.daily_cap_micro_usd!=='50000000')fail();if(existing&&!existing.revoked_at){if(new Date(String(existing.expires_at)).getTime()<=Date.now()||existing.caps_policy_id!==input.capsPolicyId||existing.max_requirements!==input.maxRequirements||existing.max_context_chars!==input.maxContextChars||existing.grant_lifetime_seconds!==input.grantLifetimeSeconds||new Date(String(existing.expires_at)).getTime()!==Date.parse(input.expiresAt))fail();return {id:String(existing.id)};}const id=randomUUID();await tx.query(`INSERT INTO expert_sourcing.policies(id,tenant_id,environment,topic,caps_policy_id,policy_version,derivation_version,execution_profile,sharing_envelope_version,max_requirements,max_context_chars,grant_lifetime_seconds,issued_by_operator,expires_at) VALUES($1,$2,$3,$4,$5,'expert_sourcing_policy.v1','factual_gap_exact_scope.v1','generic-text-factual-gap-v1',$6,$7,$8,$9,$10,$11)`,[id,input.tenantId,input.environment,input.topic,input.capsPolicyId,SHARING_ENVELOPE_VERSION,input.maxRequirements,input.maxContextChars,input.grantLifetimeSeconds,actor.operatorId,input.expiresAt]);return {id};}
+export async function issueSourcingConsent(tx:SourcingTx,input:{jobId:string;topic:string;canonicalInputDigest:string;accepted:true;expiresAt:string},auth:AuthenticateCustomer,validate:ValidateSourcingJob){const {actor,canonical}=await owner(tx,input.jobId,auth,validate);if(input.accepted!==true||input.canonicalInputDigest!==canonical.canonicalInputDigest)fail();topic(input.topic);expiry(input.expiresAt);const policy=(await tx.query<{id:string}>(`SELECT id FROM expert_sourcing.policies WHERE tenant_id=$1 AND environment=$2 AND topic=$3 AND revoked_at IS NULL AND expires_at>now() FOR UPDATE`,[actor.customerId,canonical.environment,input.topic])).rows;if(policy.length!==1)fail();const existing=(await tx.query<Record<string,unknown>>('SELECT * FROM expert_sourcing.consents WHERE job_id=$1 ORDER BY issued_at DESC LIMIT 1 FOR UPDATE',[input.jobId])).rows[0];if(existing){if(existing.revoked_at||existing.topic!==input.topic||existing.canonical_input_digest!==canonical.canonicalInputDigest||existing.consent_version!==CONSENT_VERSION||existing.disclosure_text_digest!==DISCLOSURE_TEXT_DIGEST||new Date(String(existing.expires_at)).getTime()!==Date.parse(input.expiresAt))fail();return {id:String(existing.id)};}const id=randomUUID();await tx.query(`INSERT INTO expert_sourcing.consents(id,tenant_id,job_id,authenticated_customer_id,topic,canonical_input_digest,consent_version,disclosure_text_digest,sharing_envelope_version,expires_at) VALUES($1,$2,$3,$2,$4,$5,$6,$7,$8,$9)`,[id,actor.customerId,input.jobId,input.topic,canonical.canonicalInputDigest,CONSENT_VERSION,DISCLOSURE_TEXT_DIGEST,SHARING_ENVELOPE_VERSION,input.expiresAt]);return {id};}
+export async function revokeSourcingPolicy(tx:SourcingTx,input:{policyId:string;reason:string},auth:AuthenticateOperator){const actor=await auth(tx);if(!actor?.operatorId)fail();const rows=(await tx.query(`UPDATE expert_sourcing.policies SET revoked_at=now(),revoked_by=$2,revocation_reason=$3 WHERE id=$1 AND revoked_at IS NULL RETURNING id`,[input.policyId,actor.operatorId,reason(input.reason)])).rows;return {revoked:rows.length===1};}
+export async function revokeSourcingConsent(tx:SourcingTx,input:{jobId:string;consentId:string;reason:string},auth:AuthenticateCustomer,validate:ValidateSourcingJob){const {actor}=await owner(tx,input.jobId,auth,validate);const rows=(await tx.query(`UPDATE expert_sourcing.consents SET revoked_at=now(),revoked_by=$3,revocation_reason=$4 WHERE id=$1 AND job_id=$2 AND tenant_id=$3 AND revoked_at IS NULL RETURNING id`,[input.consentId,input.jobId,actor.customerId,reason(input.reason)])).rows;return {revoked:rows.length===1};}
+export async function listSourcingConsents(tx:SourcingTx,jobId:string,auth:AuthenticateCustomer,validate:ValidateSourcingJob){const {actor}=await owner(tx,jobId,auth,validate);return (await tx.query(`SELECT id,topic,consent_version,disclosure_text_digest,sharing_envelope_version,canonical_input_digest,issued_at,expires_at,revoked_at FROM expert_sourcing.consents WHERE job_id=$1 AND tenant_id=$2 ORDER BY issued_at,id LIMIT 100`,[jobId,actor.customerId])).rows;}
+export async function listSourcingPolicies(tx:SourcingTx,input:{tenantId:string;environment:'test'|'live'},auth:AuthenticateCustomer){const actor=await auth(tx);if(actor?.customerId!==input.tenantId)fail();return(await tx.query(`SELECT id,topic,max_requirements,max_context_chars,expires_at FROM expert_sourcing.policies WHERE tenant_id=$1 AND environment=$2 AND revoked_at IS NULL AND expires_at>now() ORDER BY topic LIMIT 100`,[input.tenantId,input.environment])).rows;}
