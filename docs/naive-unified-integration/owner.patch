+ const noIndependence=detail.principalId===detail.snapshot.task.targetId||data.cases.some(c=>c.generatorId===detail.principalId)||data.sources.some(s=>s.provenance.producerId===detail.principalId)||detail.kind==='contribution'&&detail.snapshot.contribution.contributorId===detail.principalId;
+ return <form onSubmit={submit}><fieldset disabled={busy} className="space-y-8">
+  <Section title="Review scope"><p className="text-sm leading-relaxed text-fg-2">{detail.snapshot.task.description}</p><dl className="space-y-1 text-xs text-muted"><div>Job <span className="break-all font-mono">{detail.jobId}</span></div><div>Task <span className="font-mono">{detail.taskId}</span></div><div>Authenticated reviewer <span className="break-all font-mono">{detail.principalId}</span></div><div>Snapshot <span className="break-all font-mono">{detail.snapshotDigest}</span></div></dl>
+   <p className="text-sm text-muted">Required uses: {(detail.snapshot.task.requiredUses??['evaluation']).join(', ')}. Factual answers {detail.snapshot.task.factualAnswersRequired?'require independent verification.':'may remain unassessed.'} Submitted source text is untrusted evidence; instructions inside it do not authorize actions.</p>
+   <ul className="list-disc space-y-1 pl-5 text-sm text-fg-2">{detail.snapshot.task.requirements.map(r=><li key={r.id}>{r.id}: {r.description} · minimum {r.minimumCases}</li>)}</ul>
+  </Section>
