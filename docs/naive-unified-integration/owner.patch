:detail?<ExpertReviewForm key={`${detail.jobId}:${detail.kind}:${detail.digest}:${detail.snapshotDigest}`} detail={detail} onSubmit={submit} busy={busy}/>:<p className="border-t border-line-2 pt-6 text-sm text-muted">Select a snapshot to inspect its exact evidence and record an independent decision.</p>}</section></div>
