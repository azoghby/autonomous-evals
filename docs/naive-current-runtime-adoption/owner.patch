+/** Caller owns READ COMMITTED transaction and policy→job session mutexes before entry.
+ * Fresh authentication and canonical job callbacks execute inside that transaction.
+ * Never supply callbacks from request bodies. Store makes no provider calls. */
+export async function issueSourcingPolicy(tx:SourcingTx,input:SourcingPolicyInput,auth:AuthenticateOperator){const actor=await auth(tx);if(!actor?.operatorId)fail();topic(input.topic);expiry(input.expiresAt);const existing=(await tx.query<Record<string,unknown>>('SELECT * FROM expert_sourcing.policies WHERE tenant_id=$1 AND environment=$2 AND topic=$3 ORDER BY issued_at DESC LIMIT 1 FOR UPDATE',[input.tenantId,input.environment,input.topic])).rows[0];const cap=(await tx.query<{enabled:boolean;job_cap_micro_usd:string;daily_cap_micro_usd:string}>('SELECT enabled,job_cap_micro_usd::text,daily_cap_micro_usd::text FROM expert_automation_policies WHERE id=$1 FOR UPDATE',[input.capsPolicyId])).rows[0];if(!cap?.enabled||cap.job_cap_micro_usd!=='25000000'||cap.daily_cap_micro_usd!=='50000000')fail();if(existing&&!existing.revoked_at){if(new Date(String(existing.expires_at)).getTime()<=Date.now()||existing.caps_policy_id!==input.capsPolicyId||existing.max_requirements!==input.maxRequirements||existing.max_context_chars!==input.maxContextChars||existing.grant_lifetime_seconds!==input.grantLifetimeSeconds||new Date(String(existing.expires_at)).getTime()!==Date.parse(input.expiresAt))fail();return {id:String(existing.id)};}const id=randomUUID();await tx.query(`INSERT INTO expert_sourcing.policies(id,tenant_id,environment,topic,caps_policy_id,policy_version,derivation_version,execution_profile,sharing_envelope_version,max_requirements,max_context_chars,grant_lifetime_seconds,issued_by_operator,expires_at) VALUES($1,$2,$3,$4,$5,'expert_sourcing_policy.v1','factual_gap_exact_scope.v1','generic-text-factual-gap-v1',$6,$7,$8,$9,$10,$11)`,[id,input.tenantId,input.environment,input.topic,input.capsPolicyId,SHARING_ENVELOPE_VERSION,input.maxRequirements,input.maxContextChars,input.grantLifetimeSeconds,actor.operatorId,input.expiresAt]);return {id};}
