+import {afterEach,expect,it} from 'vitest';
+import {issueSourcingPolicy,issueSourcingConsent,revokeSourcingConsent,revokeSourcingPolicy,DISCLOSURE_TEXT_DIGEST,type SourcingTx} from './expert-sourcing-store';
+const tenant='11111111-1111-4111-8111-111111111111',foreign='22222222-2222-4222-8222-222222222222',job='33333333-3333-4333-8333-333333333333',digest='a'.repeat(64);
+const dbs:PGlite[]=[];afterEach(async()=>{for(const db of dbs.splice(0))await db.close();});
+async function fixture(){const pg=new PGlite();dbs.push(pg);await pg.exec(`CREATE TABLE customers(id uuid PRIMARY KEY);CREATE TABLE jobs(id uuid PRIMARY KEY,customer_id uuid,environment text);CREATE TABLE expert_automation_policies(id text PRIMARY KEY,enabled boolean,job_cap_micro_usd bigint,daily_cap_micro_usd bigint);CREATE TABLE expert_automation_scopes(job_id uuid,task_id text);INSERT INTO customers VALUES('${tenant}'),('${foreign}');INSERT INTO jobs VALUES('${job}','${tenant}','test');INSERT INTO expert_automation_policies VALUES('caps',true,25000000,50000000);`);await pg.exec(readFileSync('docs/naive-sourcing-authority-integration/sql/001-expert-sourcing-authority.sql','utf8'));const tx:SourcingTx={query:(q,p)=>pg.query(q,p)};const auth=async()=>({customerId:tenant});const operator=async()=>({operatorId:'operator@example.test'});const validate=async()=>({tenantId:tenant,environment:'test' as const,canonicalInputDigest:digest});const policy={tenantId:tenant,environment:'test' as const,topic:'Medicine',capsPolicyId:'caps',maxRequirements:36,maxContextChars:16000,grantLifetimeSeconds:3600,expiresAt:'2099-01-01T00:00:00Z'};const consent={jobId:job,topic:'Medicine',canonicalInputDigest:digest,accepted:true as const,expiresAt:'2099-01-01T00:00:00Z'};return {pg,tx,auth,operator,validate,policy,consent};}
+it('retains authenticated immutable policy and explicit disclosure consent; monotonic revoke',async()=>{const f=await fixture();const p=await issueSourcingPolicy(f.tx,f.policy,f.operator);const c=await issueSourcingConsent(f.tx,f.consent,f.auth,f.validate);expect(await issueSourcingConsent(f.tx,f.consent,f.auth,f.validate)).toEqual(c);const row=(await f.pg.query<{disclosure_text_digest:string;authenticated_customer_id:string}>('SELECT * FROM expert_sourcing.consents')).rows[0];expect(row.disclosure_text_digest).toBe(DISCLOSURE_TEXT_DIGEST);expect(row.authenticated_customer_id).toBe(tenant);await expect(f.pg.query('UPDATE expert_sourcing.policies SET max_requirements=35 WHERE id=$1',[p.id])).rejects.toThrow('immutable');expect(await revokeSourcingConsent(f.tx,{jobId:job,consentId:c.id,reason:'withdrawn'},f.auth,f.validate)).toEqual({revoked:true});expect(await revokeSourcingConsent(f.tx,{jobId:job,consentId:c.id,reason:'retry'},f.auth,f.validate)).toEqual({revoked:false});await expect(f.pg.query('UPDATE expert_sourcing.consents SET revoked_at=NULL,revoked_by=NULL,revocation_reason=NULL WHERE id=$1',[c.id])).rejects.toThrow();await expect(f.pg.query('DELETE FROM expert_sourcing.consents WHERE id=$1',[c.id])).rejects.toThrow();});
+it('rejects foreign owner, forged digest, false acceptance, absent fresh operator and overbounds',async()=>{const f=await fixture();await issueSourcingPolicy(f.tx,f.policy,f.operator);await expect(issueSourcingConsent(f.tx,f.consent,async()=>({customerId:foreign}),f.validate)).rejects.toThrow();await expect(issueSourcingConsent(f.tx,{...f.consent,canonicalInputDigest:'b'.repeat(64)},f.auth,f.validate)).rejects.toThrow();await expect(issueSourcingConsent(f.tx,{...f.consent,accepted:false as true},f.auth,f.validate)).rejects.toThrow();await expect(issueSourcingPolicy(f.tx,f.policy,async()=>({operatorId:''}))).rejects.toThrow();await expect(issueSourcingPolicy(f.tx,{...f.policy,topic:'Other',maxRequirements:37},f.operator)).rejects.toThrow();await expect(issueSourcingPolicy(f.tx,{...f.policy,topic:'Other',maxContextChars:16001},f.operator)).rejects.toThrow();});
