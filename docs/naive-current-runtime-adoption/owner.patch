+export async function revokeSourcingConsent(tx:SourcingTx,input:{jobId:string;consentId:string;reason:string},auth:AuthenticateCustomer,validate:ValidateSourcingJob){const {actor}=await owner(tx,input.jobId,auth,validate);const rows=(await tx.query(`UPDATE expert_sourcing.consents SET revoked_at=now(),revoked_by=$3,revocation_reason=$4 WHERE id=$1 AND job_id=$2 AND tenant_id=$3 AND revoked_at IS NULL RETURNING id`,[input.consentId,input.jobId,actor.customerId,reason(input.reason)])).rows;return {revoked:rows.length===1};}
+export async function listSourcingConsents(tx:SourcingTx,jobId:string,auth:AuthenticateCustomer,validate:ValidateSourcingJob){const {actor}=await owner(tx,jobId,auth,validate);return (await tx.query(`SELECT id,topic,consent_version,disclosure_text_digest,sharing_envelope_version,canonical_input_digest,issued_at,expires_at,revoked_at FROM expert_sourcing.consents WHERE job_id=$1 AND tenant_id=$2 ORDER BY issued_at,id LIMIT 100`,[jobId,actor.customerId])).rows;}
+export async function listSourcingPolicies(tx:SourcingTx,input:{tenantId:string;environment:'test'|'live'},auth:AuthenticateCustomer){const actor=await auth(tx);if(actor?.customerId!==input.tenantId)fail();return(await tx.query(`SELECT id,topic,max_requirements,max_context_chars,expires_at FROM expert_sourcing.policies WHERE tenant_id=$1 AND environment=$2 AND revoked_at IS NULL AND expires_at>now() ORDER BY topic LIMIT 100`,[input.tenantId,input.environment])).rows;}
