+import 'server-only';
+import { createHash } from 'node:crypto';
+import { FatalError } from 'workflow';
+import { IntakeInput, type IntakeInput as Intake } from '@ae/core/contracts/index';
+import { textDesignTaskScope } from '@ae/core/evals/text/design';
