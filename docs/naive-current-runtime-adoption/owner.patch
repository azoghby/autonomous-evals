+  if (!job || job.customer_id !== claims.customerId || job.environment !== claims.environment || bearer.role !== 'copilot' || bearer.id !== claims.credentialId || bearer.agentId !== pin.agentId || bearer.agentVersion !== pin.agentVersion) fail();
