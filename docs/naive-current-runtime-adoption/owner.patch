+export const SHARING_DISCLOSURE = 'I agree to share bounded system-prompt context and proposed factual questions and rubrics with paid domain experts for evaluation. Credentials, raw traces, unrelated customer records and external attachments are excluded. I can revoke future sharing; already started deliveries and incurred obligations cannot be recalled.';
+export const DISCLOSURE_TEXT_DIGEST = createHash('sha256').update(SHARING_DISCLOSURE).digest('hex');
+export const policyLockIdentity = (policyId:string) => `expert-sourcing:policy:${policyId}`;
+export const jobLockIdentity = (jobId:string) => `expert-sourcing:job:${jobId}`;
+export type AuthenticateOperator = (tx:SourcingTx)=>Promise<{operatorId:string}>;
+export type AuthenticateCustomer = (tx:SourcingTx)=>Promise<{customerId:string}>;
+export type ValidateSourcingJob = (tx:SourcingTx,jobId:string)=>Promise<{tenantId:string;environment:'test'|'live';canonicalInputDigest:string}>;
+export interface SourcingPolicyInput { tenantId:string; environment:'test'|'live'; topic:string; capsPolicyId:string; maxRequirements:number; maxContextChars:number; grantLifetimeSeconds:number; expiresAt:string }
