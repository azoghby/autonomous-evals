+  it("passes server identity and a fresh callback to atomic consent storage", async () => {
+    const f = fixture();
+    expect((await f.api.customerPost(req(consent), id)).status).toBe(200);
+    const input = vi.mocked(f.deps.issueConsent).mock.calls[0][0];
