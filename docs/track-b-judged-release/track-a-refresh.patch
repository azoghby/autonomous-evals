+export const TrajectoryAssertion = z.discriminatedUnion("type", [
+  z.object({ id: z.string().max(40), type: z.literal("called"), tool: z.string(), description: z.string().max(500), severity: z.enum(["critical", "high", "medium", "low"]) }),
