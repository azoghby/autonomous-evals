diff --git a/apps/web/src/server/public-agent-cron.test.ts b/apps/web/src/server/public-agent-cron.test.ts
new file mode 100644
index 0000000..e9cc1ae
--- /dev/null
+++ b/apps/web/src/server/public-agent-cron.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, it } from "vitest";
+import { budgetAllows, pickNextAgent, readConfig, FAILURE_COOLDOWN_MS, type CandidateAgent } from "./public-agent-cron";
+
+const H = 3_600_000;
+const now = new Date("2026-11-07T12:00:00Z");
+const ago = (h: number) => new Date(now.getTime() - h * H);
+const agent = (slug: string, over: Partial<CandidateAgent> = {}): CandidateAgent => ({
+  slug, name: slug, active: true, termsUrl: "https://example.com/terms", authorizedNote: "We operate it.", authEnvVar: "AI_GATEWAY_API_KEY", ...over,
+});
+const sched = (ran: Record<string, Date>, failed: Record<string, Date> = {}) => ({ lastRanAt: new Map(Object.entries(ran)), lastFailedAt: new Map(Object.entries(failed)) });
+
+describe("pickNextAgent", () => {
+  it("prefers a never-run agent over any run one", () => {
+    expect(pickNextAgent([agent("a"), agent("b")], sched({ a: ago(100) }), now, 24 * H)?.slug).toBe("b");
+  });
+  it("picks the oldest latest-run first", () => {
+    expect(pickNextAgent([agent("a"), agent("b"), agent("c")], sched({ a: ago(30), b: ago(90), c: ago(50) }), now, 24 * H)?.slug).toBe("b");
+  });
+  it("returns null when nothing is older than the interval", () => {
+    expect(pickNextAgent([agent("a")], sched({ a: ago(23) }), now, 24 * H)).toBeNull();
+    expect(pickNextAgent([agent("a")], sched({ a: ago(24) }), now, 24 * H)?.slug).toBe("a");
+  });
+  it("skips inactive and unauthorized agents", () => {
+    const list = [agent("off", { active: false }), agent("noterms", { termsUrl: null }), agent("nonote", { authorizedNote: " " }), agent("ok")];
+    expect(pickNextAgent(list, sched({ ok: ago(48) }), now, 24 * H)?.slug).toBe("ok");
+    expect(pickNextAgent(list.slice(0, 3), sched({}), now, 24 * H)).toBeNull();
+  });
+  it("cools down an agent whose last attempt failed so it cannot starve the others", () => {
+    const failed = { a: new Date(now.getTime() - FAILURE_COOLDOWN_MS / 2) };
+    expect(pickNextAgent([agent("a"), agent("b")], sched({ b: ago(48) }, failed), now, 24 * H)?.slug).toBe("b");
+    expect(pickNextAgent([agent("a")], sched({}, failed), now, 24 * H)).toBeNull();
+  });
+});
+
+describe("owner-autopilot fields", () => {
+  it("excludes non-active status and unverified owner-submitted agents; tolerates absent fields", () => {
+    const list = [
+      agent("paused", { status: "paused" }), agent("pending", { status: "pending_verification" }), agent("optout", { status: "opted_out" }),
+      agent("unverified", { status: "active", ownerEmail: "a@b.co", verifiedAt: null }),
+    ];
+    expect(pickNextAgent(list, sched({}), now, 24 * H)).toBeNull();
+    const ok = [...list, agent("owned", { status: "active", ownerEmail: "a@b.co", verifiedAt: ago(5) }), agent("legacy")];
+    expect(pickNextAgent(ok, sched({ legacy: ago(10) }), now, 24 * H)?.slug).toBe("owned");
+  });
+});
+
+describe("budget and config", () => {
+  it("stops once today's spend reaches the cap", () => {
+    expect(budgetAllows(2_999_999, 3_000_000)).toBe(true);
+    expect(budgetAllows(3_000_000, 3_000_000)).toBe(false);
+    expect(budgetAllows(5_000_000, 3_000_000)).toBe(false);
+  });
+  it("reads env with defaults", () => {
+    expect(readConfig({})).toEqual({ minIntervalMs: 24 * H, dailyBudgetMicroUsd: 3_000_000 });
+    expect(readConfig({ PUBLIC_AGENT_RERUN_HOURS: "6", PUBLIC_AGENT_DAILY_BUDGET_USD: "0.5" })).toEqual({ minIntervalMs: 6 * H, dailyBudgetMicroUsd: 500_000 });
+    expect(readConfig({ PUBLIC_AGENT_RERUN_HOURS: "x", PUBLIC_AGENT_DAILY_BUDGET_USD: "" }).dailyBudgetMicroUsd).toBe(3_000_000);
+  });
+});
diff --git a/apps/web/src/server/public-agent-cron.ts b/apps/web/src/server/public-agent-cron.ts
new file mode 100644
index 0000000..2986810
--- /dev/null
+++ b/apps/web/src/server/public-agent-cron.ts
@@ -0,0 +1,145 @@
+/**
+ * Scheduling for the public-agent leaderboard cron: pick the ONE agent that is most overdue, honour the daily budget,
+ * and serialise ticks with a Postgres advisory lock. Pure selection helpers are exported for tests.
+ * No schema changes: runs live in public_agent_runs, failed attempts are logged as zero-run `costs` rows (jobId null).
+ */
+import { and, eq, gte, sql } from "drizzle-orm";
+import { db, schema } from "@ae/core/db/client";
+import { PublicAgentInput, assertAuthorizedToTest } from "./leaderboard-agents";
+import { SUITE_VERSION } from "./leaderboard";
+import { loadStandardSuite, runPublicAgent, type RunOutcome } from "./public-agent-runner";
+
+export const DEFAULT_RERUN_HOURS = 24;
+export const DEFAULT_DAILY_BUDGET_USD = 3;
+/** Per-run budget cap (micro-USD); a standard run costs well under $0.10. */
+export const PER_RUN_BUDGET_MICRO_USD = 500_000;
+/** Leave headroom under maxDuration = 300 so the function can record the failure and return. */
+export const RUN_TIMEOUT_MIN = 4.5;
+/** After a failed attempt, leave that agent alone this long so one broken agent cannot starve the rest. */
+export const FAILURE_COOLDOWN_MS = 60 * 60 * 1000;
+export const FAILURE_COST_SOURCE = "public_agent_cron_failure";
+/** Arbitrary constant key ("pubagent" as an int8) for pg_try_advisory_lock. */
+export const ADVISORY_LOCK_KEY = 0x7075626167656e74n;
+
+export interface CandidateAgent {
+  slug: string; name: string; active: boolean; termsUrl?: string | null; authorizedNote?: string | null; authEnvVar?: string | null;
+  /** Optional owner-autopilot fields; absent on rows from a DB that has not been migrated yet. */
+  status?: string | null; ownerEmail?: string | null; verifiedAt?: Date | string | null;
+}
+export interface Schedule { lastRanAt: ReadonlyMap<string, Date>; lastFailedAt?: ReadonlyMap<string, Date> }
+
+export function readConfig(env: Record<string, string | undefined> = process.env) {
+  const hours = Number(env.PUBLIC_AGENT_RERUN_HOURS);
+  const usd = Number(env.PUBLIC_AGENT_DAILY_BUDGET_USD);
+  return {
+    minIntervalMs: (Number.isFinite(hours) && hours > 0 ? hours : DEFAULT_RERUN_HOURS) * 3_600_000,
+    dailyBudgetMicroUsd: Math.round((env.PUBLIC_AGENT_DAILY_BUDGET_USD?.trim() && Number.isFinite(usd) && usd >= 0 ? usd : DEFAULT_DAILY_BUDGET_USD) * 1_000_000),
+  };
+}
+
+function isAuthorized(a: CandidateAgent): boolean {
+  if (a.status != null && a.status !== "active") return false; // paused / pending_verification / opted_out
+  if (a.ownerEmail && !a.verifiedAt) return false; // owner-submitted agents must be verified
+  try { assertAuthorizedToTest(a); return true; } catch { return false; }
+}
+
+/** The single agent to run now: active + authorized, due (never run, or last run older than the interval), not in failure cooldown; oldest first. */
+export function pickNextAgent<T extends CandidateAgent>(agents: readonly T[], schedule: Schedule, now: Date, minIntervalMs: number): T | null {
+  const due = agents
+    .filter((a) => a.active && isAuthorized(a))
+    .filter((a) => {
+      const ran = schedule.lastRanAt.get(a.slug);
+      const failed = schedule.lastFailedAt?.get(a.slug);
+      if (failed && now.getTime() - failed.getTime() < FAILURE_COOLDOWN_MS) return false;
+      return !ran || now.getTime() - ran.getTime() >= minIntervalMs;
+    });
+  due.sort((x, y) => (schedule.lastRanAt.get(x.slug)?.getTime() ?? -Infinity) - (schedule.lastRanAt.get(y.slug)?.getTime() ?? -Infinity) || x.slug.localeCompare(y.slug));
+  return due[0] ?? null;
+}
+
+/** True while today's spend is still under the cap (spend >= cap stops the run). */
+export const budgetAllows = (spentTodayMicroUsd: number, capMicroUsd: number): boolean => spentTodayMicroUsd < capMicroUsd;
+
+export const startOfUtcDay = (now: Date): Date => new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
+
+export type TickResult =
+  | { status: "ran"; outcome: RunOutcome }
+  | { status: "failed"; slug: string; error: string }
+  | { status: "skipped"; reason: "locked" | "budget" | "nothing_due" | "no_agents" };
+
+const p = schema.publicAgents;
+const baseCols = {
+  id: p.id, slug: p.slug, name: p.name, vendor: p.vendor, kind: p.kind, endpointUrl: p.endpointUrl, model: p.model, authEnvVar: p.authEnvVar,
+  systemPrompt: p.systemPrompt, homepage: p.homepage, termsUrl: p.termsUrl, authorizedNote: p.authorizedNote, active: p.active,
+};
+
+/** Explicit columns (never `select *`) so this works before and after the owner-autopilot migration. */
+async function loadAgents() {
+  try {
+    return await db().select({ ...baseCols, status: p.status, ownerEmail: p.ownerEmail, verifiedAt: p.verifiedAt }).from(p);
+  } catch {
+    return await db().select(baseCols).from(p);
+  }
+}
+
+async function loadSchedule(now: Date) {
+  const d = db();
+  const agents = await loadAgents();
+  const runs = await d.select({ slug: schema.publicAgents.slug, last: sql<Date>`max(${schema.publicAgentRuns.ranAt})` })
+    .from(schema.publicAgentRuns).innerJoin(schema.publicAgents, eq(schema.publicAgents.id, schema.publicAgentRuns.agentId))
+    .where(eq(schema.publicAgentRuns.suiteVersion, SUITE_VERSION)).groupBy(schema.publicAgents.slug);
+  const fails = await d.select({ slug: schema.costs.agent, last: sql<Date>`max(${schema.costs.createdAt})` })
+    .from(schema.costs).where(and(eq(schema.costs.source, FAILURE_COST_SOURCE), gte(schema.costs.createdAt, new Date(now.getTime() - FAILURE_COOLDOWN_MS)))).groupBy(schema.costs.agent);
+  const toMap = (rows: Array<{ slug: string | null; last: Date | string }>) =>
+    new Map(rows.filter((r) => r.slug).map((r) => [r.slug as string, new Date(r.last)]));
+  return { agents, schedule: { lastRanAt: toMap(runs), lastFailedAt: toMap(fails) } satisfies Schedule };
+}
+
+/** Public-agent spend since UTC midnight: stored runs plus the partial spend of failed attempts. */
+export async function spentTodayMicroUsd(now: Date): Promise<number> {
+  const since = startOfUtcDay(now);
+  const d = db();
+  const [r] = await d.select({ v: sql<string>`coalesce(sum(${schema.publicAgentRuns.costMicroUsd}), 0)` }).from(schema.publicAgentRuns).where(gte(schema.publicAgentRuns.ranAt, since));
+  const [f] = await d.select({ v: sql<string>`coalesce(sum(${schema.costs.microUsd}), 0)` }).from(schema.costs)
+    .where(and(eq(schema.costs.source, FAILURE_COST_SOURCE), gte(schema.costs.createdAt, since)));
+  return Number(r?.v ?? 0) + Number(f?.v ?? 0);
+}
+
+async function recordFailure(slug: string, microUsd: number, error: string): Promise<void> {
+  await db().insert(schema.costs).values({ jobId: null, source: FAILURE_COST_SOURCE, agent: slug, microUsd, meta: { error: error.slice(0, 300) } });
+}
+
+/** One cron tick. Holds a session advisory lock on a dedicated connection for the whole run, so overlapping ticks skip. */
+export async function runNextPublicAgent(now = new Date(), log: (l: string) => void = () => {}): Promise<TickResult> {
+  const { Pool } = await import("@neondatabase/serverless");
+  const pool = new Pool({ connectionString: process.env.DATABASE_URL, max: 1 });
+  const client = await pool.connect();
+  try {
+    const { rows } = await client.query("select pg_try_advisory_lock($1::bigint) as ok", [ADVISORY_LOCK_KEY.toString()]);
+    if (!rows[0]?.ok) return { status: "skipped", reason: "locked" };
+    try {
+      const cfg = readConfig();
+      const { agents, schedule } = await loadSchedule(now);
+      if (!agents.length) return { status: "skipped", reason: "no_agents" };
+      if (!budgetAllows(await spentTodayMicroUsd(now), cfg.dailyBudgetMicroUsd)) return { status: "skipped", reason: "budget" };
+      const next = pickNextAgent(agents, schedule, now, cfg.minIntervalMs);
+      if (!next) return { status: "skipped", reason: "nothing_due" };
+      try {
+        const outcome = await runPublicAgent(PublicAgentInput.parse(next), {
+          suite: loadStandardSuite(), agentId: next.id, budgetMicroUsd: PER_RUN_BUDGET_MICRO_USD, timeoutMin: RUN_TIMEOUT_MIN, log,
+        });
+        return { status: "ran", outcome };
+      } catch (e) {
+        const msg = e instanceof Error ? e.message : String(e);
+        const spent = (e as { spentMicroUsd?: number }).spentMicroUsd ?? 0;
+        await recordFailure(next.slug, spent, msg).catch(() => {});
+        return { status: "failed", slug: next.slug, error: msg };
+      }
+    } finally {
+      await client.query("select pg_advisory_unlock($1::bigint)", [ADVISORY_LOCK_KEY.toString()]).catch(() => {});
+    }
+  } finally {
+    client.release();
+    await pool.end().catch(() => {});
+  }
+}
diff --git a/apps/web/src/server/public-agent-runner.ts b/apps/web/src/server/public-agent-runner.ts
new file mode 100644
index 0000000..dbec75b
--- /dev/null
+++ b/apps/web/src/server/public-agent-runner.ts
@@ -0,0 +1,104 @@
+/**
+ * Reusable core of a public-agent leaderboard run. Shared by scripts/public-agents.ts and /api/cron/public-agents.
+ * No "server-only" import so the tsx script can use it. API keys are read from the env var NAMED on the agent row and never logged.
+ */
+import { randomUUID } from "node:crypto";
+import { Suite, type Finding } from "@ae/core/contracts/index";
+import type { EvalServices, ServiceContext } from "@ae/core/contracts/services";
+import { createLiteServices } from "@ae/core/lite/index";
+import { redTeamById } from "@ae/core/redteam/index";
+import { PublicAgentInput, assertAuthorizedToTest } from "./leaderboard-agents";
+import { SUITE_VERSION, scoreRun, toStoredFindings, percent, type StoredFinding } from "./leaderboard";
+import { buildStandardSuite } from "./leaderboard-suite";
+
+export const DEFAULT_BUDGET_MICRO_USD = 2_000_000;
+export const DEFAULT_TIMEOUT_MIN = 15;
+
+export class BudgetExceeded extends Error {
+  constructor(spent: number, cap: number) { super(`budget exceeded: ${spent} > ${cap} micro-USD`); }
+}
+
+/** The standard suite, built deterministically in code (no filesystem, so it works in serverless bundles). */
+export function loadStandardSuite(): Suite {
+  return buildStandardSuite();
+}
+
+/** Findings from failed scenarios: deterministic, no extra model spend. Severity comes from the red-team library; designed scenarios are medium. */
+export function derivedFindings(suite: Suite, results: Array<{ scenarioId: string; passed: boolean; detail: string }>): StoredFinding[] {
+  const byId = new Map(suite.scenarios.map((s) => [s.id, s]));
+  const failed = results.filter((r) => !r.passed);
+  return toStoredFindings(failed.map((r) => {
+    const sc = byId.get(r.scenarioId);
+    const rt = redTeamById(r.scenarioId);
+    return {
+      title: sc?.title ?? r.scenarioId, severity: rt?.severity ?? "medium", category: sc?.category ?? "other", scenarioId: r.scenarioId,
+      evidence: [{ excerpt: r.detail }],
+    };
+  }));
+}
+
+/** Key for the agent's target. AI Gateway accepts a Vercel OIDC token as bearer when no API key is set. */
+export function resolveApiKey(authEnvVar: string | null | undefined, env: Record<string, string | undefined> = process.env): string | undefined {
+  if (!authEnvVar) return undefined;
+  return env[authEnvVar] ?? (authEnvVar === "AI_GATEWAY_API_KEY" ? env.VERCEL_OIDC_TOKEN : undefined);
+}
+
+export interface RunOptions {
+  suite: Suite;
+  budgetMicroUsd?: number;
+  timeoutMin?: number;
+  dryRun?: boolean;
+  investigate?: boolean;
+  log?: (line: string) => void;
+  /** Existing public_agents.id: skips the upsert (cron path; avoids writing to public_agents). */
+  agentId?: string;
+  /** Test seam; defaults to the lite engine. */
+  services?: EvalServices;
+}
+
+export interface RunOutcome { slug: string; dryRun: boolean; passed?: number; total?: number; findings?: number; costMicroUsd?: number }
+
+export async function runPublicAgent(row: PublicAgentInput, opts: RunOptions): Promise<RunOutcome> {
+  const { suite } = opts;
+  const budget = opts.budgetMicroUsd ?? DEFAULT_BUDGET_MICRO_USD;
+  const timeoutMin = opts.timeoutMin ?? DEFAULT_TIMEOUT_MIN;
+  const log = opts.log ?? ((l: string) => console.log(l));
+  assertAuthorizedToTest(row);
+  const apiKey = resolveApiKey(row.authEnvVar);
+  const plan = `${row.slug}: ${row.model} @ ${row.endpointUrl} | ${suite.scenarios.length} scenarios | budget $${(budget / 1e6).toFixed(2)} | key ${row.authEnvVar ? (apiKey ? `from $${row.authEnvVar}` : `MISSING $${row.authEnvVar}`) : "none"}`;
+  if (opts.dryRun) { log(`[dry-run] ${plan}`); return { slug: row.slug, dryRun: true }; }
+  if (row.authEnvVar && !apiKey) throw new Error(`env var ${row.authEnvVar} is not set`);
+  log(`[run] ${plan}`);
+
+  const services = opts.services ?? createLiteServices();
+  const { upsertAgent, insertRun } = await import("./leaderboard-db");
+  const agent = opts.agentId ? { id: opts.agentId } : await upsertAgent(PublicAgentInput.parse(row));
+
+  let spent = 0;
+  const ctx: ServiceContext = {
+    jobId: randomUUID(), environment: "live", budgetMicroUsd: budget,
+    async recordCost(entry) { spent += entry.microUsd; if (spent > budget) throw new BudgetExceeded(spent, budget); },
+    async recordProgress(m, msg) { log(`  [${row.slug}] ${m}: ${msg.slice(0, 120)}`); },
+  };
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const timeout = new Promise<never>((_, rej) => { timer = setTimeout(() => rej(new Error(`timed out after ${timeoutMin} min`)), timeoutMin * 60_000); timer.unref?.(); });
+  try {
+    const target = { url: row.endpointUrl, model: row.model, ...(apiKey ? { apiKey } : {}), systemPrompt: row.systemPrompt ?? "" };
+    const run = await Promise.race([services.runSuite(ctx, suite, target), timeout]);
+    const score = scoreRun(suite.scenarios, run.results);
+    let findings = derivedFindings(suite, run.results);
+    if (opts.investigate) {
+      try {
+        const f: Finding[] = await Promise.race([services.investigate(ctx, suite, [run]), timeout]);
+        findings = toStoredFindings(f);
+      } catch (e) { log(`  investigate failed, using derived findings: ${(e as Error).message}`); }
+    }
+    await insertRun({ agentId: agent.id, suiteVersion: SUITE_VERSION, ...score, findings, costMicroUsd: spent });
+    log(`[done] ${row.slug}: ${score.passed}/${score.total} (${percent(score.passed / Math.max(1, score.total))}), ${findings.length} findings, $${(spent / 1e6).toFixed(3)}`);
+    return { slug: row.slug, dryRun: false, passed: score.passed, total: score.total, findings: findings.length, costMicroUsd: spent };
+  } catch (e) {
+    // Partial spend is lost with the thrown run; surface it so callers can account for it.
+    if (e instanceof Error) Object.assign(e, { spentMicroUsd: spent });
+    throw e;
+  } finally { if (timer) clearTimeout(timer); }
+}
