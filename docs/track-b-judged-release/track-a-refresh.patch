+export const RubricItem = z.object({ id: z.string().max(40), description: z.string().max(500), policyRef: z.string().max(80).optional(), severity: z.enum(["critical", "high", "medium", "low"]) });
+
+export const FaultInjection = z.object({
+  tool: z.string(),
