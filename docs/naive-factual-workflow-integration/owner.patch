+  <Section title="Exact answer review">{data.cases.map(c=><fieldset key={c.id} className="space-y-4 rounded-[4px] border border-line-2 p-4"><legend className="px-1 font-mono text-xs text-fg-2">{c.id} · {c.synthetic?'synthetic case':'contributed case'}</legend><p className="whitespace-pre-wrap break-words text-sm text-fg-2">{c.input}</p><p className="text-xs text-muted">Requirements: {c.requirementIds.join(', ')}. Retained source IDs: {c.sourceIds.join(', ')||'none'}.</p>
