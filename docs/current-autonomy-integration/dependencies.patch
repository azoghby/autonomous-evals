@@ -0,0 +1,22 @@
+import { CostEntry } from '@ae/core/contracts/index';
+import type { AgentTransactionalSql } from '@ae/core/agents/postgres-ports';
+
+/** Same transaction inserts the canonical cost and its dedup key; conflicts never overwrite facts. */
+export async function upsertWorkflowCost(sql: AgentTransactionalSql, raw: unknown): Promise<void> {
+  const e = CostEntry.parse(raw);
+  const key = e.meta?.idempotencyKey;
+  if (e.source === 'naive' && (typeof key !== 'string' || key !== `naive:${e.sessionId}`)) throw new Error('measured_cost_identity_required');
+  await sql.transaction(async tx => {
+    if (typeof key === 'string') {
+      const claimed = await tx.query<{ payload: unknown }>(`INSERT INTO workflow_integration.cost_keys(job_id,key,payload)
+        VALUES($1,$2,$3::jsonb) ON CONFLICT(key) DO NOTHING RETURNING payload`, [e.jobId, key, JSON.stringify(e)]);
+      if (!claimed.rows.length) {
+        const existing = await tx.query<{ agrees: boolean }>('SELECT payload=$3::jsonb AS agrees FROM workflow_integration.cost_keys WHERE job_id=$1 AND key=$2', [e.jobId,key,JSON.stringify(e)]);
+        if (existing.rows[0]?.agrees !== true) throw new Error('measured_cost_identity_conflict');
+        return;
+      }
+    }
+    await tx.query(`INSERT INTO costs(job_id,source,agent,session_id,micro_usd,meta) VALUES($1,$2,$3,$4,$5,$6::jsonb)`,
+      [e.jobId,e.source,e.agent??null,e.sessionId??null,e.microUsd,JSON.stringify(e.meta)]);
+  });
+}
diff --git a/apps/web/src/server/workflow-inventory.ts b/apps/web/src/server/workflow-inventory.ts
new file mode 100644
index 0000000..9e70779
--- /dev/null
+++ b/apps/web/src/server/workflow-inventory.ts
@@ -0,0 +1,67 @@
+import 'server-only';
+import { canonicalJson } from '@ae/core/evals/text/index';
+import { AsyncLocalStorage } from 'node:async_hooks';
+import type { AgentTransactionalSql } from '@ae/core/agents/postgres-ports';
+import type { CheckpointKey, TextCheckpointStore } from '@ae/core/evals/integration/checkpoints';
+import { publishStructuredInventory } from './structured-progress-inventory';
+import { inventoryPlanSchema, type InventoryPlan } from './structured-progress';
+
+type Scope = { tenantId: string; jobId: string; environment: 'test' | 'live' };
+type Associations = { runId: string; suiteDigest: string; scenarioIds: string[]; branchId?: string };
+/** Captures identities produced by the actual core factory, not guessed hashes.
+ * A separate instance belongs to one authenticated Workflow invocation. */
+export function createWorkflowInventory(db: AgentTransactionalSql, scope: Scope) {
+  const phase = new AsyncLocalStorage<Associations>();
+  async function publish(key?: CheckpointKey, acquisitionTaskIds: string[] = []) {
+    await db.transaction(async tx => {
+      // Serialize first publication as well as updates. No lock spans external I/O.
+      const job = (await tx.query<{ customer_id: string; environment: string }>(
+        'SELECT customer_id, environment FROM jobs WHERE id = $1 FOR UPDATE', [scope.jobId])).rows[0];
+      if (!job || job.customer_id !== scope.tenantId || job.environment !== scope.environment) throw new Error('workflow_inventory_scope');
+      const row = (await tx.query<{ revision: string | number; plan: unknown }>(
+        'SELECT revision, plan FROM structured_progress.inventory WHERE job_id = $1', [scope.jobId])).rows[0];
+      const plan: InventoryPlan = row ? inventoryPlanSchema.parse(row.plan) : { checkpoints: [], acquisitionTaskIds: [] };
+      for (const id of acquisitionTaskIds) if (!plan.acquisitionTaskIds.includes(id)) plan.acquisitionTaskIds.push(id);
+      const kinds = { design: 'text_design', run_identity: 'text_run', run_result: 'text_run', investigation: 'text_investigation', calendar_run: 'calendar_run', calendar_investigation: 'calendar_investigation' } as const;
+      const format = key ? kinds[key.kind as keyof typeof kinds] : undefined;
+      if (key && format) {
+        if (key.jobId !== scope.jobId) throw new Error('workflow_inventory_scope');
+        const associations = format === 'text_design' ? {} : phase.getStore();
+        if (!associations) throw new Error('workflow_inventory_associations_required');
+        // Core run_identity and run_result use the same digest. Planning the result
+        // when run_identity is first claimed precedes every target dispatch.
+        const entry = { key: { ...key, kind: key.kind === 'run_identity' ? 'run_result' : key.kind },
+          format, phase: format === 'text_design' ? 'planning' as const : format.endsWith('_run') ? 'running' as const : 'investigating' as const,
+          ...associations };
+        const old = plan.checkpoints.find(p => p.key.kind === entry.key.kind && p.key.id === entry.key.id);
+        if (old && canonicalJson(old) !== canonicalJson(entry)) throw new Error('workflow_inventory_identity_conflict');
+        if (!old) plan.checkpoints.push(entry);
+      }
+      // There may be no public checkpoint during calendar suite freeze. Do not
+      // manufacture a completed phase from that private internal checkpoint.
+      if (!plan.checkpoints.length && !plan.acquisitionTaskIds.length) return;
+      await publishStructuredInventory(tx, scope, row ? Number(row.revision) : null, plan);
+    });
+  }
+  return {
+    phase<T>(associations: Associations, action: () => Promise<T>): Promise<T> {
+      return phase.run(JSON.parse(JSON.stringify(associations)) as Associations, action);
+    },
+    touch: () => publish(),
+    acquisition: (taskIds: string[]) => publish(undefined, taskIds),
+    wrap(base: TextCheckpointStore): TextCheckpointStore {
+      const mutate = async <T>(key: CheckpointKey, action: () => Promise<T>): Promise<T> => {
+        await publish(key); // durable expected blocker BEFORE claim/dispatch
+        try { return await action(); }
+        finally { await publish(key); } // failed publication blocks continuation
+      };
+      return {
+        claim: key => mutate(key, () => base.claim(key)),
+        get: key => base.get(key),
+        complete: (key, token, value) => mutate(key, () => base.complete(key, token, value)),
+        release: (key, token) => mutate(key, () => base.release(key, token)),
+        markAmbiguous: (key, token) => mutate(key, () => base.markAmbiguous(key, token)),
+      };
+    },
+  };
+}
diff --git a/apps/web/src/server/workflow-pack-projection.ts b/apps/web/src/server/workflow-pack-projection.ts
new file mode 100644
index 0000000..c4969e5
--- /dev/null
+++ b/apps/web/src/server/workflow-pack-projection.ts
@@ -0,0 +1,118 @@
+import 'server-only';
+import { containsSecret } from '@ae/core/agents/redact';
+import { canonicalPackJson, packDigest, aggregatePackStatuses, expectedPackCheckIds,
+  type PackRunEvidence, type PackInventoryStatus } from '@ae/core/evals/packs/index';
+import { SuiteRunSchema } from '@ae/core/evals/text/schema';
+
+const same = (a: unknown, b: unknown) => canonicalPackJson(a) === canonicalPackJson(b);
+const states: PackInventoryStatus[] = ['pass', 'fail', 'concern', 'unknown', 'not_assessed', 'infrastructure_error', 'quarantined'];
+const refused = (): never => { throw new Error('workflow_pack_evidence_invalid'); };
+/** Input must come from the authorized core service.report(), never intake.
+ * Integrity checks here do not issue review authority or reinterpret historical specs. */
+export function projectWorkflowPack(evidence: PackRunEvidence) {
+  const e = evidence;
+  if (!e || e.schemaVersion !== 'appended_pack_run.v1' || !e.runId || !e.context?.jobId
+    || !e.manifest || !e.base || !e.pack) return refused();
+  const { digest, ...body } = e.manifest;
+  if (packDigest(body) !== digest || e.manifest.baseDigest !== e.base.digest
+    || e.context.authorizationId !== e.manifest.authorization.authorizationId
+    || e.context.targetConfigDigest !== e.manifest.authorization.targetConfigDigest
+    || !same([...e.context.sourceRuleIds].sort(), [...e.manifest.authorization.sourceRuleIds].sort())) return refused();
+  const ids = e.manifest.inventory.map(entry => entry.id);
+  if (!ids.length || ids.length > 20 || new Set(ids).size !== ids.length
+    || ids.some(id => !/^rt_[a-z0-9_]+$/.test(id)) || !same(ids, e.pack.expectedIds)
+    || e.base.expectedIds.length !== 12 || new Set(e.base.expectedIds).size !== 12
+    || e.base.expectedIds.some(id => id.startsWith('rt_'))) return refused();
+  if (new Set(e.pack.results.map(r => r.id)).size !== e.pack.results.length
+    || e.pack.results.some(r => !ids.includes(r.id))) return refused();
+  const cases = e.manifest.inventory.map(entry => {
+    const result = e.pack.results.find(r => r.id === entry.id);
+    const expected = expectedPackCheckIds(entry);
+    let status: PackInventoryStatus = 'unknown';
+    let reason = 'missing_or_invalid_evidence';
+    if (entry.state === 'quarantined') { status = 'quarantined'; reason = entry.reason ?? 'unsupported_pack_semantics'; }
+    else if (result?.specDigest === entry.specDigest) {
+      if (result.status === 'quarantined' && result.reason === 'runner_unsupported_semantics' && result.checks.length === 0) {
+        status = 'quarantined'; reason = result.reason;
+      } else if (expected.length > 0 && same(expected, result.checks.map(c => c.id))
+        && result.checks.every(c => states.includes(c.status) && c.status !== ('quarantined' as string))) {
+        status = aggregatePackStatuses(result.checks.map(c => c.status)); reason = '';
+      } else if (result.status === 'unknown' || result.status === 'infrastructure_error') {
+        status = result.status; reason = result.reason ?? 'incomplete_evidence';
+      }
+    }
+    return { id: entry.id, admission: entry.state, specDigest: entry.specDigest, status, reason,
+      expectedCheckIds: expected };
+  });
+  let baseStatus: PackInventoryStatus = 'unknown';
+  if (e.base.run) {
+    const parsed = SuiteRunSchema.safeParse(e.base.run);
+    if (!parsed.success) return refused();
+    const run = parsed.data;
+    if (run.jobId !== e.context.jobId || run.suiteDigest !== e.base.digest
+      || !same(e.base.expectedIds, run.executions.map(x => x.scenarioId))
+      || run.executions.some(x => x.runId !== run.runId)) return refused();
+    // The core report validates exact frozen check inventory. Keep gaps explicit here too.
+    baseStatus = aggregatePackStatuses(run.executions.map(x => {
+      if (x.checks.some(c => c.status === 'fail')) return 'fail';
+      if (x.outcome === 'infrastructure_error' || x.checks.some(c => c.status === 'error')) return 'infrastructure_error';
+      if (!x.checks.length || x.checks.some(c => c.status === 'inconclusive')) return 'unknown';
+      if (x.checks.some(c => c.status === 'not_assessed')) return 'not_assessed';
+      return x.checks.some(c => c.status === 'concern') ? 'concern' : 'pass';
+    }));
+    // Never upgrade the authoritative base summary to pass through a projection.
+    if (baseStatus === 'pass' && e.base.status !== 'pass') baseStatus = states.includes(e.base.status) ? e.base.status : 'unknown';
+  }
+  const packStatus = aggregatePackStatuses(cases.map(c => c.status));
+  const fullStatus = aggregatePackStatuses([baseStatus, packStatus]);
+  return { schemaVersion: 'workflow_pack_projection.v1' as const, runId: e.runId, manifestDigest: digest,
+    baseline: { runId: e.base.run?.runId ?? null, digest: e.base.digest },
+    base12: { status: baseStatus, expectedIds: [...e.base.expectedIds] },
+    appendedPack: { status: packStatus, expectedIds: ids, cases },
+    fullScope: { status: fullStatus, passed: fullStatus === 'pass' },
+    remediation: { scope: 'base12_only' as const, certifiesPack: false as const },
+    comparison: { requiresRetainedFullArtifactDigest: true as const, requiresCoreComparePackRuns: true as const } };
+}
+
+/** Preserve the full raw scopes privately; public projections contain no responses/specs. */
+export function attachWorkflowPackEvidence<T extends { suite: { digest?: string; hash?: string } }>(base: T, pack: PackRunEvidence) {
+  projectWorkflowPack(pack);
+  if ((base.suite.digest ?? base.suite.hash) !== pack.base.digest) return refused();
+  return JSON.parse(canonicalPackJson({ ...base, appendedPack: pack })) as T & { appendedPack: PackRunEvidence };
+}
+export function workflowPackFromArtifact(body: unknown): PackRunEvidence | null {
+  if (!body || typeof body !== 'object' || !('appendedPack' in body)) return null;
+  const pack = (body as { appendedPack: PackRunEvidence }).appendedPack;
+  projectWorkflowPack(pack);
+  return pack;
+}
+/** Fixed vocabulary and validated IDs only: no target output, rules, reasons or credentials. */
+export function appendWorkflowPackReport(markdown: string, evidence: PackRunEvidence): string {
+  const p = projectWorkflowPack(evidence);
+  return markdown + '\n\n## Appended evaluation scope\n\n'
+    + `Base12: ${p.base12.status}. Appended pack: ${p.appendedPack.status}. Full scope: ${p.fullScope.status}.\n\n`
+    + p.appendedPack.cases.map(c => `- ${c.id}: ${c.status} (${c.admission})`).join('\n')
+    + '\n\nUnknown, unassessed and quarantined cases are not passes. Base12 remediation cannot certify appended cases. '
+    + 'Comparison requires retained full-artifact baseline identity and separate core pack comparison.\n';
+}
+
+/** Bind monitoring ticks/comparison baselines to the COMPLETE retained artifact.
+ * Never substitute the frozen base-suite digest or base12 remediation run identity. */
+export function retainedWorkflowPackBaseline(body: unknown) {
+  const evidence = workflowPackFromArtifact(body);
+  if (!evidence) return refused();
+  return { runId: evidence.runId, digest: packDigest(body) };
+}
+
+/** The core manifest's authorization is structured identity metadata, not an HTTP
+ * credential assignment. Rename only that exact object KEY for the scan; scan all
+ * its values and all remaining evidence normally. Stored bytes/digests stay intact. */
+export function containsWorkflowPackArtifactSecret(body: unknown, knownSecrets: readonly string[]) {
+  const pack = workflowPackFromArtifact(body);
+  if (!pack) return containsSecret(canonicalPackJson(body), knownSecrets);
+  const scan = JSON.parse(canonicalPackJson(body));
+  const binding = scan.appendedPack.manifest.authorization;
+  delete scan.appendedPack.manifest.authorization;
+  scan.appendedPack.manifest.reviewAuthorizationBinding = binding;
+  return containsSecret(canonicalPackJson(scan), knownSecrets);
+}
diff --git a/apps/web/src/server/workflow-pack-registry.ts b/apps/web/src/server/workflow-pack-registry.ts
new file mode 100644
index 0000000..0aea662
--- /dev/null
+++ b/apps/web/src/server/workflow-pack-registry.ts
@@ -0,0 +1,17 @@
+import 'server-only';
+import { RED_TEAM_LIBRARY } from '@ae/core/redteam/library';
+import { gradeRedTeam } from '@ae/core/redteam/grade';
+import { createTrustedRegistry, type TrustedPackGrader } from '@ae/core/evals/packs/index';
+/** These imports MUST remain the exact Track A archive source. stage.mjs pins it. */
+export const workflowPackRegistry = createTrustedRegistry({
+  sourceRevision: 'f0068733ca49c37f40fd7de279325f21a4b5fbbb',
+  sourcePath: 'packages/core/src/redteam/library.ts', specs: RED_TEAM_LIBRARY,
+});
+export const workflowPackGrader: TrustedPackGrader = {
+  provenance: workflowPackRegistry.provenance,
+  gradeRule(spec, index, response) {
+    const source = RED_TEAM_LIBRARY.find(s => s.id === spec.id);
+    if (!source || !source.rules[index]) throw new Error('pack_source_rule_missing');
+    return gradeRedTeam({ ...source, rules: [source.rules[index]!] }, { response });
+  },
+};
diff --git a/apps/web/src/server/workflow-packs.ts b/apps/web/src/server/workflow-packs.ts
new file mode 100644
index 0000000..c9cd900
--- /dev/null
+++ b/apps/web/src/server/workflow-packs.ts
@@ -0,0 +1,81 @@
+import 'server-only';
+import { z } from 'zod';
+import { createPackExecutionService, createSecuredTextPackRunner, actualPackTargetDigest,
+  verifyPack, canonicalPackJson, type FrozenPack, type PackRunEvidence } from '@ae/core/evals/packs/index';
+import { PostgresTextCheckpointStore } from '@ae/core/evals/integration/index';
+import type { FrozenTextSuite, SuiteRun } from '@ae/core/evals/text/schema';
+import { createRichWorkflowServices, workflowSql } from './rich-services';
+import { makeServiceContext } from './job-store';
+import { workflowPackRegistry, workflowPackGrader } from './workflow-pack-registry';
+export const WorkflowPackSelection = z.object({ authorizationId: z.string().uuid() }).strict();
+export type WorkflowPackSelection = z.infer<typeof WorkflowPackSelection>;
+export const workflowPackRunId = (jobId: string) => `pack:${jobId}:baseline`;
+export interface WorkflowPackInput {
+ jobId: string; environmentId: 'test' | 'live'; workflowRunId: string; agentId: string;
+ baseSuite: FrozenTextSuite; baseRun: SuiteRun | null; selection: WorkflowPackSelection;
+}
+async function approval(input: WorkflowPackInput, api: Awaited<ReturnType<typeof createRichWorkflowServices>>) {
+ const selection = WorkflowPackSelection.parse(input.selection);
+ const sql = workflowSql();
+   const row=(await sql.query<{manifest:unknown;source_rules:unknown;reviewed_by:string;reviewed_at:Date|string}>(
+    `SELECT p.manifest,p.source_rules,p.reviewed_by,p.reviewed_at FROM workflow_integration.pack_approvals p
+     JOIN jobs j ON j.id=p.job_id AND j.customer_id=p.tenant_id AND j.environment=p.environment
+     WHERE p.job_id=$1 AND p.tenant_id=$2 AND p.environment=$3 AND p.authorization_id=$4
+       AND p.revoked_at IS NULL AND j.workflow_run_id=$5`,
+     [input.jobId,api.job.customerId,input.environmentId,selection.authorizationId,input.workflowRunId])).rows[0];
+   if(!row)throw new Error('pack_operator_approval_required');
+   const manifest=verifyPack(row.manifest,workflowPackRegistry);
+   if(manifest.authorization.authorizationId!==selection.authorizationId
+     || manifest.review.reviewerId!==row.reviewed_by
+     || new Date(manifest.review.reviewedAt).getTime()!==new Date(row.reviewed_at).getTime()
+     || canonicalPackJson(manifest.authorization.sourceRuleIds)!==canonicalPackJson(row.source_rules))throw new Error('pack_operator_receipt_mismatch');
+   const target=await api.resolvePackTarget();
+   if (manifest.baseDigest !== input.baseSuite.digest
+     || manifest.authorization.targetConfigDigest !== actualPackTargetDigest(target.configuration)) throw new Error('pack_base_or_target_changed');
+   const base=await api.text.getSuite(await makeServiceContext(input.jobId), input.baseSuite.digest);
+   if (canonicalPackJson(base)!==canonicalPackJson(input.baseSuite)) throw new Error('pack_base_scope_changed');
+   return manifest;
+  }
+/** Read-only, fresh authority fence before baseline dispatch. No target is sent here. */
+export async function authorizeWorkflowPack(input: WorkflowPackInput): Promise<void> {
+ const ctx=await makeServiceContext(input.jobId);
+ if(ctx.environment!==input.environmentId || input.baseSuite.jobId!==input.jobId || !input.agentId) throw new Error('pack_scope');
+ const api=await createRichWorkflowServices(ctx,{workflowRunId:input.workflowRunId});
+ try {await approval(input, api);} finally {await api.dispose();}
+}
+/** Internal Workflow authority, never expose as an intake/agent tool or customer route. */
+export async function executeWorkflowPack(raw: WorkflowPackInput): Promise<PackRunEvidence> {
+ const input: WorkflowPackInput = structuredClone(raw);
+ const selection = WorkflowPackSelection.parse(input.selection);
+ if (input.baseSuite.jobId !== input.jobId || !input.agentId) throw new Error('pack_job_scope');
+ const ctx = await makeServiceContext(input.jobId);
+ if(ctx.environment!==input.environmentId)throw new Error('pack_environment_scope');
+ const api = await createRichWorkflowServices(ctx, {workflowRunId:input.workflowRunId});
+ try {
+  const sql=workflowSql();
+  const manifest=await approval(input, api);
+  const target=await api.resolvePackTarget();
+  const runner=createSecuredTextPackRunner({...target,registry:workflowPackRegistry,grader:workflowPackGrader});
+  const service=createPackExecutionService({checkpoints:new PostgresTextCheckpointStore(sql),registry:workflowPackRegistry,runner,
+   resolve:async jobId=>{
+    if(jobId!==input.jobId)throw new Error('pack_job_scope');
+    const current=await api.resolvePackTarget(); // rechecks stored Workflow, credentials and target revision
+    const approved=await approval(input, api);
+    return {jobId,environment:input.environmentId,authorizationId:selection.authorizationId,
+      sourceRuleIds:approved.authorization.sourceRuleIds,targetConfigDigest:actualPackTargetDigest(current.configuration)};
+   },
+   verifyReview:async (value:FrozenPack)=>{
+    if(canonicalPackJson(await approval(input, api))!==canonicalPackJson(value))throw new Error('pack_review_changed');
+   },
+  });
+  await service.run({runId:workflowPackRunId(input.jobId),manifest,baseSuite:input.baseSuite,baseRun:input.baseRun});
+  return await service.report(input.jobId,workflowPackRunId(input.jobId));
+ } finally {await api.dispose();}
+}
+/** Selection contains only a durable reference, never approval or executable scenario specs. */
+export async function workflowPackSelection(jobId:string):Promise<WorkflowPackSelection> {
+ const row=(await workflowSql().query<{authorization_id:string}>(
+  'SELECT authorization_id FROM workflow_integration.pack_approvals WHERE job_id=$1 AND revoked_at IS NULL',[jobId])).rows[0];
+ if(!row)throw new Error('pack_operator_approval_required');
+ return WorkflowPackSelection.parse({authorizationId:row.authorization_id});
+}
diff --git a/apps/web/src/server/workflow-resumption.ts b/apps/web/src/server/workflow-resumption.ts
new file mode 100644
index 0000000..f8bd35b
--- /dev/null
+++ b/apps/web/src/server/workflow-resumption.ts
@@ -0,0 +1,65 @@
+import 'server-only';
+import type { AgentTransactionalSql } from '@ae/core/agents/postgres-ports';
+import { reviewDigest } from '@ae/core/evals/data/binding';
+import type { AuthenticatedDataReview } from '@ae/core/evals/data/orchestration';
+export type ReviewResumeScope = {jobId:string;tenantId:string;environment:'test'|'live';workflowRunId:string};
+const active = ['planning','running','investigating'];
+async function authorized(sql:AgentTransactionalSql,s:ReviewResumeScope) {
+ return (await sql.query<{state:string}>(`SELECT state FROM jobs WHERE id::text=$1 AND customer_id::text=$2 AND environment=$3
+ AND workflow_run_id=$4 AND package='text_eval' AND is_mock=false`,[s.jobId,s.tenantId,s.environment,s.workflowRunId])).rows[0];
+}
+async function canonical(sql:AgentTransactionalSql,s:ReviewResumeScope,digest:string) {
+ const row=(await sql.query<{result:AuthenticatedDataReview;result_digest:string;digest:string}>(`SELECT result,result_digest,digest FROM evaluation_data_persistence.operations
+ WHERE tenant_id=$1 AND job_id=$2 AND operation_key=$3 AND state='complete'`,[s.tenantId,s.jobId,`authenticated-data-review:${digest}`])).rows[0];
+ if(!row || row.result_digest!==reviewDigest(row.result) || row.digest!==row.result_digest || row.result.requestDigest!==digest
+ || row.result.authority!=='authenticated_human' || !row.result.principalId || !['approved','rejected'].includes(row.result.decision)) return false;
+ return true;
+}
+/** Called inside the SAME pinned transaction as the core authenticated review ledger writes. */
+export async function enqueueReviewResume(sql:AgentTransactionalSql,s:ReviewResumeScope,requestDigest:string) {
+ const job=await authorized(sql,s);
+ if(!job || !active.includes(job.state) || !/^[a-f0-9]{64}$/.test(requestDigest) || !await canonical(sql,s,requestDigest)) throw new Error('review_resume_refused');
+ const result=await sql.query(`INSERT INTO workflow_integration.review_resume_intents(job_id,request_digest,tenant_id,environment,workflow_run_id)
+ VALUES($1,$2,$3,$4,$5) ON CONFLICT(job_id,request_digest) DO UPDATE SET job_id=EXCLUDED.job_id
+ WHERE workflow_integration.review_resume_intents.tenant_id=EXCLUDED.tenant_id AND workflow_integration.review_resume_intents.environment=EXCLUDED.environment
+ AND workflow_integration.review_resume_intents.workflow_run_id=EXCLUDED.workflow_run_id RETURNING job_id`,[s.jobId,requestDigest,s.tenantId,s.environment,s.workflowRunId]);
+ if(result.rows.length!==1) throw new Error('review_resume_identity_conflict');
+}
+/** Waking is permission to re-read the authoritative data pipeline, NEVER permission to execute a target. */
+export async function reviewWakeReady(sql:AgentTransactionalSql,s:ReviewResumeScope):Promise<boolean> {
+ const job=await authorized(sql,s); if(!job || !active.includes(job.state)) return false;
+ const rows=await sql.query<{request_digest:string}>(`SELECT request_digest FROM workflow_integration.review_resume_intents
+ WHERE job_id=$1 AND tenant_id=$2 AND environment=$3 AND workflow_run_id=$4 AND status='pending' ORDER BY request_digest`,[s.jobId,s.tenantId,s.environment,s.workflowRunId]);
+ for(const row of rows.rows) if(await canonical(sql,s,row.request_digest)) return true;
+ return false;
+}
+export async function dispatchReviewResumes(sql:AgentTransactionalSql,api:{liveness(jobId:string,runId:string):Promise<'alive'|'dead'|'unknown'>;reenqueue(jobId:string,runId:string):Promise<void>},limit=50) {
+ if(!Number.isSafeInteger(limit)||limit<1||limit>100) throw new Error('review_resume_limit');
+ const rows=await sql.query<{job_id:string;request_digest:string;tenant_id:string;environment:'test'|'live';workflow_run_id:string}>(`SELECT * FROM workflow_integration.review_resume_intents WHERE status='pending' ORDER BY last_attempt_at,job_id,request_digest LIMIT $1`,[limit]);
+ const summary={examined:rows.rows.length,reenqueued:0,held:0};
+ for(const row of rows.rows) {
+  const s={jobId:row.job_id,tenantId:row.tenant_id,environment:row.environment,workflowRunId:row.workflow_run_id};
+  const job=await authorized(sql,s);
+  let status='pending';
+  if(!job || !active.includes(job.state)) status=job && ['delivered','cancelled','failed','declined'].includes(job.state)?'finished':'needs_operator';
+  else if(await canonical(sql,s,row.request_digest)) {
+   const live=await api.liveness(s.jobId,s.workflowRunId);
+   if(live==='dead') status='needs_operator';
+   else if(live==='alive') {
+    // Recheck scope immediately before queue delivery; the step reauthorizes again.
+    if(await reviewWakeReady(sql,s)) { await api.reenqueue(s.jobId,s.workflowRunId); summary.reenqueued++; }
+   }
+  }
+  await sql.query('UPDATE workflow_integration.review_resume_intents SET status=$3,last_attempt_at=clock_timestamp() WHERE job_id=$1 AND request_digest=$2',[s.jobId,row.request_digest,status]);
+  if(status==='needs_operator') summary.held++;
+ }
+ return summary;
+}
+/** Snapshot only intents visible BEFORE data advance, so a concurrent human completion is never acknowledged unseen. */
+export async function captureReviewIntents(sql:AgentTransactionalSql,s:ReviewResumeScope) {
+ if(!await authorized(sql,s))return [];
+ return (await sql.query<{request_digest:string}>(`SELECT request_digest FROM workflow_integration.review_resume_intents WHERE job_id=$1 AND tenant_id=$2 AND environment=$3 AND workflow_run_id=$4 AND status='pending'`,[s.jobId,s.tenantId,s.environment,s.workflowRunId])).rows.map(r=>r.request_digest);
+}
+export async function finishReviewIntents(sql:AgentTransactionalSql,s:ReviewResumeScope,digests:string[]) {
+ for(const digest of digests)await sql.query(`UPDATE workflow_integration.review_resume_intents SET status='finished' WHERE job_id=$1 AND tenant_id=$2 AND environment=$3 AND workflow_run_id=$4 AND request_digest=$5 AND status='pending'`,[s.jobId,s.tenantId,s.environment,s.workflowRunId,digest]);
+}
