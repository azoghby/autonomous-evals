@@ -0,0 +1,30 @@
+import { getCurrentCustomer } from '@/server/queries';
+import { getJob,makeServiceContext } from '@/server/job-store';
+import { comparisonProduction } from '@/server/comparison-production';
+import { comparisonBindingSchema } from '@/server/rich-comparison';
+import { isUuid } from '@/server/http';
+export const dynamic='force-dynamic';
+async function owned(jobId:string) {
+ const me=await getCurrentCustomer(); if(!me || !isUuid(jobId)) return null;
+ const job=await getJob(jobId);return job?.customerId===me.id?{tenantId:me.id,environment:job.environment}:null;
+}
+export async function GET(request:Request,context:{params:Promise<{jobId:string}>}) {
+ const {jobId}=await context.params;const p=await owned(jobId);if(!p)return Response.json({error:'Not found'},{status:404});
+ const runtime=await comparisonProduction(jobId);
+ try {
+  const op=new URL(request.url).searchParams.get('operationId');
+  const body=op?await runtime.app.read(p,jobId,op):await runtime.app.inventory(p,jobId);
+  return Response.json(body,{headers:{'Cache-Control':'private, no-store','X-Content-Type-Options':'nosniff'}});
+ } catch {return Response.json({error:'Evidence unavailable'},{status:409});}finally{await runtime.dispose();}
+}
+export async function POST(request:Request,context:{params:Promise<{jobId:string}>}) {
+ const {jobId}=await context.params; const p=await owned(jobId);if(!p)return Response.json({error:'Not found'},{status:404});
+ const body=await request.json().catch(()=>null) as {operationId?:unknown}|null;
+ if(typeof body?.operationId!=='string'|| !/^[A-Za-z0-9_-]{1,64}$/.test(body.operationId))return Response.json({error:'Stable operation ID required'},{status:400});
+ const runtime=await comparisonProduction(jobId);
+ try {
+  const b=comparisonBindingSchema.parse(await runtime.app.inventory(p,jobId));
+  const result=await runtime.app.compare(p,await makeServiceContext(jobId),{operationId:`compare:${body.operationId}`,baselineVersion:b.baseline.version,currentVersion:b.current.version,mode:'comparison'});
+  return Response.json(result,{headers:{'Cache-Control':'private, no-store','X-Content-Type-Options':'nosniff'}});
+ }catch{return Response.json({error:'Comparison requires operator review'},{status:409});}finally{await runtime.dispose();}
+}
diff --git a/apps/web/src/app/api/jobs/[jobId]/data-review/route.ts b/apps/web/src/app/api/jobs/[jobId]/data-review/route.ts
new file mode 100644
index 0000000..d9824e7
--- /dev/null
+++ b/apps/web/src/app/api/jobs/[jobId]/data-review/route.ts
@@ -0,0 +1,30 @@
+import { humanDataReview } from '@/server/data-production';
+
+const failure = () => Response.json({ error: 'Data review unavailable' }, { status: 403 });
+export async function GET(req: Request, ctx: { params: Promise<{ jobId: string }> }) {
+  try {
+    const { jobId } = await ctx.params;
+    return Response.json(await humanDataReview(jobId, new URL(req.url).searchParams.get('digest') ?? ''));
+  } catch { return failure(); }
+}
+export async function POST(req: Request, ctx: { params: Promise<{ jobId: string }> }) {
+  try {
+    // Same-origin JSON POST; cookie authentication alone is insufficient CSRF protection.
+    if (req.headers.get('origin') !== new URL(req.url).origin || !/^application\/json(?:;|$)/i.test(req.headers.get('content-type') ?? '')) return failure();
+    const reader = req.body?.getReader();
+    if (!reader) return failure();
+    const chunks: Uint8Array[] = [];
+    let length = 0;
+    while (true) {
+      const part = await reader.read();
+      if (part.done) break;
+      length += part.value.byteLength;
+      if (length > 500_000) { await reader.cancel(); return failure(); }
+      chunks.push(part.value);
+    }
+    const body = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+    if (!body || typeof body !== 'object' || Object.keys(body).some(k => !['digest', 'receiptId', 'decision', 'reviewed'].includes(k))) return failure();
+    const { jobId } = await ctx.params;
+    return Response.json(await humanDataReview(jobId, body.digest, { receiptId: body.receiptId, decision: body.decision, reviewed: body.reviewed }));
+  } catch { return failure(); }
+}
diff --git a/apps/web/src/app/api/operator/jobs/[jobId]/comparison-binding/route.ts b/apps/web/src/app/api/operator/jobs/[jobId]/comparison-binding/route.ts
new file mode 100644
index 0000000..6c4573e
--- /dev/null
+++ b/apps/web/src/app/api/operator/jobs/[jobId]/comparison-binding/route.ts
@@ -0,0 +1,24 @@
+import { requireOperator,readJson,jsonError,isUuid } from '@/server/http';
+import { workflowSql } from '@/server/rich-services';
+import { getJob } from '@/server/job-store';
+import { comparisonProduction } from '@/server/comparison-production';
+import { comparisonBindingSchema,comparisonDigest } from '@/server/rich-comparison';
+import type { RichRunArtifact } from '@ae/core/monitoring/composition';
+export async function POST(request:Request,context:{params:Promise<{jobId:string}>}) {
+ const auth=await requireOperator();if(auth.res)return auth.res;
+ const {jobId}=await context.params;if(!isUuid(jobId))return jsonError(404,'Not found');
+ const input=await readJson(request,comparisonBindingSchema);if(!input.ok)return input.res;
+ const job=await getJob(jobId);if(!job || job.state!=='delivered'||job.isMock)return jsonError(409,'Delivered rich job required');
+ const sql=workflowSql(); const saved=await sql.query<{body:{format:string;suite:RichRunArtifact['suite'];run:RichRunArtifact['run'];investigation:unknown;limitations:string[]}}>('SELECT body FROM workflow_integration.rich_artifacts WHERE job_id=$1 AND tenant_id=$2 AND environment=$3',[jobId,job.customerId,job.environment]);
+ const body=saved.rows[0]?.body;if(!body)return jsonError(409,'Retained original required');
+ const retained={kind:body.format==='rich_text.v1'?'text':'calendar',suite:body.suite,run:body.run,investigation:body.investigation,limitations:body.limitations,costs:[],unknownCosts:['original_baseline_and_design_costs_not_measured_here']} as RichRunArtifact;
+ const runtime=await comparisonProduction(jobId);
+ try {
+  const inventory=await runtime.verify(jobId,input.data,retained);
+  if(comparisonDigest([...inventory.scenarioIds].sort())!==comparisonDigest([...input.data.scenarioIds].sort()))return jsonError(409,'Complete application inventory required');
+  const digest=comparisonDigest({suite:body.suite,retained,binding:input.data});
+  const inserted=await sql.query(`INSERT INTO workflow_comparison.bindings(job_id,suite,retained,binding,binding_digest) VALUES($1,$2::jsonb,$3::jsonb,$4::jsonb,$5) ON CONFLICT DO NOTHING RETURNING job_id`,[jobId,JSON.stringify(body.suite),JSON.stringify(retained),JSON.stringify(input.data),digest]);
+  if(!inserted.rows.length){const same=await sql.query('SELECT job_id FROM workflow_comparison.bindings WHERE job_id=$1 AND binding_digest=$2',[jobId,digest]);if(!same.rows.length)return jsonError(409,'Immutable admission conflict');}
+  return Response.json({admitted:true,scope:input.data.scope,inventory:input.data.scenarioIds,packExecution:'unsupported',notifications:'draft_only'});
+ }catch{return jsonError(409,'Canonical baseline/configuration review required');}finally{await runtime.dispose();}
+}
diff --git a/apps/web/src/app/api/operator/jobs/[jobId]/comparison-reconcile/route.ts b/apps/web/src/app/api/operator/jobs/[jobId]/comparison-reconcile/route.ts
new file mode 100644
index 0000000..3c6c8e6
--- /dev/null
+++ b/apps/web/src/app/api/operator/jobs/[jobId]/comparison-reconcile/route.ts
@@ -0,0 +1,21 @@
+import { z } from 'zod';
+import { requireOperator,readJson,jsonError,isUuid } from '@/server/http';
+import { workflowSql } from '@/server/rich-services';
+import { getJob } from '@/server/job-store';
+import { comparisonDigest } from '@/server/rich-comparison';
+const Input=z.object({operationId:z.string().min(1).max(128).regex(/^[A-Za-z0-9_.:-]+$/),decision:z.enum(['retain_blocked','accept_retained_completion'])}).strict();
+/** Records authoritative local evidence. Never unlocks, releases, or redispatches ambiguous operations. */
+export async function POST(request:Request,context:{params:Promise<{jobId:string}>}) {
+ const auth=await requireOperator();if(auth.res)return auth.res;
+ const {jobId}=await context.params;if(!isUuid(jobId))return jsonError(404,'Not found');
+ const input=await readJson(request,Input);if(!input.ok)return input.res;
+ if(!await getJob(jobId))return jsonError(404,'Not found');
+ const accepted=await workflowSql().transaction(async tx=>{
+  const evidence=await tx.query<{kind:string;state:string;input_digest:string;value:unknown}>(`SELECT kind,state,input_digest,value FROM text_integration.checkpoints WHERE job_id=$1 AND id=$2 AND kind IN ('app_rich_tick','rich_comparison_identity','rich_comparison_baseline','rich_comparison_current') ORDER BY kind FOR UPDATE`,[jobId,input.data.operationId]);
+  if(!evidence.rows.length)return false;
+  if(input.data.decision==='accept_retained_completion'&&!evidence.rows.some(r=>r.kind==='app_rich_tick'&&r.state==='completed'))return false;
+  await tx.query(`INSERT INTO workflow_comparison.reconciliation(job_id,operation_id,operator_id,evidence_digest,decision) VALUES($1,$2,$3,$4,$5) ON CONFLICT DO NOTHING`,[jobId,input.data.operationId,auth.viewer.id,comparisonDigest(evidence.rows),input.data.decision]);
+  return true;
+ });
+ return accepted?Response.json({recorded:true,redispatch:false}):jsonError(409,'No authoritative completion; preserve blocked claims and reservations');
+}
