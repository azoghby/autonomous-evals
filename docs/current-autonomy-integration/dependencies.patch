@@ -0,0 +1,126 @@
+import "server-only";
+import { readStructuredProgress } from "./structured-progress";
+import { createHmac } from "node:crypto";
+import { Pool } from "@neondatabase/serverless";
+import { decrypt, decryptJson } from "@ae/core/storage/crypto";
+import { containsSecret } from "@ae/core/agents/redact";
+import { createProgressChatService, createPostgresConversationPort, ChatError,
+  ProgressSnapshotSchema, type ProgressSnapshot, type ConversationSqlExecutor,
+  type ConversationTransactionalSql } from "@ae/core/reporting/chat/index";
+import { getCurrentCustomer } from "./session";
+
+// Same DATABASE_URL/schema and Neon WS driver as core integration/eval-services.
+// That module's pool is private: own a small lazy pool rather than changing core ownership.
+let pool: Pool | undefined;
+function database(): Pool {
+  if (!process.env.DATABASE_URL) throw new ChatError("storage_error");
+  return pool ??= new Pool({ connectionString: process.env.DATABASE_URL, max: 3,
+    connectionTimeoutMillis: 5000, idleTimeoutMillis: 10000 });
+}
+
+export async function pinned<T>(pool: Pick<Pool, "connect">, readOnly: boolean,
+  run: (tx: ConversationSqlExecutor) => Promise<T>): Promise<T> {
+  const client = await pool.connect();
+  try {
+    await client.query(readOnly ? "BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY" : "BEGIN ISOLATION LEVEL READ COMMITTED");
+    await client.query("SET LOCAL statement_timeout = '5s'");
+    await client.query("SET LOCAL lock_timeout = '3s'");
+    const result = await run({ query: async <R>(sql: string, params?: unknown[]) => {
+      const result = await client.query(sql, params); return { rows: result.rows as R[] };
+    } });
+    await client.query("COMMIT");
+    return result;
+  } catch (error) { await client.query("ROLLBACK").catch(() => undefined); throw error; }
+  finally { client.release(); }
+}
+
+type Job = { id: string; customer_id: string; state: string; updated_at: Date | string };
+type Timed = { id: string; created_at: Date | string };
+type Progress = Timed & { milestone: string };
+type Finding = Timed & { status: string; severity: string };
+type Cost = Timed & { source: string; micro_usd: string | number };
+const iso = (value: Date | string) => new Date(value).toISOString();
+
+/** Only enum/count/cost fields enter the projection. No intake, trace, report, error,
+ * finding prose, event message, cost metadata or provider/session IDs are selected. */
+export function mapSnapshot(job: Job, progress: Progress[], findings: Finding[], costs: Cost[], key: Buffer,
+  subjectId: string): ProgressSnapshot {
+  if (progress.length > 200 || findings.length > 200 || costs.length > 1000) throw new ChatError("invalid_snapshot");
+  const ref = (kind: string, id: string) => "ev_" + createHmac("sha256", key)
+    .update(JSON.stringify(["private-progress-chat-v1", subjectId, job.id, kind, id])).digest("hex");
+  const observedAt = [job.updated_at, ...progress.map(r => r.created_at), ...findings.map(r => r.created_at),
+    ...costs.map(r => r.created_at)].map(iso).sort().at(-1)!;
+  const value = {
+    jobId: job.id, observedAt, status: job.state, statusEvidenceRef: ref("status", job.state + iso(job.updated_at)),
+    milestones: progress.map(row => ({ id: ref("progress", row.id),
+      milestone: ["planning", "running", "investigating", "delivered"].includes(row.milestone) ? row.milestone : "other",
+      at: iso(row.created_at), evidenceRef: ref("progress", row.id) })),
+    findings: findings.map(row => ({ id: ref("finding", row.id), status: row.status, severity: row.severity,
+      evidenceRefs: [ref("finding", row.id)] })),
+    blockers: ["paused_budget", "payment_review", "needs_clarification", "failed"].includes(job.state)
+      ? [{ id: ref("blocker", job.state), kind: job.state === "paused_budget" ? "budget" :
+        job.state === "payment_review" ? "payment" : job.state === "needs_clarification" ? "input" : "other",
+        evidenceRef: ref("status", job.state + iso(job.updated_at)) }] : [],
+    costs: costs.map(row => ({ id: ref("cost", row.id), source: row.source, microUsd: Number(row.micro_usd),
+      evidenceRef: ref("cost", row.id) })),
+    // App cost rows have no completeness marker, including at delivery. Never imply zero total.
+    unknownCosts: true,
+  };
+  const parsed = ProgressSnapshotSchema.safeParse(value);
+  if (!parsed.success) throw new ChatError("invalid_snapshot");
+  return parsed.data;
+}
+
+function secretsFrom(value: unknown): string[] {
+  if (typeof value === "string") return value.length >= 4 ? [value] : [];
+  if (Array.isArray(value)) return value.flatMap(secretsFrom);
+  if (value && typeof value === "object") return Object.values(value).flatMap(secretsFrom);
+  return [];
+}
+
+/** Per-request session, authorization and current credentials. No client identity or global injectable service. */
+export async function progressChatForRequest(jobId: string) {
+  const me = await getCurrentCustomer();
+  if (!me) throw new ChatError("unauthenticated");
+  if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(jobId)) throw new ChatError("not_found");
+  const p = database();
+  const material = await pinned(p, true, async tx => {
+    const jobs = await tx.query<Job>("SELECT id, customer_id, state, updated_at FROM jobs WHERE id = $1 AND (customer_id = $2 OR $3::boolean)", [jobId, me.id, me.isOperator]);
+    const job = jobs.rows[0];
+    if (!job) throw new ChatError("not_found");
+    // Decrypt credentials only after authorization, inside the same snapshot. No provider/blob reads.
+    const credentials = await tx.query<{ciphertext: string}>("SELECT ciphertext FROM job_credentials WHERE job_id = $1", [jobId]);
+    const github = await tx.query<{token_ciphertext: string}>("SELECT token_ciphertext FROM job_github_targets WHERE job_id = $1", [jobId]);
+    const knownSecrets = Object.entries(process.env).filter(([name]) => /KEY|SECRET|TOKEN|PASSWORD|DATABASE_URL/i.test(name))
+      .flatMap(([, value]) => secretsFrom(value));
+    for (const row of credentials.rows) knownSecrets.push(...secretsFrom(decryptJson(row.ciphertext)));
+    for (const row of github.rows) knownSecrets.push(...secretsFrom(decrypt(row.token_ciphertext)));
+    const key = Buffer.from(process.env.CREDENTIALS_ENCRYPTION_KEY ?? "", "base64");
+    if (key.length !== 32) throw new ChatError("invalid_snapshot");
+    const events = await tx.query<Progress>("SELECT id, milestone, created_at FROM progress_events WHERE job_id = $1 ORDER BY created_at, id LIMIT 201", [jobId]);
+    const findings = await tx.query<Finding>("SELECT id, data->>'status' AS status, data->>'severity' AS severity, created_at FROM findings WHERE job_id = $1 AND rerun_of_finding_id IS NULL ORDER BY created_at, id LIMIT 201", [jobId]);
+    const costs = await tx.query<Cost>("SELECT id, source, micro_usd, created_at FROM costs WHERE job_id = $1 ORDER BY created_at, id LIMIT 1001", [jobId]);
+    const appSnapshot = mapSnapshot(job, events.rows, findings.rows, costs.rows, key, me.id);
+    const structured = await readStructuredProgress(tx, { subjectId: me.id, jobId }, job, key, knownSecrets, appSnapshot.observedAt);
+    const snapshot = structured ? { ...structured, blockers: [...structured.blockers, ...appSnapshot.blockers], costs: appSnapshot.costs, unknownCosts: true } : appSnapshot;
+    if (containsSecret(JSON.stringify(snapshot), knownSecrets)) throw new ChatError("invalid_snapshot");
+    return { snapshot, knownSecrets };
+  });
+  const sql: ConversationTransactionalSql = {
+    query: async <R>(query: string, params?: unknown[]) => {
+      const result = await p.query(query, params); return { rows: result.rows as R[] };
+    },
+    transaction: run => pinned(p, false, run),
+  };
+  return createProgressChatService({
+    access: {
+      authenticate: async () => ({ subjectId: me.id }),
+      resolveAuthorizedJob: async (caller, id) => {
+        const result = await p.query("SELECT id FROM jobs WHERE id = $1 AND (customer_id = $2 OR $3::boolean)", [id, caller.subjectId, me.isOperator]);
+        return result.rows.length === 1 ? { subjectId: caller.subjectId, jobId: id } : null;
+      },
+    },
+    progress: { read: async () => material.snapshot },
+    conversations: createPostgresConversationPort(sql), knownSecrets: material.knownSecrets,
+  });
+}
diff --git a/apps/web/src/server/rich-artifacts.ts b/apps/web/src/server/rich-artifacts.ts
new file mode 100644
index 0000000..77115c7
--- /dev/null
+++ b/apps/web/src/server/rich-artifacts.ts
@@ -0,0 +1,37 @@
+import 'server-only';
+import { containsWorkflowPackArtifactSecret, workflowPackFromArtifact } from './workflow-pack-projection';
+import type { AgentTransactionalSql } from '@ae/core/agents/postgres-ports';
+import { canonicalJson } from '@ae/core/evals/text/index';
+/** Rich evidence is retained in durable private application storage. No runtime DDL.
+ * Callers authorize job ownership separately; scope is checked again in SQL. */
+export async function persistRichArtifact(db: AgentTransactionalSql,
+  scope: { jobId: string; tenantId: string; environment: 'test' | 'live' },
+  suiteDigest: string, body: unknown, knownSecrets: readonly string[]) {
+  const pack = workflowPackFromArtifact(body);
+  if (pack && (pack.context.jobId !== scope.jobId || pack.context.environment !== scope.environment
+    || pack.base.digest !== suiteDigest)) throw new Error('rich_pack_scope');
+  const encoded = canonicalJson(body);
+  if (!/^[a-f0-9]{64}$/.test(suiteDigest) || containsWorkflowPackArtifactSecret(body, knownSecrets)) throw new Error('rich_evidence_refused');
+  await db.transaction(async tx => {
+    const job = (await tx.query<{ customer_id: string; environment: string }>(
+      'SELECT customer_id, environment FROM jobs WHERE id=$1 FOR UPDATE', [scope.jobId])).rows[0];
+    if (!job || job.customer_id !== scope.tenantId || job.environment !== scope.environment) throw new Error('rich_evidence_scope');
+    const old = (await tx.query<{ suite_digest: string; body: unknown }>(
+      'SELECT suite_digest, body FROM workflow_integration.rich_artifacts WHERE job_id=$1', [scope.jobId])).rows[0];
+    if (old) {
+      if (old.suite_digest !== suiteDigest || canonicalJson(old.body) !== encoded) throw new Error('rich_evidence_conflict');
+      return;
+    }
+    await tx.query('INSERT INTO workflow_integration.rich_artifacts(job_id,tenant_id,environment,suite_digest,body) VALUES($1,$2,$3,$4,$5::jsonb)',
+      [scope.jobId, scope.tenantId, scope.environment, suiteDigest, encoded]);
+  });
+}
+export async function readRichArtifact(db: AgentTransactionalSql, jobId: string, tenantId: string, knownSecrets: readonly string[]): Promise<unknown | null> {
+  const row = (await db.query<{ body: unknown; environment: string }>(`SELECT a.body, a.environment FROM workflow_integration.rich_artifacts a
+    JOIN jobs j ON j.id=a.job_id AND j.customer_id=a.tenant_id AND j.environment=a.environment
+    WHERE a.job_id=$1 AND a.tenant_id=$2`, [jobId, tenantId])).rows[0];
+  if (row && containsWorkflowPackArtifactSecret(row.body, knownSecrets)) throw new Error('rich_evidence_refused');
+  const pack = workflowPackFromArtifact(row?.body);
+  if (pack && (pack.context.jobId !== jobId || pack.context.environment !== row?.environment)) throw new Error('rich_pack_scope');
+  return row?.body ?? null;
+}
diff --git a/apps/web/src/server/rich-judge.ts b/apps/web/src/server/rich-judge.ts
new file mode 100644
index 0000000..f48109b
--- /dev/null
+++ b/apps/web/src/server/rich-judge.ts
@@ -0,0 +1,141 @@
+import { assertAutonomousPaidContext, type AutonomousPaidContext, type PaidMonitor } from './autonomous-paid';
+import 'server-only';
+import { createHash } from 'node:crypto';
+import { createGatewayJudge, type JudgeInput } from '@ae/core/judges/gateway';
+import { containsSecret } from '@ae/core/agents/redact';
+import { ROLE_DEFINITIONS } from '@ae/core/agents/roles';
+import { PRICE_TABLE } from '@ae/core/evals/pricing';
+import type { JobRef } from '@ae/core/evals/types';
+import type { TextCheckpointStore } from '@ae/core/evals/integration/checkpoints';
+import type { RemediationAccountingDeps } from '@ae/core/evals/remediation/accounting/index';
+import { canonicalJson } from '@ae/core/evals/text/index';
+import { JudgeAccounting } from './judge-accounting';
+
+export interface JudgePolicy {
+  model: string; configVersion: string; privateKeyRef: string; reservationMicroUsd: number;
+  periodId: string; auth: 'api_key' | 'oidc';
+}
+export interface TrustedJudgeRuntime {
+  signal: AbortSignal;
+  beforeDispatch(intent: { kind: 'gateway'; operationId: string }): Promise<void>;
+  token(ref: string, auth: JudgePolicy['auth']): Promise<string>;
+  /** Offline fixtures only; production uses the secured, fixed Gateway URL in createGatewayJudge. */
+  fetch?: typeof fetch;
+}
+const refuse = (): never => { throw new Error('judge_reconciliation_required'); };
+export function createTrustedJudgeResolver(deps: {
+  autonomous?: AutonomousPaidContext; monitor?: PaidMonitor;
+  sql: RemediationAccountingDeps['sql']; checkpoints: TextCheckpointStore;
+  canonical(): Promise<{ job: JobRef; knownSecrets: readonly string[]; targetVersion: string }>;
+  policy: JudgePolicy; runtime: TrustedJudgeRuntime; deliverCost: RemediationAccountingDeps['deliverCost'];
+}) {
+  if (deps.autonomous) assertAutonomousPaidContext(deps.autonomous);
+  const policy = Object.freeze({ ...deps.policy });
+  if (!policy.model.trim() || !policy.configVersion || !policy.privateKeyRef || !/^[A-Za-z0-9_-]+$/.test(policy.periodId)
+    || !Number.isSafeInteger(policy.reservationMicroUsd) || policy.reservationMicroUsd <= 0
+    || !['api_key','oidc'].includes(policy.auth)) refuse();
+  return async (raw: JudgeInput) => {
+    const input = structuredClone(raw);
+    let privateToken: string | undefined;
+    const a = await deps.canonical();
+    if (deps.autonomous) { await deps.autonomous.guard(a.job,deps.sql); if(policy.periodId!==deps.autonomous.policy.periodId || policy.reservationMicroUsd!==deps.autonomous.judgeReservationMicroUsd) refuse(); }
+    function safe(value: unknown, secrets = a.knownSecrets) { if (containsSecret(JSON.stringify(value), [...secrets, ...(privateToken ? [privateToken] : [])])) refuse(); }
+    safe(input);
+    const digest = createHash('sha256').update(canonicalJson({ input, policy, job: a.job, targetVersion: a.targetVersion, ...(deps.autonomous ? {autonomousPolicy:deps.autonomous.policy,monitor:deps.monitor ?? null} : {}) })).digest('hex');
+    const operationId = `workflow-judge:${a.job.jobId}:${input.operationId}`;
+    const op = { operationId, kind: 'judge' as const, inputDigest: digest };
+    const key = { jobId: a.job.jobId, kind: 'gateway_judge', id: operationId, inputDigest: digest };
+    const accounting = new JudgeAccounting({ sql: deps.sql, jobId: a.job.jobId, deliverCost: deps.deliverCost,
+      reservation: deps.autonomous ? deps.autonomous.reservation('judge',deps.monitor) : () => ({ reservationId: operationId, jobId: a.job.jobId, amountMicroUsd: policy.reservationMicroUsd, scopes: [
+        { key: `job:${a.job.jobId}`, capMicroUsd: PRICE_TABLE[a.job.package].jobBudgetMicroUsd },
+        { key: `agent:evaluation_engineer:${policy.periodId}`, capMicroUsd: ROLE_DEFINITIONS.evaluation_engineer.periodCapMicroUsd },
+        ...(deps.monitor ? [{key:deps.monitor.key,capMicroUsd:deps.monitor.capMicroUsd}] : []),
+      ] }) });
+    async function current() {
+      deps.runtime.signal.throwIfAborted();
+      await deps.autonomous?.guard(a.job,deps.sql);
+      const latest = await deps.canonical();
+      if (canonicalJson(latest.job) !== canonicalJson(a.job) || latest.targetVersion !== a.targetVersion) refuse();
+      safe(input, latest.knownSecrets);
+      return latest;
+    }
+    await current();
+    const claim = await deps.checkpoints.claim(key);
+    if (claim.state === 'completed') { const latest = await current(); safe(claim.value, latest.knownSecrets); return claim.value as Awaited<ReturnType<ReturnType<typeof createGatewayJudge>>>; }
+    if (claim.state !== 'claimed') return refuse();
+    let dispatched = false;
+    try {
+      const judge = createGatewayJudge({ model: policy.model,
+        token: async () => { await current(); privateToken = await deps.runtime.token(policy.privateKeyRef, policy.auth); safe(input); return privateToken; },
+        authorize: async () => {
+          await current();
+          if (!await accounting.authorize(op)) refuse();
+          await accounting.claim(op);
+        },
+        fetch: async (url, init) => {
+          // Core fixes URL/model/max_tokens/redirect; combine its timeout with parent cancellation.
+          if (url !== 'https://ai-gateway.vercel.sh/v1/chat/completions' || !init?.signal) return refuse();
+          const signal = AbortSignal.any([deps.runtime.signal, init.signal]);
+          await current();
+          await deps.runtime.beforeDispatch({ kind: 'gateway', operationId });
+          const latest = await current();
+          safe(init.body, latest.knownSecrets);
+          signal.throwIfAborted();
+          dispatched = true;
+          return (deps.runtime.fetch ?? fetch)(url, { ...init, signal });
+        },
+        recordUsage: async usage => {
+          const receipt = { ...usage, operationId }; safe(receipt);
+          await accounting.observed(op, receipt);
+          // Retain the actual provider ID/model/tokens for owner reconciliation in the existing store.
+          const usageKey = { ...key, kind: 'gateway_judge_usage' };
+          const saved = await deps.checkpoints.claim(usageKey);
+          if (saved.state === 'claimed') await deps.checkpoints.complete(usageKey, saved.token, receipt);
+          else if (saved.state !== 'completed' || canonicalJson(saved.value) !== canonicalJson(receipt)) refuse();
+        },
+      });
+      const verdict = await judge(input);
+      const latest = await current(); safe(verdict, latest.knownSecrets);
+      await deps.checkpoints.complete(key, claim.token, verdict);
+      return verdict;
+    } catch {
+      if (dispatched) await accounting.ambiguous(op).catch(() => undefined);
+      await deps.checkpoints.markAmbiguous(key, claim.token).catch(() => undefined);
+      return refuse();
+    }
+  };
+}
+
+/** Only server deployment configuration selects the model and private credential reference.
+ * No customer input or route accepts this policy or credentials. */
+export function workflowJudgePolicy(): JudgePolicy {
+  const auth = process.env.WORKFLOW_JUDGE_AUTH;
+  if (auth !== 'api_key' && auth !== 'oidc') return refuse();
+  return { model: process.env.WORKFLOW_JUDGE_MODEL ?? '', configVersion: process.env.WORKFLOW_JUDGE_CONFIG_VERSION ?? '',
+    reservationMicroUsd: Number(process.env.WORKFLOW_JUDGE_RESERVATION_MICRO_USD), periodId: process.env.NAIVE_BUDGET_PERIOD_ID ?? '',
+    auth, privateKeyRef: auth === 'api_key' ? 'AI_GATEWAY_API_KEY' : 'VERCEL_OIDC_TOKEN' };
+}
+export type WorkflowJudgePhase = 'baseline' | 'remediation' | 'rerun' | 'comparison' | 'monitoring';
+/** Server-only phase plan; no HTTP/body choice. Missing plan refuses dispatch. Permanent
+ * SQL claims and monetary reservations still fence every call across worker restarts.
+ * This local ceiling never overrides acceptance's separate durable lower-cap meter. */
+export function workflowJudgeRuntime(phase: WorkflowJudgePhase = 'baseline'): TrustedJudgeRuntime {
+  let limit = 0;
+  const raw = process.env.WORKFLOW_JUDGE_PHASE_DISPATCH_LIMITS;
+  if (raw) {
+    let plan: Record<string, unknown>;
+    try { plan = JSON.parse(raw); } catch { return refuse(); }
+    if (!plan || typeof plan !== 'object' || Array.isArray(plan)
+      || Object.keys(plan).some(k => !['baseline','remediation','rerun','comparison','monitoring'].includes(k))) return refuse();
+    const value = plan[phase];
+    if (!Number.isSafeInteger(value) || Number(value) < 1 || Number(value) > 96) return refuse();
+    limit = Number(value);
+  }
+  let dispatched = 0;
+  return { signal: AbortSignal.timeout(180000), beforeDispatch: async () => { if (++dispatched > limit) refuse(); }, token: async (ref, auth) => {
+    if (ref !== (auth === 'api_key' ? 'AI_GATEWAY_API_KEY' : 'VERCEL_OIDC_TOKEN')) return refuse();
+    const token = process.env[ref];
+    if (!token) return refuse();
+    return token;
+  } };
+}
diff --git a/apps/web/src/server/rich-remediation.ts b/apps/web/src/server/rich-remediation.ts
new file mode 100644
index 0000000..63b7905
--- /dev/null
+++ b/apps/web/src/server/rich-remediation.ts
@@ -0,0 +1,92 @@
+import { assertAutonomousPaidContext, type AutonomousPaidContext } from './autonomous-paid';
+import type { createTrustedJudgeResolver } from './rich-judge';
+import 'server-only';
+import type { AgentTaskRunner } from '@ae/core/agents/session-service';
+import type { AgentTransactionalSql, AgentSqlExecutor } from '@ae/core/agents/postgres-ports';
+import { ROLE_DEFINITIONS } from '@ae/core/agents/roles';
+import { PRICE_TABLE } from '@ae/core/evals/pricing';
+import type { JobRef } from '@ae/core/evals/types';
+import type { TextCheckpointStore } from '@ae/core/evals/integration/checkpoints';
+import type { createTextEvaluationServices } from '@ae/core/evals/integration/services';
+import { createRemediationServices, remediationDigest } from '@ae/core/evals/remediation/index';
+import { PostgresRemediationAccounting } from '@ae/core/evals/remediation/accounting/index';
+import { createRemediationTarget } from '@ae/core/targets/remediation';
+import { TrackBBlockedError } from '@ae/core/evals/service-adapter';
+import { canonicalJson } from '@ae/core/evals/text/index';
+
+const refused = (): never => { throw new TrackBBlockedError('needs_operator', 'Saved remediation authority or baseline changed; reconciliation required.'); };
+export interface RemediationCanonical {
+  job: JobRef; knownSecrets: readonly string[]; targetVersion: string;
+  intake: { endpoint: { url: string; model: string; apiKey?: string } };
+  binding: { isolation: string | null; remediation_operation_micro_usd: number | null; baseline_suite_digest: string | null; baseline_run_id: string | null };
+}
+/** One global keyed protocol across session, Gateway and HTTP provider facts.
+ * Target HTTP has its own typed table: it must never masquerade as a Naive/Gateway charge. */
+export async function deliverRemediationCost(tx: AgentSqlExecutor, entry: {
+  jobId: string; operationId: string; kind: 'target' | 'judge'; microUsd: number; idempotencyKey: string; receiptId: string;
+}) {
+  if (!Number.isSafeInteger(entry.microUsd) || entry.microUsd < 0 || !entry.idempotencyKey || !entry.receiptId) refused();
+  const payload = { ...entry, source: entry.kind === 'target' ? 'target_http' : 'ai_gateway' };
+  const claimed = await tx.query(`INSERT INTO workflow_integration.cost_keys(job_id,key,payload)
+    VALUES($1,$2,$3::jsonb) ON CONFLICT(key) DO NOTHING RETURNING key`, [entry.jobId, entry.idempotencyKey, canonicalJson(payload)]);
+  if (!claimed.rows.length) {
+    const old = await tx.query<{ agrees: boolean }>('SELECT payload=$3::jsonb AS agrees FROM workflow_integration.cost_keys WHERE job_id=$1 AND key=$2', [entry.jobId, entry.idempotencyKey, canonicalJson(payload)]);
+    if (old.rows[0]?.agrees !== true) refused();
+    return;
+  }
+  await tx.query(`INSERT INTO workflow_integration.provider_costs(job_id,key,source,operation_id,receipt_id,micro_usd)
+    VALUES($1,$2,$3,$4,$5,$6)`, [entry.jobId, entry.idempotencyKey, payload.source, entry.operationId, entry.receiptId, entry.microUsd]);
+}
+
+/** Internal Workflow closure; request finding IDs select only canonical retained investigation facts. */
+export function createRichRemediation(deps: {
+  autonomous?: AutonomousPaidContext;
+  sql: AgentTransactionalSql; runner: AgentTaskRunner; checkpoints: TextCheckpointStore;
+  canonical(): Promise<RemediationCanonical>;
+  text: ReturnType<typeof createTextEvaluationServices>;
+  judge?: ReturnType<typeof createTrustedJudgeResolver>;
+}) {
+  if (deps.autonomous) assertAutonomousPaidContext(deps.autonomous);
+  return createRemediationServices({ runner: deps.autonomous?.runner ?? deps.runner, checkpoints: deps.checkpoints, resolve: async (ctx, findingId) => {
+    const a = await deps.canonical();
+    await deps.autonomous?.guard(a.job,deps.sql);
+    if (a.job.jobId !== ctx.jobId || a.job.environment !== ctx.environment || a.job.package !== 'text_eval') return refused();
+    const suiteDigest = a.binding.baseline_suite_digest, runId = a.binding.baseline_run_id;
+    if (!suiteDigest || !runId) return refused();
+    // reportInput reads the stored frozen suite/run/investigation, never request/model prose.
+    const saved = await deps.text.reportInput(ctx, { suiteDigest, runId });
+    const identity = await deps.checkpoints.get({ jobId: ctx.jobId, kind: 'run_identity', id: runId });
+    if (identity?.state !== 'completed' || (identity.value as { targetVersion?: string }).targetVersion !== a.targetVersion) return refused();
+    const finding = saved.richFindings.find(f => f.id === findingId);
+    if (!finding || finding.label !== 'confirmed') return refused();
+    const failingCheckIds = [...new Set(finding.evidence.flatMap(e => e.kind === 'check' && saved.run.executions.some(s => s.checks.some(c => c.checkId === e.checkId && c.kind === 'objective' && c.status === 'fail')) ? [e.checkId] : []))];
+    if (!failingCheckIds.length || saved.suite.scenarios.length !== 12) return refused();
+    const binding = { targetId: `job:${ctx.jobId}:endpoint`, targetVersion: a.targetVersion, environment: ctx.environment };
+    const original = { suite: saved.suite, run: saved.run, binding, failingCheckIds };
+    const trialId = `trial:${remediationDigest({ binding, findingId, suiteDigest, runId })}`;
+    const bound = a.binding.remediation_operation_micro_usd;
+    const enabled = a.binding.isolation === 'request_messages_only' && Number.isSafeInteger(bound) && Number(bound) > 0;
+    const period = deps.autonomous?.policy.periodId ?? process.env.NAIVE_BUDGET_PERIOD_ID;
+    if (deps.autonomous && enabled && Number(bound)!==deps.autonomous.targetReservationMicroUsd) return refused();
+    if (enabled && (!period || !/^[A-Za-z0-9_-]+$/.test(period))) return refused();
+    const accounting = new PostgresRemediationAccounting({ sql: deps.sql, jobId: ctx.jobId,
+      reservation: deps.autonomous ? deps.autonomous.reservation('target') : op => ({ reservationId: op.operationId, jobId: ctx.jobId, amountMicroUsd: Number(bound), scopes: [
+        { key: `job:${ctx.jobId}`, capMicroUsd: PRICE_TABLE[a.job.package].jobBudgetMicroUsd },
+        { key: `agent:evaluation_engineer:${period}`, capMicroUsd: ROLE_DEFINITIONS.evaluation_engineer.periodCapMicroUsd },
+      ] }), deliverCost: deliverRemediationCost });
+    const trial = enabled ? createRemediationTarget({
+      scope: { job: a.job, finding, binding, original, trialId,
+        endpoint: { kind: 'stateless_chat_completions', isolation: 'request_messages_only', ...a.intake.endpoint } },
+      currentSecrets: async () => {
+        await deps.autonomous?.guard(a.job,deps.sql);
+        const latest = await deps.canonical();
+        if (latest.targetVersion !== a.targetVersion || latest.binding.isolation !== a.binding.isolation
+          || latest.binding.remediation_operation_micro_usd !== bound) return refused();
+        return latest.knownSecrets;
+      }, accounting: { beforeDispatch: accounting.beforeDispatch.bind(accounting), observed: accounting.observed.bind(accounting), ambiguous: accounting.ambiguous.bind(accounting) }, limits: { timeoutMs: 15000, maxCompletionTokens: 512, maxRequestBytes: 256000, maxResponseBytes: 1000000 },
+    }) : null;
+    // The shared secured judge owns its durable reservation, usage and keyed delivery.
+    return { job: a.job, finding, knownSecrets: a.knownSecrets, binding, original, trial, judge: deps.judge ? async input => ({ value: await deps.judge!(input), costs: [] }) : null,
+      authorize: async op => { await deps.autonomous?.guard(a.job,deps.sql); return op.kind === 'judge' ? Boolean(deps.judge) : enabled ? accounting.authorize(op) : false; } };
+  } });
+}
diff --git a/apps/web/src/server/rich-rerun.ts b/apps/web/src/server/rich-rerun.ts
new file mode 100644
index 0000000..7b7357e
--- /dev/null
+++ b/apps/web/src/server/rich-rerun.ts
@@ -0,0 +1,114 @@
+import 'server-only';
+import { createHash } from 'node:crypto';
+import type { AgentTransactionalSql } from '@ae/core/agents/postgres-ports';
+import type { ServiceContext } from '@ae/core/contracts/services';
+import { JOB_BUDGET_MICRO_USD } from '@ae/core/contracts/index';
+import { canonicalJson } from '@ae/core/evals/text/index';
+import { containsSecret } from '@ae/core/agents/redact';
+import { createRichWorkflowServices, workflowSql } from './rich-services';
+import { getJobWithDecryptedCredentials, makeServiceContext } from './job-store';
+import { getEvalServices } from './services';
+const hash = (v: unknown) => createHash('sha256').update(canonicalJson(v)).digest('hex');
+export class RerunRefusal extends Error { constructor(public status: number, message: string) { super(message); } }
+const refuse = (message = 'Re-run requires operator reconciliation', status = 409): never => { throw new RerunRefusal(status, message); };
+type Artifact = { format: string; suite: { digest?: string; hash?: string; scenarios: { id: string }[] }; run: { runId: string; branchId?: string; versionLabel?: string }; investigation: { findings: { id: string }[] }; appendedPack?: unknown };
+export type RerunRequest = { jobId: string; findingId: string; ownerId: string; key: string };
+type Authority = { environment: 'test' | 'live'; workflowRunId: string; targetVersion: string; baseline: Artifact; suiteDigest: string; findingKey: string; hold: number; secrets: string[]; digest: string };
+/** Fresh owner, credential, binding and immutable artifact lookup; never accept a scenario or legacy finding evidence. */
+export async function loadRerunAuthority(db: AgentTransactionalSql, request: RerunRequest): Promise<Authority> {
+ const r = (await db.query<{ customer_id: string; environment: 'test' | 'live'; state: string; is_mock: boolean; workflow_run_id: string; package: string; neon_branch_id: string | null; ciphertext: string; target_revision: string; rerun_operation_micro_usd: string; suite_digest: string; body: Artifact; finding_key: string; rerun_of_finding_id: string | null }>(`SELECT j.customer_id,j.environment,j.state,j.is_mock,j.workflow_run_id,j.package,j.neon_branch_id,
+ c.ciphertext,b.target_revision,b.rerun_operation_micro_usd,a.suite_digest,a.body,f.finding_key,f.rerun_of_finding_id
+ FROM jobs j JOIN job_credentials c ON c.job_id=j.id JOIN workflow_integration.bindings b ON b.job_id=j.id
+ JOIN workflow_integration.rich_artifacts a ON a.job_id=j.id AND a.tenant_id=j.customer_id AND a.environment=j.environment
+ JOIN findings f ON f.job_id=j.id AND f.id=$2 WHERE j.id=$1 AND j.customer_id=$3`,[request.jobId,request.findingId,request.ownerId])).rows[0];
+ if (!r) return refuse('Job or original finding unavailable',404);
+ if (r.state !== 'delivered' || r.is_mock || !r.workflow_run_id || !r.ciphertext || !r.target_revision || r.rerun_of_finding_id) return refuse();
+ const b = r.body;
+ if (!['text_eval','workflow_eval'].includes(r.package) || !b || b.appendedPack || !['rich_text.v1','rich_text_remediation.v1','rich_calendar.v1'].includes(b.format)) return refuse('Unsupported scope; trace and appended-pack reruns require a separate integration');
+ if ((r.package === 'workflow_eval') !== (b.format === 'rich_calendar.v1') || b.suite.scenarios.length !== 12 || (b.suite.digest ?? b.suite.hash) !== r.suite_digest || !b.run.runId || !b.investigation.findings.some(f=>f.id===r.finding_key)) return refuse('Rich baseline association refused');
+ if (r.package === 'workflow_eval' && (!r.neon_branch_id || b.run.branchId !== r.neon_branch_id)) return refuse('Original Calendar branch unavailable; no replacement branch will be created');
+ const hold=Number(r.rerun_operation_micro_usd);
+ if (!Number.isSafeInteger(hold) || hold<=0) return refuse('Authorized rerun budget binding required');
+ // The target hash is recalculated by rich-services before every target resolution.
+ const loaded = await getJobWithDecryptedCredentials(request.jobId);
+ if (!loaded || loaded.job.customerId !== request.ownerId || loaded.job.environment !== r.environment) return refuse();
+ const secrets=Object.values(loaded.credentials).filter((v):v is string=>typeof v==='string');
+ if (containsSecret(canonicalJson(b),secrets)) return refuse();
+ const targetVersion=createHash('sha256').update(JSON.stringify({endpoint:{...('endpoint' in loaded.intake ? loaded.intake.endpoint : {}),apiKey:undefined},revision:r.target_revision,credentialCiphertext:r.ciphertext})).digest('hex');
+ return {environment:r.environment,workflowRunId:r.workflow_run_id,targetVersion,baseline:b,suiteDigest:r.suite_digest,findingKey:r.finding_key,hold,secrets,
+ digest:hash({owner:request.ownerId,environment:r.environment,workflow:r.workflow_run_id,targetVersion,branch:r.neon_branch_id,baseline:b,hold})};
+}
+type RichApi = Awaited<ReturnType<typeof createRichWorkflowServices>>;
+/** Concrete adapters: both engines execute the retained full frozen12 (not an invented one-case suite).
+ * Reproduction/investigator claims are never copied from the original finding. */
+export async function runRichRerun(api: Pick<RichApi,'text'|'calendar'>, ctx: ServiceContext, a: Authority, operationId: string) {
+ if (a.baseline.format === 'rich_calendar.v1') {
+  const suiteId=operationId;
+  const suite=await api.calendar.freezeSuite(ctx,{suiteId});
+  if (suite.hash!==a.suiteDigest || canonicalJson(suite)!==canonicalJson(a.baseline.suite)) return refuse();
+  const run=await api.calendar.runSuite(ctx,{suiteId,operationId,versionLabel:a.baseline.run.versionLabel ?? 'default'});
+  return {format:'rich_calendar_rerun.v1',suite,run,limitations:['Full frozen12 rerun. Independent reproduction and remediation were not performed.']};
+ }
+ const suite=await api.text.getSuite(ctx,a.suiteDigest);
+ if (suite.digest!==a.suiteDigest || canonicalJson(suite)!==canonicalJson(a.baseline.suite)) return refuse();
+ const run=await api.text.rerun(ctx,{suiteDigest:a.suiteDigest,baselineRunId:a.baseline.run.runId,runId:operationId});
+ return {format:'rich_text_rerun.v1',suite,run,limitations:['Full frozen12 rerun. Objective/rubric/infrastructure outcomes remain distinct; independent reproduction and remediation were not performed.']};
+}
+/** Committed claims are never leased/taken over. Crash before/after dispatch is explicitly ambiguous. */
+export async function executeRerun(db: AgentTransactionalSql, request: RerunRequest,
+ deps: { authority?: typeof loadRerunAuthority; context?: typeof makeServiceContext; services?: typeof createRichWorkflowServices; check?: (ctx: ServiceContext)=>Promise<void> } = {}) {
+ if (!/^[A-Za-z0-9_.:-]{8,128}$/.test(request.key)) return refuse('Idempotency-Key required (8-128 safe ASCII characters)',400);
+ const authorize=()=> (deps.authority ?? loadRerunAuthority)(db,request);
+ const a=await authorize(), inputDigest=hash({finding:request.findingId,contract:'rich_rerun.v1'});
+ const operationId=`rerun:${hash({job:request.jobId,key:request.key})}`;
+ const claim=await db.transaction(async tx=>{
+  await tx.query('SELECT id FROM jobs WHERE id=$1 FOR UPDATE',[request.jobId]);
+  const old=(await tx.query<{input_digest:string;authority_digest:string;state:string;result:unknown}>('SELECT input_digest,authority_digest,state,result FROM workflow_integration.finding_reruns WHERE job_id=$1 AND operation_key=$2',[request.jobId,request.key])).rows[0];
+  if(old){if(old.input_digest!==inputDigest || old.authority_digest!==a.digest) return refuse('Idempotency key input or authority changed'); return {fresh:false,...old};}
+  // Serialize admission against all finding keys and all reruns for this job.
+  const usage=(await tx.query<{n:string;held:string}>(`SELECT count(*) FILTER (WHERE finding_id=$2) AS n,coalesce(sum(hold_micro_usd),0) AS held FROM workflow_integration.finding_reruns WHERE job_id=$1`,[request.jobId,request.findingId])).rows[0];
+  const legacy=(await tx.query<{n:string}>('SELECT count(*) AS n FROM findings WHERE job_id=$1 AND rerun_of_finding_id=$2',[request.jobId,request.findingId])).rows[0];
+  if(Number(usage.n)+Number(legacy.n)>=3) return refuse('Re-run limit reached (including pending operations)');
+  const budget=(await tx.query<{spent:string;reserved:string;cap:number}>(`SELECT coalesce((SELECT sum(micro_usd) FROM costs WHERE job_id=$1),0) AS spent,coalesce((SELECT sum(micro_usd) FROM budget_reservations WHERE job_id=$1 AND released_at IS NULL),0) AS reserved`,[request.jobId])).rows[0];
+  const cap=JOB_BUDGET_MICRO_USD[a.baseline.format==='rich_calendar.v1'?'workflow_eval':'text_eval'];
+  if(Number(budget.spent)+Number(budget.reserved)+Number(usage.held)+a.hold>cap) return refuse('Re-run budget exhausted');
+  await tx.query(`INSERT INTO workflow_integration.finding_reruns(job_id,operation_key,operation_id,finding_id,input_digest,authority_digest,hold_micro_usd,state) VALUES($1,$2,$3,$4,$5,$6,$7,'pending')`,[request.jobId,request.key,operationId,request.findingId,inputDigest,a.digest,a.hold]);
+  return {fresh:true,state:'pending',result:null};
+ });
+ if(!claim.fresh && containsSecret(canonicalJson(claim.result),a.secrets)) return refuse();
+ if(!claim.fresh) return {operationId,state:claim.state,result:claim.result,replayed:true};
+ let api: RichApi | undefined;
+ try {
+  if((await authorize()).digest!==a.digest) return refuse();
+  const ctx=await (deps.context ?? makeServiceContext)(request.jobId);
+  ctx.budgetMicroUsd=Math.min(ctx.budgetMicroUsd,a.hold);
+  if(deps.check) await deps.check(ctx); else {
+   const loaded=await getJobWithDecryptedCredentials(request.jobId);
+   if(!loaded || !('endpoint' in loaded.intake)) return refuse();
+   if(!(await (await getEvalServices()).checkTarget(ctx,loaded.intake.endpoint)).ok) return refuse('Target policy refused');
+  }
+  api=await (deps.services ?? createRichWorkflowServices)(ctx,{workflowRunId:a.workflowRunId,rerun:{ownerId:request.ownerId,targetVersion:a.targetVersion}});
+  await ctx.recordProgress('finding_rerun',`Re-run ${operationId} started; original baseline retained.`);
+  const outcome=await runRichRerun(api,ctx,a,operationId);
+  const report = {summary:`Re-run ${operationId} of ${request.findingId}; original baseline ${a.baseline.run.runId} retained.`,
+   markdown:`Re-run ${operationId} uses suite ${a.suiteDigest} and target version ${a.targetVersion}. Full structured outcomes are retained in this separate result. Independent reproduction and fix verification are unassessed.`};
+  const result={report,operationId,originalFindingId:request.findingId,findingKey:a.findingKey,baselineRunId:a.baseline.run.runId,suiteDigest:a.suiteDigest,targetVersion:a.targetVersion,...outcome};
+  if(containsSecret(canonicalJson(result),a.secrets)) return refuse();
+  await db.query(`UPDATE workflow_integration.finding_reruns SET state='completed',result=$3::jsonb WHERE job_id=$1 AND operation_key=$2 AND state='pending'`,[request.jobId,request.key,canonicalJson(result)]);
+  await ctx.recordProgress('finding_rerun',`Re-run ${operationId} completed; separate rich result retained.`);
+  return {operationId,state:'completed',result,replayed:false};
+ } catch {
+  // Completion acknowledgement may have been lost. Never erase a committed result.
+  await db.query(`UPDATE workflow_integration.finding_reruns SET state='needs_operator' WHERE job_id=$1 AND operation_key=$2 AND state='pending'`,[request.jobId,request.key]).catch(()=>undefined);
+  return {operationId,state:'needs_operator',result:null,replayed:false};
+ } finally {await api?.dispose();}
+}
+export const rerunRichFinding = (request:RerunRequest)=>executeRerun(workflowSql(),request);
+/** Private report appendices. Ownership is checked in SQL even after transport authorization. */
+export async function readRichRerunsForOwner(jobId:string,ownerId:string,findingId?:string) {
+ const rows=await workflowSql().query<{operation_id:string;finding_id:string;state:string;result:unknown}>(`SELECT r.operation_id,r.finding_id,r.state,r.result FROM workflow_integration.finding_reruns r JOIN jobs j ON j.id=r.job_id WHERE r.job_id=$1 AND j.customer_id=$2 AND ($3::uuid IS NULL OR r.finding_id=$3) ORDER BY r.created_at,r.operation_id`,[jobId,ownerId,findingId??null]);
+ const loaded=await getJobWithDecryptedCredentials(jobId);
+ const secrets=Object.values(loaded?.credentials??{}).filter((v):v is string=>typeof v==='string');
+ if(rows.rows.some(r=>containsSecret(canonicalJson(r.result),secrets))) return refuse();
+ return rows.rows.map(r=>({operationId:r.operation_id,originalFindingId:r.finding_id,state:r.state,result:r.result}));
+}
diff --git a/apps/web/src/server/structured-progress-inventory.ts b/apps/web/src/server/structured-progress-inventory.ts
new file mode 100644
index 0000000..11ffcb0
--- /dev/null
+++ b/apps/web/src/server/structured-progress-inventory.ts
@@ -0,0 +1,65 @@
+import "server-only";
+import { inventoryPlanSchema, type InventoryPlan } from "./structured-progress";
+import { ChatError, type ConversationSqlExecutor } from "@ae/core/reporting/chat/index";
+
+const invalid = (): never => { throw new ChatError("invalid_snapshot"); };
+const kinds = { text_design: "design", text_run: "run_result", text_investigation: "investigation",
+  calendar_run: "calendar_run", calendar_investigation: "calendar_investigation" } as const;
+
+/** Server Workflow composition helper, NEVER an HTTP handler. Caller supplies the
+ * authorized tenant/job/environment and typed associations captured at rich-factory
+ * boundary. tx MUST be a pinned write transaction. Call after acknowledged core
+ * operations and again after every included job/cost/acquisition update. This does
+ * not dispatch any operation and cannot discover phases from arbitrary value JSON.
+ * No current Track A Workflow invokes this: see PREREQUISITES.md. */
+export async function publishStructuredInventory(tx: ConversationSqlExecutor,
+  scope: { tenantId: string; jobId: string; environment: "test" | "live" },
+  expectedRevision: number | null, input: InventoryPlan): Promise<number> {
+  const plan = inventoryPlanSchema.parse(input);
+  const jobs = await tx.query<{ environment: string; package: string }>(
+    "SELECT environment, package FROM jobs WHERE id = $1 AND customer_id = $2 FOR UPDATE", [scope.jobId, scope.tenantId]);
+  const job = jobs.rows[0];
+  if (!job || job.environment !== scope.environment || job.package === "trace_audit") invalid();
+  if (!["workflow_eval", "text_eval", "version_comparison"].includes(job.package)) invalid();
+  if (new Set(plan.checkpoints.map(p => JSON.stringify([p.key.kind, p.key.id]))).size !== plan.checkpoints.length
+    || new Set(plan.acquisitionTaskIds).size !== plan.acquisitionTaskIds.length) invalid();
+  for (const p of plan.checkpoints) {
+    if (p.key.jobId !== scope.jobId || p.key.kind !== kinds[p.format]
+      || (job.package === "workflow_eval" ? !p.format.startsWith("calendar_") : p.format.startsWith("calendar_"))) invalid();
+    if (p.format.endsWith("_run") || p.format === "calendar_investigation") {
+      if (!p.runId || !p.suiteDigest || !p.scenarioIds?.length || new Set(p.scenarioIds).size !== p.scenarioIds.length) invalid();
+    }
+    if (p.format.startsWith("calendar_") && !p.branchId) invalid();
+    // Planned identities MUST come from exact rich-factory canonical inputs. Missing
+    // rows remain planned blockers. Existing rows must bind the identical digest.
+    const actual = await tx.query<{ input_digest: string }>(
+      "SELECT input_digest FROM text_integration.checkpoints WHERE job_id = $1 AND kind = $2 AND id = $3",
+      [scope.jobId, p.key.kind, p.key.id]);
+    if (actual.rows.length > 1 || (actual.rows[0] && actual.rows[0].input_digest !== p.key.inputDigest)) invalid();
+  }
+  for (const taskId of plan.acquisitionTaskIds) {
+    const actual = await tx.query<{ task_id: string }>(
+      "SELECT task_id FROM evaluation_data_persistence.tasks WHERE tenant_id = $1 AND job_id = $2 AND task_id = $3",
+      [scope.tenantId, scope.jobId, taskId]);
+    if (actual.rows.length > 1) invalid();
+  }
+  const existing = (await tx.query<{ tenant_id: string; environment: string; revision: string | number; plan: unknown }>(
+    "SELECT tenant_id, environment, revision, plan FROM structured_progress.inventory WHERE job_id = $1 FOR UPDATE", [scope.jobId])).rows[0];
+  if (existing) {
+    if (existing.tenant_id !== scope.tenantId || existing.environment !== scope.environment
+      || expectedRevision === null || !Number.isSafeInteger(expectedRevision) || String(existing.revision) !== String(expectedRevision)) invalid();
+    const old = inventoryPlanSchema.parse(existing.plan);
+    // Previously frozen associations are immutable. Revision may append newly planned
+    // operations/tasks; it cannot silently retarget or remove prior evidence.
+    for (const p of old.checkpoints) if (!plan.checkpoints.some(n => JSON.stringify(n) === JSON.stringify(p))) invalid();
+    for (const id of old.acquisitionTaskIds) if (!plan.acquisitionTaskIds.includes(id)) invalid();
+  } else if (expectedRevision !== null) invalid();
+  const next = existing ? Number(existing.revision) + 1 : 0;
+  if (!Number.isSafeInteger(next)) invalid();
+  await tx.query(`INSERT INTO structured_progress.inventory(tenant_id, job_id, environment, revision, plan, observed_at)
+    VALUES ($1, $2, $3, $4, $5::jsonb, clock_timestamp())
+    ON CONFLICT (job_id) DO UPDATE SET revision = EXCLUDED.revision, plan = EXCLUDED.plan,
+      observed_at = GREATEST(structured_progress.inventory.observed_at, EXCLUDED.observed_at)`,
+    [scope.tenantId, scope.jobId, scope.environment, next, JSON.stringify(plan)]);
+  return next;
+}
diff --git a/apps/web/src/server/structured-progress.ts b/apps/web/src/server/structured-progress.ts
new file mode 100644
index 0000000..737b2b8
--- /dev/null
+++ b/apps/web/src/server/structured-progress.ts
@@ -0,0 +1,69 @@
+import "server-only";
+import { z } from "zod";
+import { createDurableProgressProjection, createDurableProgressReader, type ProjectionPlan } from "@ae/core/reporting/chat/projection/index";
+import { ChatError, type ChatScope, type ProgressSnapshot, type ConversationSqlExecutor } from "@ae/core/reporting/chat/index";
+import { PostgresTextCheckpointStore } from "@ae/core/evals/integration/checkpoints";
+import { createPostgresEvaluationDataStore } from "@ae/core/evals/data/postgres-store";
+
+const invalid = (): never => { throw new ChatError("invalid_snapshot"); };
+const id = z.string().min(1).max(4096);
+const digest = z.string().regex(/^[a-f0-9]{64}$/);
+export const inventoryPlanSchema = z.strictObject({
+  checkpoints: z.array(z.strictObject({
+    key: z.strictObject({ jobId: id, kind: id, id, inputDigest: digest }),
+    phase: z.enum(["planning", "running", "investigating"]),
+    format: z.enum(["text_design", "text_run", "calendar_run", "text_investigation", "calendar_investigation"]),
+    runId: id.optional(), suiteDigest: id.optional(), branchId: id.optional(), scenarioIds: z.array(id).min(1).max(200).optional(),
+  })).max(100),
+  acquisitionTaskIds: z.array(id).max(100),
+}).refine(plan => (plan.checkpoints.length > 0 || plan.acquisitionTaskIds.length > 0)
+  && plan.checkpoints.every(p => p.phase === (p.format === "text_design" ? "planning" : p.format.endsWith("_run") ? "running" : "investigating")));
+export type InventoryPlan = z.infer<typeof inventoryPlanSchema>;
+type Job = { id: string; customer_id: string; state: string; updated_at: Date | string };
+type Inventory = { tenant_id: string; job_id: string; environment: "test" | "live"; revision: string | number;
+  plan: unknown; observed_at: Date | string };
+const iso = (value: Date | string) => new Date(value).toISOString();
+
+/** Called ONLY inside the request's authorized pinned REPEATABLE READ read-only transaction.
+ * The caller already obtained job and current secrets in that same transaction. No writes,
+ * retries, provider calls or arbitrary checkpoint discovery are possible here. */
+export async function readStructuredProgress(tx: ConversationSqlExecutor, scope: ChatScope, job: Job,
+  key: Buffer, knownSecrets: string[], appObservedAt = iso(job.updated_at)): Promise<ProgressSnapshot | null> {
+  const jobs = await tx.query<{ package: string; environment: string }>(
+    "SELECT package, environment FROM jobs WHERE id = $1 AND customer_id = $2", [job.id, job.customer_id]);
+  const current = jobs.rows[0];
+  if (!current || scope.jobId !== job.id) invalid();
+  if (current.package === "trace_audit") return null;
+  if (!["text_eval", "workflow_eval", "version_comparison"].includes(current.package)) invalid();
+  const load = async () => (await tx.query<Inventory>(
+    "SELECT tenant_id, job_id, environment, revision, plan, observed_at FROM structured_progress.inventory WHERE tenant_id = $1 AND job_id = $2",
+    [job.customer_id, job.id])).rows[0];
+  const inventory = await load();
+  if (!inventory || inventory.tenant_id !== job.customer_id || inventory.job_id !== job.id || inventory.environment !== current.environment
+    || !/^(0|[1-9][0-9]*)$/.test(String(inventory.revision)) || !Number.isSafeInteger(Number(inventory.revision))) invalid();
+  const parsed = inventoryPlanSchema.safeParse(inventory.plan);
+  const parsedPlan = parsed.success ? parsed.data : invalid();
+  const plan: ProjectionPlan = { ...parsedPlan, scope, environment: inventory.environment };
+  if (plan.checkpoints.some(p => p.key.jobId !== job.id || (current.package === "workflow_eval" ? !p.format.startsWith("calendar_") : p.format.startsWith("calendar_")))) invalid();
+  const access = { authenticate: async () => ({ subjectId: scope.subjectId }),
+    resolveAuthorizedJob: async (caller: { subjectId: string }, jobId: string) =>
+      caller.subjectId === scope.subjectId && jobId === job.id ? scope : null };
+  const readOnlyDb = { query: tx.query.bind(tx), transaction: async <T>(_run: unknown): Promise<T> => invalid() };
+  const checkpoints = new PostgresTextCheckpointStore(readOnlyDb);
+  const acquisition = createPostgresEvaluationDataStore(readOnlyDb, { tenantId: job.customer_id, jobId: job.id, knownSecrets });
+  const reader = createDurableProgressReader({ withRead: async (requested, read) => {
+    const recheck = await load();
+    if (!recheck || JSON.stringify(requested) !== JSON.stringify(plan) || String(recheck.revision) !== String(inventory.revision)
+      || JSON.stringify(recheck.plan) !== JSON.stringify(inventory.plan) || iso(recheck.observed_at) !== iso(inventory.observed_at)) invalid();
+    // All dates come from stored material, never request time. Acquisition-only revisions
+    // must touch the inventory watermark in the producer transaction (see prerequisites).
+    const observedAt = iso(inventory.observed_at);
+    if (Date.parse(iso(job.updated_at)) > Date.parse(observedAt) || Date.parse(iso(appObservedAt)) > Date.parse(observedAt)) invalid();
+    return read({ observedAt, job: { jobId: job.id, status: job.state as ProgressSnapshot["status"], updatedAt: iso(job.updated_at) },
+      // App ledger supports ai_gateway as well as naive. Its complete safe rows are merged
+      // by progress-chat.ts below; never mislabel them as measured core naive_session costs.
+      costs: [], unknownCosts: true, checkpoints, acquisition });
+  } });
+  return createDurableProgressProjection({ access, resolve: async () => plan, reader,
+    referenceKey: key.toString("hex"), knownSecrets }).read(scope);
+}
