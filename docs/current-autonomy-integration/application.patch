+++ b/apps/web/src/server/rich-comparison.ts
@@ -0,0 +1,165 @@
+import { upsertWorkflowCost } from './workflow-costs';
+import { assertAutonomousPaidContext, runAutonomousTarget, type AutonomousPaidContext, type PaidMonitor } from './autonomous-paid';
+import type { createTrustedJudgeResolver } from './rich-judge';
+import 'server-only';
+import { createHash } from 'node:crypto';
+import { z } from 'zod';
+import { containsSecret } from '@ae/core/agents/redact';
+import { MONITORING_RUN_BUDGET_MICRO_USD, JOB_BUDGET_MICRO_USD } from '@ae/core/contracts/index';
+import type { ServiceContext } from '@ae/core/contracts/services';
+import type { AgentTransactionalSql } from '@ae/core/agents/postgres-ports';
+import { ROLE_DEFINITIONS } from '@ae/core/agents/roles';
+import { PostgresBudgetLedger } from '@ae/core/agents/postgres-ports';
+import type { AgentTaskRunner } from '@ae/core/agents/session-service';
+import { PostgresTextCheckpointStore } from '@ae/core/evals/integration/checkpoints';
+import { createTextEvaluationServices } from '@ae/core/evals/integration/services';
+import { createComparisonMonitoringService } from '@ae/core/monitoring/composition';
+import type { ComparisonRequest, ComparisonSuite, RichRunArtifact } from '@ae/core/monitoring/composition';
+import { createTextComparisonAdapter, createCalendarComparisonAdapter, createRetainedComparisonAdapter } from '@ae/core/monitoring/adapters';
+import { canonicalJson } from '@ae/core/evals/text/index';
+import type { createCalendarEvaluationServices } from '@ae/core/evals/calendar-integration/index';
+import type { TextTargetPort } from '@ae/core/evals/types';
+
+const id = z.string().min(1).max(128).regex(/^[A-Za-z0-9_.:-]+$/);
+const version = z.object({ version: id, targetId: id, branchId: id.nullable(), configurationDigest: z.string().regex(/^[a-f0-9]{64}$/), endpointSlot: z.enum(['endpoint', 'endpointA', 'endpointB']), endpointOverride:z.object({url:z.string().url().max(4096),model:z.string().min(1).max(256)}).strict().optional() }).strict();
+export const comparisonBindingSchema = z.object({
+  suiteId: id, scope: z.enum(['base12', 'augmented']), scenarioIds: z.array(id),
+  baseline: version, current: version,
+  // Reviewed policy: reservation per outbound target call; unmeasured reservations remain held.
+  targetCallMicroUsd: z.number().int().positive().safe(), jobCapMicroUsd: z.number().int().positive().safe(),
+}).strict();
+export type ComparisonBinding = z.infer<typeof comparisonBindingSchema>;
+export const comparisonDigest = (v: unknown) => createHash('sha256').update(canonicalJson(v)).digest('hex');
+const refused = (): never => { throw new Error('rich_comparison_refused'); };
+export interface ComparisonPrincipal { tenantId: string; environment: 'test' | 'live' }
+export interface ComparisonRuntime {
+  autonomous?: AutonomousPaidContext;
+  runner: AgentTaskRunner;
+  judge?(binding: ComparisonBinding['current'], monitor?: PaidMonitor): ReturnType<typeof createTrustedJudgeResolver>;
+  knownSecrets: readonly string[];
+  verify(jobId: string, binding: ComparisonBinding, retained: RichRunArtifact): Promise<{scenarioIds:string[]}>;
+  /** Called again immediately before every target operation; closure loads decrypted canonical intake. */
+  target(binding: ComparisonBinding['current']): Promise<TextTargetPort>;
+  /** Calendar factory must guard every outbound complete() with guard(), and verify branch ownership. */
+  calendar?(binding: ComparisonBinding['current'], guard: (operation: string) => Promise<void>, checkpoints: PostgresTextCheckpointStore): Promise<ReturnType<typeof createCalendarEvaluationServices>>;
+}
+/** Concrete SQL-backed app coordinator. Runtime contains transports, not authorization decisions. */
+export function createRichComparisonApp(sql: AgentTransactionalSql, runtime: ComparisonRuntime) {
+  if(runtime.autonomous) assertAutonomousPaidContext(runtime.autonomous);
+  const checkpoints = new PostgresTextCheckpointStore(sql);
+  async function authority(principal: ComparisonPrincipal, jobId: string, subscriptionId?: string) {
+    const row = (await sql.query<{ customer_id: string; environment: string; state: string; package: keyof typeof JOB_BUDGET_MICRO_USD; is_mock: boolean; is_internal_fixture: boolean; suite: ComparisonSuite; retained: RichRunArtifact; binding: unknown; binding_digest: string }>(`SELECT j.customer_id,j.environment,j.state,j.package,j.is_mock,c.is_internal_fixture,b.suite,b.retained,b.binding,b.binding_digest
+      FROM jobs j JOIN customers c ON c.id=j.customer_id JOIN workflow_comparison.bindings b ON b.job_id=j.id
+      WHERE j.id=$1 AND j.customer_id=$2 AND j.environment=$3`, [jobId,principal.tenantId,principal.environment])).rows[0];
+    if (!row || row.is_mock || row.state !== 'delivered' || comparisonDigest({suite:row.suite,retained:row.retained,binding:row.binding}) !== row.binding_digest) return refused();
+    if(runtime.knownSecrets.some(s=>s.length<4) || containsSecret(canonicalJson(row),runtime.knownSecrets)) return refused();
+    if(runtime.autonomous) {
+      await runtime.autonomous.guard(undefined,sql);
+      if(runtime.autonomous.job.jobId!==jobId || runtime.autonomous.job.customerId!==principal.tenantId || runtime.autonomous.job.environment!==principal.environment) refused();
+    }
+    const binding = comparisonBindingSchema.parse(row.binding);
+    const canonical = await runtime.verify(jobId,binding,row.retained);
+    if (binding.jobCapMicroUsd > JOB_BUDGET_MICRO_USD[row.package] || !JOB_BUDGET_MICRO_USD[row.package]
+      || canonicalJson([...canonical.scenarioIds].sort()) !== canonicalJson([...binding.scenarioIds].sort())) return refused();
+    // Full inventory stays visible even when execution is refused. Explicit base12 never means pack coverage.
+    if (binding.scope !== 'base12' || binding.scenarioIds.length !== 12 || new Set(binding.scenarioIds).size !== 12
+      || canonicalJson([...binding.scenarioIds].sort()) !== canonicalJson(row.suite.scenarios.map(s=>s.id).sort())) return refused();
+    if (subscriptionId) {
+      const sub = await sql.query(`SELECT id FROM monitoring_subscriptions WHERE id=$1 AND job_id=$2 AND customer_id=$3 AND environment=$4 AND status='active' AND stripe_subscription_id IS NOT NULL`, [subscriptionId,jobId,principal.tenantId,principal.environment]);
+      if (!sub.rows.length) return refused();
+    }
+    const paid = await sql.query(`SELECT id FROM payments WHERE job_id=$1 AND environment=$2 AND status IN ('paid','captured') AND kind='one_time'`,[jobId,principal.environment]);
+    if (!paid.rows.length) return refused();
+    return { ...row, binding };
+  }
+  async function compare(principal: ComparisonPrincipal, ctx: ServiceContext, request: ComparisonRequest, subscriptionId?: string) {
+    if ((request.mode === 'monitoring') !== Boolean(subscriptionId)) return refused();
+    const a = await authority(principal,ctx.jobId,subscriptionId);
+    if (ctx.environment !== principal.environment || request.baselineVersion !== a.binding.baseline.version || request.currentVersion !== a.binding.current.version) return refused();
+    const monitor:PaidMonitor|undefined=subscriptionId?{key:`monitor:${subscriptionId}:${request.operationId}`,capMicroUsd:MONITORING_RUN_BUDGET_MICRO_USD}:undefined;
+    if(runtime.autonomous && a.binding.targetCallMicroUsd!==runtime.autonomous.targetReservationMicroUsd) return refused();
+    const immutable = { tenantId:principal.tenantId, environment:principal.environment, jobId:ctx.jobId, bindingDigest:a.binding_digest, request, subscriptionId:subscriptionId??null };
+    // Stable tick/request identity is committed before factory construction, agent calls, or targets.
+    const tick = {jobId:ctx.jobId,kind:'app_rich_tick',id:request.operationId,inputDigest:comparisonDigest(immutable)};
+    const claim = await checkpoints.claim(tick);
+    if (claim.state === 'completed') return claim.value;
+    if (claim.state !== 'claimed') throw new Error('rich_tick_needs_reconciliation');
+    const reauthorize = async () => { const latest = await authority(principal,ctx.jobId,subscriptionId); if(latest.binding_digest !== a.binding_digest) refused(); };
+    try {
+      const costs = async (operationId: string) => {
+        const rows = await sql.query<{ id:string; source:string; micro_usd:string|number }>('SELECT id,source,micro_usd FROM workflow_comparison.costs WHERE job_id=$1 AND operation_id=$2',[ctx.jobId,operationId]);
+        return {costs:rows.rows.map(r=>({id:r.id,source:r.source,microUsd:Number(r.micro_usd),measured:true as const})),unknownCosts:['target_provider_usage_unmeasured','hosting_unmeasured','investigation_usage_not_in_ledger_is_unknown','retained_baseline_and_suite_design_costs_not_fully_measured']};
+      };
+      const adapter = async (v:ComparisonBinding['current']) => {
+        const guard = async (operation:string) => {
+          await reauthorize();
+          if(runtime.autonomous) return refused(); // autonomous targets use the durable dispatch wrapper below
+          const period=process.env.NAIVE_BUDGET_PERIOD_ID; if(!period || !/^[A-Za-z0-9_-]+$/.test(period))return refused();
+          const reserved = await new PostgresBudgetLedger(sql).reserve({reservationId:`cmp:${comparisonDigest({immutable,v,operation})}`,jobId:ctx.jobId,amountMicroUsd:a.binding.targetCallMicroUsd,scopes:[{key:`agent:evaluation_engineer:${period}`,capMicroUsd:ROLE_DEFINITIONS.evaluation_engineer.periodCapMicroUsd},{key:`job:${ctx.jobId}`,capMicroUsd:a.binding.jobCapMicroUsd}, ...(subscriptionId?[{key:`monitor:${subscriptionId}:${request.operationId}`,capMicroUsd:MONITORING_RUN_BUDGET_MICRO_USD}]:[])]});
+          if (!reserved.ok) refused();
+          // No automatic settlement/release: target transport supplies no measured receipt. Hold for reconciliation.
+        };
+        if ('digest' in a.suite) {
+          const suite = a.suite;
+          const operationId = comparisonDigest([principal.tenantId,ctx.jobId,request.operationId,v===a.binding.baseline?'baseline':'current']);
+          const scopedCtx = {...ctx, recordCost:async (cost:Parameters<ServiceContext['recordCost']>[0])=>{
+            const key=String(cost.meta?.idempotencyKey??''); if(!key || !Number.isSafeInteger(cost.microUsd) || cost.microUsd<0) refused();
+            await sql.transaction(async tx=>{
+              await tx.query('INSERT INTO workflow_comparison.costs(job_id,operation_id,source,id,micro_usd) VALUES($1,$2,$3,$4,$5) ON CONFLICT DO NOTHING',[ctx.jobId,operationId,cost.source,key,cost.microUsd]);
+              const same=await tx.query('SELECT id FROM workflow_comparison.costs WHERE job_id=$1 AND operation_id=$2 AND source=$3 AND id=$4 AND micro_usd=$5',[ctx.jobId,operationId,cost.source,key,cost.microUsd]);
+              if(!same.rows.length) refused();
+            });
+            // Deliver through the app's keyed sink after the local transaction commits.
+            // On failure core retains the cost and the outer tick stays ambiguous.
+            await upsertWorkflowCost(sql, { ...cost, jobId: ctx.jobId });
+          }};
+          const services = createTextEvaluationServices({checkpoints,runner:runtime.autonomous ? (monitor ? runtime.autonomous.runnerForMonitor(monitor) : runtime.autonomous.runner) : runtime.runner,resolveApprovedSuite:async()=>suite,resolve:async()=>{
+            await reauthorize();
+            return {job:runtime.autonomous?.job ?? {jobId:ctx.jobId,customerId:principal.tenantId,environment:ctx.environment,package:'text_eval' as const,isFixture:a.is_internal_fixture,linkedRetestOf:null,quoteVersion:null},targetVersion:v.version,knownSecrets:runtime.knownSecrets,judge:runtime.judge?.(v,monitor) ?? null,
+              target:{send:async req=>{
+                if(runtime.autonomous) {
+                  await reauthorize();
+                  return runAutonomousTarget(runtime.autonomous,{job:runtime.autonomous.job,monitor,
+                    operationId:`autonomous-comparison:${ctx.jobId}:${request.operationId}:${v===a.binding.baseline?'baseline':'current'}:${req.runId}:${req.scenarioId}`,
+                    input:{request:req,version:v,bindingDigest:a.binding_digest}},async()=>{await reauthorize();return (await runtime.target(v)).send(req);});
+                }
+                await guard(`${req.runId}:${req.scenarioId}`);return (await runtime.target(v)).send(req);
+              }}};
+          }});
+          return createTextComparisonAdapter({services,ctx:scopedCtx,suiteDigest:suite.digest,readCosts:costs});
+        }
+        if (runtime.autonomous) return refused(); // Calendar lacks stable target run identity
+        if (!runtime.calendar) return refused();
+        const services=await runtime.calendar(v,guard,checkpoints);
+        // Calendar checkpoint identity includes target/branch. Use distinct references to identical frozen content.
+        const suiteId=comparisonDigest({suiteId:a.binding.suiteId,version:v.version,targetId:v.targetId,branchId:v.branchId});
+        await services.freezeSuite(ctx,{suiteId});
+        return createCalendarComparisonAdapter({services,ctx,suiteId,readCosts:costs});
+      };
+      const service = createComparisonMonitoringService({checkpoints,resolve:async()=>{
+        await reauthorize();
+        return {tenantId:principal.tenantId,jobId:ctx.jobId,environment:ctx.environment,isFixture:a.is_internal_fixture,suite:a.suite,scenarioIds:a.binding.scenarioIds,knownSecrets:runtime.knownSecrets,
+          baseline:{...a.binding.baseline,adapter:request.mode==='monitoring'?createRetainedComparisonAdapter(a.retained):await adapter(a.binding.baseline)},
+          current:{...a.binding.current,adapter:await adapter(a.binding.current)}};
+      }});
+      const result = await service.compare(ctx,request);
+      await reauthorize();
+      await checkpoints.complete(tick,claim.token,result); // full rich result + generic alert drafts, never boolean RunResult
+      return result;
+    } catch (error) { await checkpoints.markAmbiguous(tick,claim.token); throw error; }
+  }
+  return {compare,
+    async inventory(principal:ComparisonPrincipal,jobId:string) {
+      const row=await sql.query<{binding:unknown;retained:RichRunArtifact}>(`SELECT b.binding,b.retained FROM workflow_comparison.bindings b JOIN jobs j ON j.id=b.job_id WHERE j.id=$1 AND j.customer_id=$2 AND j.environment=$3`,[jobId,principal.tenantId,principal.environment]);
+      const saved=row.rows[0];if(!saved)return null;
+      const binding=comparisonBindingSchema.parse(saved.binding);
+      const source=await runtime.verify(jobId,binding,saved.retained);
+      const scenarioIds=[...new Set([...binding.scenarioIds,...source.scenarioIds])];
+      return {...binding,scenarioIds,scope:scenarioIds.length===12?binding.scope:'augmented'};
+    },
+    async read(principal:ComparisonPrincipal,jobId:string,operationId:string) {
+      await authority(principal,jobId); // every read reauthenticates canonical ownership/payment, including replay
+      return checkpoints.get({jobId,kind:'app_rich_tick',id:operationId});
+    },
+  };
+}
diff --git a/apps/web/src/server/rich-services.ts b/apps/web/src/server/rich-services.ts
new file mode 100644
index 0000000..931e73e
--- /dev/null
+++ b/apps/web/src/server/rich-services.ts
@@ -0,0 +1,201 @@
+import { assertAutonomousPaidContext, runAutonomousTarget, type AutonomousPaidContext } from './autonomous-paid';
+import { createTrustedJudgeResolver, workflowJudgePolicy, workflowJudgeRuntime, type TrustedJudgeRuntime } from './rich-judge';
+import { deliverRemediationCost } from './rich-remediation';
+import 'server-only';
+import { createHash } from 'node:crypto';
+import { Pool } from '@neondatabase/serverless';
+import type { ServiceContext } from '@ae/core/contracts/services';
+import { IntakeInput } from '@ae/core/contracts/index';
+import { createTextEvaluationServices, PostgresTextCheckpointStore } from '@ae/core/evals/integration/index';
+import { createCalendarEvaluationServices } from '@ae/core/evals/calendar-integration/index';
+import { TrackBBlockedError, TrackBPendingError, toContractCost, createTrackBServices } from '@ae/core/evals/service-adapter';
+import { buildAgentDeps } from './current-agent-deps';
+import { withAgentCostDelivery } from '@ae/core/agents/runtime';
+import { pooledCalendarDatabase } from '@ae/core/simulator/pool';
+import { PostgresBranchLedger } from '@ae/core/simulator/branch-ledger';
+import { PostgresCalendarStore } from '@ae/core/simulator/postgres';
+import { CalendarSimulator } from '@ae/core/simulator/calendar';
+import { createTextTarget } from '@ae/core/targets/text';
+import { platformTarget } from '@ae/core/targets/adapters';
+import type { JobRef } from '@ae/core/evals/types';
+import type { CalendarSuiteInput } from '@ae/core/simulator/workflow/index';
+import { getJobWithDecryptedCredentials } from './job-store';
+import { upsertWorkflowCost } from './workflow-costs';
+import { createRichRemediation } from './rich-remediation';
+import { createWorkflowInventory } from './workflow-inventory';
+import { createApprovedSuiteAdmission } from '@ae/core/evals/integration/approved-suite';
+import { advanceWorkflowData, readWorkflowDataPlan, readWorkflowDataReady } from './workflow-data';
+import { evalServices } from '@ae/core/integration/eval-services';
+
+let applicationPool: Pool | undefined;
+export function workflowSql() {
+  if (!process.env.DATABASE_URL) throw new TrackBBlockedError('needs_operator', 'Application database configuration required.');
+  applicationPool ??= new Pool({ connectionString: process.env.DATABASE_URL, max: 5, connectionTimeoutMillis: 10000,
+    idleTimeoutMillis: 30000, options: '-c statement_timeout=30000 -c lock_timeout=10000' });
+  return pooledCalendarDatabase(applicationPool);
+}
+const refused = (): never => { throw new TrackBBlockedError('needs_operator', 'Canonical Workflow binding unavailable or changed; operator reconciliation required.'); };
+
+/** Internal Workflow authority only; no route accepts this value from a customer body. */
+export async function createRichWorkflowServices(ctx: ServiceContext, authority: { workflowRunId: string; autonomous?: AutonomousPaidContext; judgeRuntime?: TrustedJudgeRuntime; rerun?: { ownerId: string; targetVersion: string } }) {
+  if (authority.autonomous) assertAutonomousPaidContext(authority.autonomous);
+  const sql = authority.autonomous?.sql ?? workflowSql();
+  async function canonical() {
+    const loaded = await getJobWithDecryptedCredentials(ctx.jobId);
+    if (!loaded || !authority.workflowRunId || loaded.job.workflowRunId !== authority.workflowRunId
+      || loaded.job.environment !== ctx.environment || loaded.job.isMock
+      || !(authority.rerun ? loaded.job.state === 'delivered' && loaded.job.customerId === authority.rerun.ownerId : ['planning', 'running', 'investigating'].includes(loaded.job.state))) return refused();
+    const intake = IntakeInput.parse(loaded.intake);
+    if (intake.package !== 'text_eval' && intake.package !== 'workflow_eval') return refused();
+    const binding = await sql.query<{ target_revision: string; reviewed_calendar: CalendarSuiteInput | null; isolation: string | null; remediation_operation_micro_usd: number | string | null; baseline_suite_digest: string | null; baseline_run_id: string | null }>(
+      'SELECT target_revision, reviewed_calendar, isolation, remediation_operation_micro_usd, baseline_suite_digest, baseline_run_id FROM workflow_integration.bindings WHERE job_id=$1', [ctx.jobId]);
+    const b = binding.rows[0];
+    if (!b || !/^[A-Za-z0-9_.:-]{1,128}$/.test(b.target_revision)) return refused();
+    const fixture = await sql.query<{ fixture: boolean }>('SELECT is_internal_fixture AS fixture FROM customers WHERE id=$1', [loaded.job.customerId]);
+    // Quote identity comes from the minted release capability; its current guard rechecks
+    // the complete canonical company request. Other identity fields remain DB-derived.
+    const job: JobRef = { jobId: ctx.jobId, customerId: loaded.job.customerId, package: intake.package,
+      environment: ctx.environment, isFixture: fixture.rows[0]?.fixture === true, linkedRetestOf: loaded.job.retestOfJobId, quoteVersion: authority.autonomous?.job.quoteVersion ?? null };
+    await authority.autonomous?.guard(job,sql);
+    const knownSecrets = Object.values(loaded.credentials).filter((x): x is string => typeof x === 'string');
+    if (knownSecrets.some(s => s.length < 4)) return refused();
+    // The ciphertext changes with credential rotation; hash stays server-only and never enters artifacts.
+    const credentials = await sql.query<{ ciphertext: string }>('SELECT ciphertext FROM job_credentials WHERE job_id=$1', [ctx.jobId]);
+    if (authority.rerun && !credentials.rows[0]?.ciphertext) return refused();
+    const targetVersion = createHash('sha256').update(JSON.stringify({ endpoint: { ...intake.endpoint, apiKey: undefined },
+      revision: b.target_revision, credentialCiphertext: credentials.rows[0]?.ciphertext ?? null })).digest('hex');
+    if (authority.rerun && targetVersion !== authority.rerun.targetVersion) return refused();
+    return { ...loaded, row: loaded.job, intake, job, knownSecrets, targetVersion, binding: { ...b,
+      // PostgreSQL bigint is a string in the actual driver; validate before narrowing.
+      remediation_operation_micro_usd: b.remediation_operation_micro_usd === null ? null : (() => {
+        const amount = Number(b.remediation_operation_micro_usd);
+        if (!Number.isSafeInteger(amount) || amount <= 0) return refused();
+        return amount;
+      })() } };
+  }
+  const judgeRuntime = authority.judgeRuntime ?? workflowJudgeRuntime(authority.rerun ? 'rerun' : 'baseline');
+  const judge = createTrustedJudgeResolver({ autonomous:authority.autonomous, sql, checkpoints: new PostgresTextCheckpointStore(sql), canonical,
+    policy: workflowJudgePolicy(), runtime: { ...judgeRuntime, beforeDispatch: async intent => {
+      if (ctx.budgetMicroUsd <= 0) return refused();
+      await judgeRuntime.beforeDispatch(intent);
+    } }, deliverCost: deliverRemediationCost });
+  const remediationRuntime = authority.judgeRuntime ?? workflowJudgeRuntime('remediation');
+  const remediationJudge = createTrustedJudgeResolver({ autonomous:authority.autonomous, sql, checkpoints: new PostgresTextCheckpointStore(sql), canonical,
+    policy: workflowJudgePolicy(), runtime: { ...remediationRuntime, beforeDispatch: async intent => {
+      if (ctx.budgetMicroUsd <= 0) return refused();
+      await remediationRuntime.beforeDispatch(intent);
+    } }, deliverCost: deliverRemediationCost });
+  const initial = await canonical();
+  const inventory = createWorkflowInventory(sql, { tenantId: initial.job.customerId, jobId: ctx.jobId, environment: ctx.environment });
+  const checkpoints = inventory.wrap(new PostgresTextCheckpointStore(sql));
+  const selectedRunner = authority.autonomous ? authority.autonomous.runner : (await buildAgentDeps()).runner;
+  const runner = withAgentCostDelivery(selectedRunner, { record: async (_key, cost) => upsertWorkflowCost(sql, { ...toContractCost(cost), jobId: cost.jobId }) });
+  const dataScope = { tenantId: initial.job.customerId, jobId: ctx.jobId, environment: ctx.environment, workflowRunId: authority.workflowRunId };
+  const approved = createApprovedSuiteAdmission({ resolve: async (current, suiteDigest) => {
+    if (current.jobId !== ctx.jobId || current.environment !== ctx.environment) return refused();
+    const a = await canonical();
+    if (a.job.package !== 'text_eval') return refused();
+    const ready = await readWorkflowDataReady(sql, dataScope, a.knownSecrets);
+    if (!ready) {
+      if (await readWorkflowDataPlan(sql, dataScope, a.knownSecrets)) throw new TrackBPendingError(5000, 'Approved data is incomplete; suite fallback refused.');
+      return null;
+    }
+    if (ready.result.frozen?.suite.digest !== suiteDigest) return refused();
+    return { job: a.job, knownSecrets: a.knownSecrets, context: ready.input.context, result: ready.result };
+  } });
+  async function advanceData() {
+    const a = await canonical();
+    if (a.job.package !== 'text_eval') return refused();
+    return advanceWorkflowData(sql, dataScope, a.knownSecrets, inventory, authority.autonomous ? async () => {
+      throw new TrackBBlockedError('needs_operator', 'Autonomous data adapter required; legacy data dispatch refused.');
+    } : undefined);
+  }
+  async function sendText(a: Awaited<ReturnType<typeof canonical>>, input: Parameters<ReturnType<typeof createTextTarget>['send']>[0]) {
+    const dispatch = async () => {
+      const fresh=await canonical(); if(fresh.targetVersion!==a.targetVersion) return refused();
+      return createTextTarget(fresh.intake.endpoint).send(input);
+    };
+    if (!authority.autonomous) return dispatch();
+    return runAutonomousTarget(authority.autonomous,{job:a.job,
+      operationId:`autonomous-text:${a.job.jobId}:${input.runId}:${input.scenarioId}`,
+      input:{request:input,targetVersion:a.targetVersion}},dispatch);
+  }
+  const text = createTextEvaluationServices({ runner, checkpoints, resolveApprovedSuite: approved.resolveApprovedSuite, resolve: async current => {
+    if (current.jobId !== ctx.jobId || current.environment !== ctx.environment) return refused();
+    const a = await canonical();
+    return { job: a.job, target: { send: input => sendText(a,input) }, targetVersion: a.targetVersion,
+      judge, knownSecrets: a.knownSecrets };
+  } });
+  const remediation = createRichRemediation({ autonomous:authority.autonomous, sql, runner, checkpoints, canonical, text, judge: remediationJudge });
+  let branchBinding: { connection: string; pool: Pool } | undefined;
+  const calendar = createCalendarEvaluationServices({ checkpoints, journalPool: applicationPool!, resolve: async current => {
+    if (current.jobId !== ctx.jobId || current.environment !== ctx.environment) return refused();
+    const a = await canonical();
+    // targetForScenario has no retained run/attempt identity. Autonomous Calendar is refused
+    // before pool/branch/provider work; a process-local counter or payload hash is not replay authority.
+    if (authority.autonomous) return refused();
+    if (!a.row.neonBranchId || !a.binding.reviewed_calendar) return refused();
+    const ledger = new PostgresBranchLedger(applicationPool!);
+    const owned = await ledger.findOwnedBranch(a.row.neonBranchId);
+    if (!owned || owned.jobId !== ctx.jobId || owned.state !== 'ready') return refused();
+    const connection = await evalServices.getJobBranchConnection!(a.row.neonBranchId);
+    if (branchBinding && branchBinding.connection !== connection) return refused();
+    branchBinding ??= { connection, pool: new Pool({ connectionString: connection, max: 2, connectionTimeoutMillis: 10000,
+      idleTimeoutMillis: 1000, options: '-c statement_timeout=30000 -c lock_timeout=10000' }) };
+    const db = pooledCalendarDatabase(branchBinding.pool);
+    return { job: a.job, targetVersion: a.targetVersion,
+      branch: { jobId: ctx.jobId, branchId: a.row.neonBranchId, targetVersion: a.targetVersion },
+      reviewedSuite: a.binding.reviewed_calendar, systemPrompt: a.intake.endpoint.systemPrompt, knownSecrets: a.knownSecrets,
+      dependencies: { db, simulator: new CalendarSimulator(new PostgresCalendarStore(db)), targetForScenario: () => ({ async complete(messages) { const fresh=await canonical(); const currentBranch=await ledger.findOwnedBranch(a.row.neonBranchId!); if(fresh.targetVersion!==a.targetVersion || fresh.row.neonBranchId!==a.row.neonBranchId || currentBranch?.jobId!==ctx.jobId || currentBranch.state!=='ready') return refused(); return platformTarget(fresh.intake.endpoint).complete(messages); } }) } };
+  } });
+  const reportServices = createTrackBServices({ runner,
+    resolveJob: async current => {
+      if (current.jobId !== ctx.jobId || current.environment !== ctx.environment) return refused();
+      return (await canonical()).job;
+    }, resolveKnownSecrets: async () => (await canonical()).knownSecrets,
+    // Missing non-session billing remains explicitly unknown in the report.
+  });
+  async function bindTextBaseline(suiteDigest: string, runId: string) {
+    const a = await canonical();
+    if (authority.rerun || a.job.package !== 'text_eval') return refused();
+    await text.reportInput(ctx, { suiteDigest, runId }); // completed investigation and exact associations required
+    await sql.query(`UPDATE workflow_integration.bindings SET baseline_suite_digest=$2,baseline_run_id=$3
+      WHERE job_id=$1 AND (baseline_suite_digest IS NULL OR (baseline_suite_digest=$2 AND baseline_run_id=$3))
+      RETURNING job_id`, [ctx.jobId,suiteDigest,runId]).then(r => { if (r.rows.length !== 1) return refused(); });
+  }
+  async function resolvePackTarget() {
+    const a = await canonical();
+    if (a.job.package !== 'text_eval') return refused();
+    return { configuration: { endpoint: a.intake.endpoint.url, model: a.intake.endpoint.model,
+      configurationVersion: a.targetVersion, systemPrompt: a.intake.endpoint.systemPrompt || null },
+      target: {send: (input:Parameters<ReturnType<typeof createTextTarget>['send']>[0]) => sendText(a,input)}, knownSecrets: a.knownSecrets };
+  }
+  /** Discovery is read-only. Approved admission creates neither design nor suite checkpoints. */
+  async function resolvePackBaseSuite(expectedDigest?: string) {
+    const a = await canonical();
+    if (a.job.package !== 'text_eval') return refused();
+    const plan = await readWorkflowDataPlan(sql, dataScope, a.knownSecrets);
+    let digest: string;
+    if (plan) {
+      const ready = await readWorkflowDataReady(sql, dataScope, a.knownSecrets);
+      if (!ready?.result.frozen) throw new TrackBPendingError(5000, 'Approved data is incomplete; finish retained review and admission before pack review.');
+      digest = ready.result.frozen.suite.digest;
+      if (!await approved.get(ctx, digest)) return refused();
+    } else {
+      const tasks = await sql.query('SELECT task_id FROM evaluation_data_persistence.tasks WHERE tenant_id=$1 AND job_id=$2', [a.job.customerId, ctx.jobId]);
+      if (tasks.rows.length) throw new TrackBBlockedError('needs_operator', 'Data tasks require an immutable approved-data plan; design fallback refused.');
+      // Legacy design is used only to discover an identity; supported getSuite
+      // performs target binding, secret checks and current service authorization.
+      const stored = await checkpoints.get({ jobId: ctx.jobId, kind: 'design', id: `suite:${ctx.jobId}:frozen12` });
+      const design = stored?.state === 'completed' ? stored.value as { status: string; suite: { digest: string } } : null;
+      if (design?.status !== 'completed') throw new TrackBBlockedError('needs_operator', 'Retain a completed base12 design before pack review.');
+      digest = design.suite.digest;
+    }
+    if (expectedDigest && digest !== expectedDigest) return refused();
+    const suite = await text.getSuite(ctx, digest);
+    if (suite.jobId !== ctx.jobId || suite.scenarios.length !== 12) return refused();
+    return suite;
+  }
+  return { resolvePackTarget, resolvePackBaseSuite, text, calendar, remediation, inventory, advanceData, approvedData: approved.get, branchId: initial.row.neonBranchId ?? undefined, dispose: async () => { await branchBinding?.pool.end(); }, renderReport: reportServices.renderReport, bindTextBaseline, intake: initial.intake, job: initial.job,
+    targetVersion: initial.targetVersion, knownSecrets: initial.knownSecrets };
+}
diff --git a/apps/web/src/server/workflow-data.ts b/apps/web/src/server/workflow-data.ts
new file mode 100644
index 0000000..862b38b
--- /dev/null
+++ b/apps/web/src/server/workflow-data.ts
@@ -0,0 +1,75 @@
+import 'server-only';
+import type { AgentTransactionalSql } from '@ae/core/agents/postgres-ports';
+import { reviewDigest } from '@ae/core/evals/data/binding';
+import { inspectDataSafety } from '@ae/core/evals/data/quality';
+import type { DataOrchestrationResult } from '@ae/core/evals/data/orchestration';
+import { TrackBBlockedError } from '@ae/core/evals/service-adapter';
+import { advanceProductionData, type ProductionDataInput } from './data-production';
+
+type Scope = { tenantId: string; jobId: string; environment: 'test' | 'live'; workflowRunId: string };
+const refuse = (): never => { throw new TrackBBlockedError('needs_operator', 'Data plan authority or immutable identity requires reconciliation.'); };
+async function authorize(sql: AgentTransactionalSql, scope: Scope) {
+  const row = await sql.query('SELECT id FROM jobs WHERE id=$1 AND customer_id=$2 AND environment=$3 AND workflow_run_id=$4 AND package=$5 AND is_mock=false AND state IN ($6,$7,$8)',
+    [scope.jobId, scope.tenantId, scope.environment, scope.workflowRunId, 'text_eval', 'planning', 'running', 'investigating']);
+  if (row.rows.length !== 1) refuse();
+}
+/** Private trusted producer capability. Owner must supply a durable authorized plan;
+ * no route, model output or default fixture grants this authority. */
+export async function registerWorkflowDataPlan(sql: AgentTransactionalSql, scope: Scope, input: ProductionDataInput, knownSecrets: readonly string[]) {
+  input = structuredClone(input);
+  if (input.task.jobId !== scope.jobId || !/^[A-Za-z0-9_-]{1,96}$/.test(input.task.taskId) || !inspectDataSafety(input, knownSecrets).safe) refuse();
+  await authorize(sql, scope);
+  const result = await sql.query(`INSERT INTO workflow_integration.data_plans(job_id,tenant_id,environment,input_digest,input)
+    VALUES($1,$2,$3,$4,$5::jsonb) ON CONFLICT(job_id) DO UPDATE SET job_id=EXCLUDED.job_id
+    WHERE workflow_integration.data_plans.tenant_id=EXCLUDED.tenant_id AND workflow_integration.data_plans.environment=EXCLUDED.environment
+      AND workflow_integration.data_plans.input_digest=EXCLUDED.input_digest AND workflow_integration.data_plans.input=EXCLUDED.input RETURNING job_id`,
+    [scope.jobId, scope.tenantId, scope.environment, reviewDigest(input), JSON.stringify(input)]);
+  if (result.rows.length !== 1) refuse();
+}
+export async function readWorkflowDataPlan(sql: AgentTransactionalSql, scope: Scope, knownSecrets: readonly string[]) {
+  await authorize(sql, scope);
+  const row = (await sql.query<{ input: ProductionDataInput; input_digest: string }>(
+    'SELECT input,input_digest FROM workflow_integration.data_plans WHERE job_id=$1 AND tenant_id=$2 AND environment=$3', [scope.jobId, scope.tenantId, scope.environment])).rows[0];
+  if (!row) return null;
+  if (reviewDigest(row.input) !== row.input_digest || row.input.task.jobId !== scope.jobId || !inspectDataSafety(row.input, knownSecrets).safe) refuse();
+  return row.input;
+}
+export async function readWorkflowDataReady(sql: AgentTransactionalSql, scope: Scope, knownSecrets: readonly string[]) {
+  const input = await readWorkflowDataPlan(sql, scope, knownSecrets);
+  if (!input) return null;
+  const row = (await sql.query<{ result: DataOrchestrationResult; result_digest: string }>(
+    'SELECT result,result_digest FROM workflow_integration.data_ready WHERE job_id=$1 AND input_digest=$2', [scope.jobId, reviewDigest(input)])).rows[0];
+  if (!row) return null;
+  if (reviewDigest(row.result) !== row.result_digest || row.result.status !== 'ready' || !row.result.frozen
+    || reviewDigest(row.result.task.spec) !== reviewDigest(input.task) || !inspectDataSafety(row.result, knownSecrets).safe) refuse();
+  return { input, result: row.result };
+}
+/** Inventory publication MUST commit before advance can dispatch. Every nonready
+ * status is retained privately and returned verbatim; no state is converted to success. */
+export async function advanceWorkflowData(sql: AgentTransactionalSql, scope: Scope, knownSecrets: readonly string[], inventory: { acquisition(ids: string[]): Promise<void>; touch(): Promise<void> }, dispatch: typeof advanceProductionData = advanceProductionData) {
+  const input = await readWorkflowDataPlan(sql, scope, knownSecrets);
+  const tasks = await sql.query<{ task_id: string }>('SELECT task_id FROM evaluation_data_persistence.tasks WHERE tenant_id=$1 AND job_id=$2 ORDER BY task_id', [scope.tenantId, scope.jobId]);
+  const ids = [...new Set([...tasks.rows.map(row => row.task_id), ...(input ? [input.task.taskId] : [])])];
+  if (ids.length) await inventory.acquisition(ids);
+  if (!input) { if (ids.length) refuse(); return null; }
+  if (ids.some(id => id !== input.task.taskId)) refuse(); // Multiple suites require a separate authorized composition.
+  const ready = await readWorkflowDataReady(sql, scope, knownSecrets);
+  if (ready) { await inventory.touch(); return ready.result; }
+  let result: DataOrchestrationResult;
+  try { result = await dispatch(scope.jobId, input); }
+  finally { await inventory.touch(); } // Includes review/claim/cost writes even on failure.
+  if (reviewDigest(result.task.spec) !== reviewDigest(input.task) || !inspectDataSafety(result, knownSecrets).safe) refuse();
+  const digest = reviewDigest(result);
+  // Keep every distinct pending/review/cost snapshot; ready is a separate immutable binding.
+  await sql.query(`INSERT INTO workflow_integration.data_advances(job_id,result_digest,result) VALUES($1,$2,$3::jsonb) ON CONFLICT(job_id,result_digest) DO NOTHING`, [scope.jobId, digest, JSON.stringify(result)]);
+  if (result.status === 'ready') {
+    if (!result.frozen) refuse();
+    const saved = await sql.query(`INSERT INTO workflow_integration.data_ready(job_id,input_digest,result_digest,result) VALUES($1,$2,$3,$4::jsonb)
+      ON CONFLICT(job_id) DO UPDATE SET job_id=EXCLUDED.job_id WHERE workflow_integration.data_ready.input_digest=EXCLUDED.input_digest
+      AND workflow_integration.data_ready.result_digest=EXCLUDED.result_digest AND workflow_integration.data_ready.result=EXCLUDED.result RETURNING job_id`,
+      [scope.jobId, reviewDigest(input), digest, JSON.stringify(result)]);
+    if (saved.rows.length !== 1) refuse();
+  }
+  await inventory.touch();
+  return result;
+}
