+   'jobId',job_id,'source',source,'agent',agent,'sessionId',session_id,'microUsd',micro_usd,'meta',meta))
+ FROM costs WHERE job_id IS NOT NULL AND jsonb_typeof(meta->'idempotencyKey')='string';
