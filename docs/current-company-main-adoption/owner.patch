+export function workflowPackFromArtifact(body: unknown): PackRunEvidence | null {
+  if (!body || typeof body !== 'object' || !('appendedPack' in body)) return null;
+  const pack = (body as { appendedPack: PackRunEvidence }).appendedPack;
