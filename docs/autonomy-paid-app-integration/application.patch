@@ -0,0 +1,5 @@
+-- app.autonomy-paid-authority.001. Owner transaction/registry only; after autonomy-release access.
+-- Existing bindings remain NULL and fail closed. The owner must explicitly reauthorize
+-- their immutable original policy and paid caps; this migration never infers/backfills authority.
+ALTER TABLE company_autonomy_release.job_bindings
+ ADD COLUMN authority_digest text CHECK(authority_digest IS NULL OR authority_digest ~ '^[a-f0-9]{64}$');
diff --git a/apps/web/src/server/autonomous-paid.sql b/apps/web/src/server/autonomous-paid.sql
new file mode 100644
index 0000000..0ae0612
--- /dev/null
+++ b/apps/web/src/server/autonomous-paid.sql
@@ -0,0 +1,11 @@
+-- Owner migration only. Constructors never run DDL. Local intent is not provider attestation.
+CREATE SCHEMA IF NOT EXISTS autonomous_paid_app;
+REVOKE ALL ON SCHEMA autonomous_paid_app FROM PUBLIC;
+CREATE TABLE autonomous_paid_app.operations (
+ operation_id text PRIMARY KEY, job_id text NOT NULL, input_digest text NOT NULL,
+ policy_digest text NOT NULL, reservation jsonb NOT NULL, state text NOT NULL CHECK(state IN ('reserved','denied','dispatched','settled')),
+ receipt jsonb,
+ CHECK(input_digest ~ '^[a-f0-9]{64}$')
+);
+REVOKE ALL ON autonomous_paid_app.operations FROM PUBLIC;
+-- Owner grants server-only access and reconciles this stable identity with its migration registry.
diff --git a/apps/web/src/server/autonomous-paid.ts b/apps/web/src/server/autonomous-paid.ts
