{
  "name": "autonomous-evals",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
